# Cloudflare Pages reads this file from the root of the build output.
#
# PRE-LAUNCH LOCK. The site carries {PLACEHOLDER} copy and seeded test content,
# so every response tells crawlers not to index it. This is the second of two
# locks: the first is the noindex meta tag, which follows the
# PUBLIC_ALLOW_INDEXING environment variable. This one is deliberately manual,
# because a header cannot be generated from an environment variable in a static
# build, and because a second lock that has to be removed by hand is exactly
# what you want protecting an unfinished site.
#
# AT LAUNCH: delete the two lines below. See DESIGN-PLAN section 16.
/*
  X-Robots-Tag: noindex, nofollow

# Self-hosted fonts are immutable: their contents never change under the same
# filename, and a new subset would be a new file. Safe to cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Build output is content-hashed (styles, scripts and, since section 74, the
# icons), so the bytes behind one of these URLs can never change. Caching them
# hard is safe precisely BECAUSE the name changes when the content does — the
# property the icons did not have when a stale one shipped unnoticed.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
