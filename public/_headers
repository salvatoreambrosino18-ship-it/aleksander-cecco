# Cloudflare Pages reads this file from the root of the build output.
#
# THE SECOND PRE-LAUNCH LOCK WAS REMOVED FROM HERE ON 2026-08-22, and this note
# stands in its place so that nobody re-adds it by accident and nobody wonders
# whether it was ever there.
#
# It was `/*  X-Robots-Tag: noindex, nofollow`, applied by Cloudflare to EVERY
# response — including the ones a meta tag cannot reach: the sitemap, the JSON
# price list, the photographs. That is why there were two locks rather than one,
# and why this one was deliberately manual: a header cannot be generated from an
# environment variable in a static build, and a lock that has to be removed by
# hand is what you want protecting an unfinished site.
#
# The other lock is the noindex meta tag, which follows PUBLIC_ALLOW_INDEXING in
# the Pages environment. See DESIGN-PLAN sections 16 and 137.
#
# TO PUT THE SITE BACK OUT OF SEARCH, both go back: these two lines, and the
# variable. Removing one leaves a site that is invisible and looks fixed.

# Self-hosted fonts are immutable: their contents never change under the same
# filename, and a new subset would be a new file. Safe to cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Build output is content-hashed (styles, scripts and, since section 74, the
# icons), so the bytes behind one of these URLs can never change. Caching them
# hard is safe precisely BECAUSE the name changes when the content does — the
# property the icons did not have when a stale one shipped unnoticed.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# THE CONVENTIONAL ICON PATHS (section 78). These are NOT content-hashed, on
# purpose: browsers and bots ask for them by name whatever the document says.
#
# So they get a SHORT shared cache. The default on this host is s-maxage=604800,
# a week — and that is precisely what kept the old broken touch icon alive at
# the edge for 4.9 days after it had been deleted from the origin, which is what
# the owner kept seeing in a private window with no cache of his own.
#
# One hour: long enough that this costs nothing, short enough that a mistake at
# a fixed path is an hour's problem rather than a week's.
/favicon.ico
  Cache-Control: public, max-age=3600, s-maxage=3600
/favicon.svg
  Cache-Control: public, max-age=3600, s-maxage=3600
/apple-touch-icon.png
  Cache-Control: public, max-age=3600, s-maxage=3600
/apple-touch-icon-precomposed.png
  Cache-Control: public, max-age=3600, s-maxage=3600
/icon-512.png
  Cache-Control: public, max-age=3600, s-maxage=3600
