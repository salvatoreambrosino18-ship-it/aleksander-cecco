# dependencies
node_modules/
.pnp
.pnp.js

# secrets: never commit real env files. .env.example is tracked on purpose.
.env
.env.*
!.env.example

# build output
dist/
.output/
.vercel/
.netlify/
.wrangler/

# astro
.astro/

# sanity
.sanity/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# os / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# the brand's original photographs: they belong in Sanity, not in the repo
seed-photos/

# misc
.cache/
coverage/

# screenshots from scripts/shots.mjs: look at them, never commit them
shots/

# evidence that a build query failed; scripts/verify-build.mjs reads it
.sanity-failures.log

# scratch scripts used to drive the studio in a browser
.studio.mjs
.look*.mjs

# THE OWNER'S DRIVE, DROPPED IN WHOLE (2026-08-20). docs/da-ciro/ is a copy of
# his Google Drive: about 180 MB of photographs, most of which are already in
# Sanity. Git is not where they belong — the dataset holds them, and a dataset
# export holds the dataset.
#
# THE TWELVE APPROVAL SHEETS DO belong here: they are the record of what he
# approved, in his handwriting, and every price and description we are about to
# publish is answerable to them. So the images go and the PDFs stay.
docs/da-ciro/**
!docs/da-ciro/
!docs/da-ciro/**/
!docs/da-ciro/**/*.pdf
