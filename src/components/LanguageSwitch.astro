---
/*
  IT | EN. Always visible, both languages first class, nothing auto-detected.
  The switch preserves the current path, so a reader on a garment page lands on
  the same garment in the other language (DESIGN-PLAN section 5).

  LABEL, NOT MONO (2026-08-10). This was the site's data voice, which the token
  reserves for prices, measurements and counts and calls "never decorative"
  (tokens.css). A language switch is a nav item, and the token assigns nav items
  to the label register in the same sentence.

  It was also visible: this sits at the foot of a menu whose every other item is
  label, and whose whole argument is two groups separated by whitespace alone
  (section 67). A second typeface at a third size made it a third group, and the
  one thing separating the groups was supposed to be the space.
*/
import {LOCALES, isLocale, localePath, switchLocalePath, type Locale} from "../lib/locales";
import {t} from "../i18n/ui";

interface Props {
  locale: Locale;
}

const {locale} = Astro.props;
const pathname = Astro.url.pathname;

/*
  A PAGE OUTSIDE /[lang]/ HAS NO TRANSLATION TO SWITCH TO (2026-08-16, section
  130), and there is exactly one: the 404, which is served for any path and so
  cannot live under a language.

  `switchLocalePath` does the only sensible thing with a path that carries no
  locale segment — it prefixes one — and on the 404 that produced `/it/404/`,
  a page that does not exist. So the site's own error page carried a link to a
  second error, in the one place a lost reader is already lost. Found by
  walking every internal link in the built output against the built routes.

  Where there is no locale in the path there is nothing to preserve, so the
  switch offers the other language's front door instead.
*/
const localised = isLocale(pathname.replace(/^\/+/, "").split("/")[0]);
const hrefFor = (code: Locale) =>
  localised ? switchLocalePath(pathname, code) : localePath(code);
---

<nav class="type-label text-label flex items-baseline gap-u1" aria-label={t(locale, "languageLabel")}>
  {
    LOCALES.map((code, index) => (
      <>
        {index > 0 && <span aria-hidden="true">|</span>}
        {code === locale ? (
          <span aria-current="true" class="underline underline-offset-4">
            {code}
          </span>
        ) : (
          <a href={hrefFor(code)} hreflang={code} class="hover:underline underline-offset-4">
            {code}
          </a>
        )}
      </>
    ))
  }
</nav>
