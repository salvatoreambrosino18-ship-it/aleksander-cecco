---
/*
  The footer, rebuilt 2026-08-02 as an INSCRIPTION (DESIGN-PLAN section 26).

  WHAT IT WAS: four blocks in a four-column grid, headed Instagram, Support,
  Worldwide shipping, Made in Italy. That is the standard commerce footer, the
  structure was borrowed from a shop, and "Support" is a customer-service word
  for a brand with no support desk. It was the most template-like thing on the
  site (section 25).

  WHAT IT IS NOW: the same four facts, set as an inscription. One column, no
  headings, no grid at any width, each fact a short declarative line in the
  owner's own register: "Handcrafted in South Italy." "Shipped worldwide." A grid
  of headed cells says "here are our service pillars"; a stack of statements
  says what is true about the work. The second is what this brand sounds like.

  It does NOT become a grid on desktop. That is the point of the change: an
  inscription at 390px that turns into four columns at 1440px was never an
  inscription, it was a responsive shop footer waiting for room.

  WHOSE WORDS, and it is no longer one answer for both (2026-08-13, section
  108). The SHIPPING line is HIS — "Free worldwide shipping over 500 euro" —
  and carries no mark. The ORIGIN line is still ours and still marked in both
  languages until he approves it; that half is the part of item 1 on THE OPEN
  LIST that remains his. Our own shipping sentence survives as a fallback and
  would come back marked if he ever cleared his. The handle and the address are
  facts from site settings and carry no mark. Where the owner has supplied
  nothing, the placeholder shows as a placeholder and never as a working link
  (standing rule 6).
*/
import TextSurface from "./TextSurface.astro";
import {COMPANY_LINE} from "../lib/company";
import {isPlaceholderEmail, isPlaceholderText, type SiteSettings} from "../lib/content";
import {localePath, pick, type Locale} from "../lib/locales";
import {isMarked, voiceState} from "../lib/voice";
import {t} from "../i18n/ui";
import {SHOW_UNAPPROVED_MARKS} from "../lib/marks";

interface Props {
  locale: Locale;
  settings: SiteSettings;
  /** Set when the page inverts above it, so the footer joins the second half. */
  /*
    UNUSED SINCE EVERY PAGE BECAME PAPER (2026-08-12). It was passed by the home
    page, which used to end in the opposite polarity to the one it started in.
    Kept as a prop rather than deleted because the footer is the one surface
    that would carry a local inversion if the site ever grows one — but nothing
    passes it, and `undefined` is the correct value everywhere today.
  */
  theme?: "light" | "dark";
}

const {locale, settings, theme} = Astro.props;

const instagramUrl = settings.instagramUrl?.trim() || null;
// The handle is the fact; the URL is plumbing.
const instagramHandle = instagramUrl
  ? `@${instagramUrl.replace(/\/+$/, "").split("/").pop()}`
  : null;

const email = settings.contactEmail?.trim() || null;
const emailIsPlaceholder = isPlaceholderEmail(email);

const origin = pick(settings.footerOrigin, locale);

/*
  HIS SHIPPING LINE, IN THE FOOTER (2026-08-13, section 108). Item 1 on THE OPEN
  LIST, and it was mine to build rather than his to answer.

  The footer said "Shipped worldwide." — ours, weaker, and true of any shop —
  while HIS OWN sentence, "Free worldwide shipping over 500 euro", was already
  in the dataset, already approved, already on /contact and in the banner above
  every commerce page. The reason it was not here was not editorial: putting his
  words in this slot would have LABELLED THEM OUR DRAFT, because
  `footerCopyIsDraft` is one boolean covering both footer lines.

  THE PER-LINE FLAG DID NOT NEED BUILDING. `inventedCopy` has carried
  `footerShipping` and `footerOrigin` as separate keys since section 59; the
  site simply never projected the field, so a per-line answer existed in the
  data and no page could read it. It is projected now, and each line asks about
  ITSELF.

  So: his sentence when he has one, ours only as a fallback, and the mark
  follows whichever is actually shown.
*/
const free = pick(settings.shippingFree, locale);
const ours = pick(settings.footerShipping, locale);
const shipping = free ?? ours;
const shippingIsHis = Boolean(free);

/* Our lines are drafts in every language rather than translations. */
const voice = voiceState(settings, locale, Boolean(settings.footerCopyIsDraft));
const notice = voice === "translation" ? "translationNotice" : "draftNotice";
const flags = settings.inventedCopy ?? [];
/*
  A line is marked when it is OURS and its own key is still flagged. `isMarked`
  keeps the language question — an approved sentence in an unapproved language
  is a translation notice, not a draft one — and the key answers the authorship
  question, which is the half the single boolean could not express.
*/
const isMarkedLine = (value: string | null, key: string) =>
  SHOW_UNAPPROVED_MARKS &&
  isMarked(voice) &&
  flags.includes(key) &&
  Boolean(value) &&
  !isPlaceholderText(value);
const originMarked = isMarkedLine(origin, "footerOrigin");
const shippingMarked = !shippingIsHis && isMarkedLine(shipping, "footerShipping");
const anyMarked = originMarked || shippingMarked;
---

{/*
  THE GAP ABOVE THE FOOTER IS PAINTED (2026-08-10), and this wrapper is the
  whole reason it is.

  `mt-u21` is a MARGIN, and a margin is transparent: it shows the BODY's
  background, which resolves from `<html data-theme>` — the polarity the page
  STARTED in. On every page that begins and ends in the same polarity this is
  invisible, which is why it survived. The home page is the only one that
  inverts: it starts ink, washes to paper, and ends with a light footer. So the
  gap between the last light section and the light footer was 21 units of solid
  INK — 175px on a phone, 252px on a desktop — a black band under the drop
  statement that nothing in the source mentioned or intended.

  The fix is to make the space belong to a surface that paints. `flow-root`
  is not decoration: without it the child's top margin COLLAPSES straight
  through this element and back out to the body, which is the same bug wearing
  a wrapper.

  The general rule this proves: on a page whose ground can disagree with a
  section, that section owns its own spacing. A transparent margin is a hole
  through to a polarity nobody chose.
*/}
<div data-theme={theme} class="bg-bg text-fg flow-root">
<TextSurface theme={theme} class="hairline-h mt-u13 py-u8">
  <footer class="flex flex-col gap-u8">
    <h2 class="sr-only">{t(locale, "footerNav")}</h2>

    {/*
      The inscription. Written lines first, because they are what the brand is,
      then the two ways to reach it. One column, always.
    */}
    <div class="type-label text-label flex flex-col gap-u2">
      {!origin && <span class="placeholder-mark self-start">{"{FOOTER_ORIGIN}"}</span>}
      {origin && <p class:list={[originMarked && "draft-text"]}>{origin}</p>}

      {!shipping && <span class="placeholder-mark self-start">{"{FOOTER_SHIPPING}"}</span>}
      {shipping && <p class:list={[shippingMarked && "draft-text"]}>{shipping}</p>}
    </div>

    <div class="type-label text-label flex flex-col gap-u2">
      {
        instagramUrl ? (
          <a
            href={instagramUrl}
            rel="me noopener"
            target="_blank"
            class="self-start hairline-under"
          >
            {instagramHandle}
          </a>
        ) : (
          <span class="placeholder-mark self-start">{"{INSTAGRAM_URL}"}</span>
        )
      }
      {
        emailIsPlaceholder ? (
          <span class="placeholder-mark self-start">{"{CONTACT_EMAIL}"}</span>
        ) : (
          <a href={`mailto:${email}`} class="self-start hairline-under">
            {email}
          </a>
        )
      }
    </div>

    {anyMarked && <p class="placeholder-mark self-start">{t(locale, notice)}</p>}

    {/*
      THE SIGNATURE AND THE SELLER, and they are two different things
      (2026-08-17, section 137). "Aleksander Cecco" is the brand closing the
      inscription; the line under it is the company that takes the money. They
      sit together because a reader looking for the second will look at the
      bottom, and they stay two lines because collapsing them would read as if
      the man and the company were the same legal person, which is the exact
      confusion the brief asked us to remove.

      THE LEGAL LINKS ARE HERE SINCE 2026-08-17, between the two, which is the
      slot this comment reserved when the pages did not exist yet. They sit in
      one row rather than stacked because they are a pair a reader chooses
      between, not two more statements in the inscription.
    */}
    <div class="type-label text-label flex flex-col gap-u2">
      <p>Aleksander Cecco</p>
      <p class="flex flex-wrap gap-u3">
        <a href={localePath(locale, "privacy")} class="hairline-under">{t(locale, "privacyTitle")}</a>
        <a href={localePath(locale, "terms")} class="hairline-under">{t(locale, "termsTitle")}</a>
      </p>
      <p>{COMPANY_LINE}</p>
    </div>
  </footer>
</TextSurface>
</div>
