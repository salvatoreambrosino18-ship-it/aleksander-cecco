---
/*
  The footer, rebuilt 2026-08-02 as an INSCRIPTION (DESIGN-PLAN section 26).

  WHAT IT WAS: four blocks in a four-column grid, headed Instagram, Support,
  Worldwide shipping, Made in Italy. That is the standard commerce footer, the
  structure was borrowed from a shop, and "Support" is a customer-service word
  for a brand with no support desk. It was the most template-like thing on the
  site (section 25).

  WHAT IT IS NOW: the same four facts, set as an inscription. One column, no
  headings, no grid at any width, each fact a short declarative line in the
  owner's own register: "Handmade in South Italy." "Shipped worldwide." A grid
  of headed cells says "here are our service pillars"; a stack of statements
  says what is true about the work. The second is what this brand sounds like.

  It does NOT become a grid on desktop. That is the point of the change: an
  inscription at 390px that turns into four columns at 1440px was never an
  inscription, it was a responsive shop footer waiting for room.

  WHOSE WORDS: the two written lines are still ours and stay marked as drafts in
  both languages. The handle and the address are facts from site settings and
  carry no mark. Where the owner has supplied nothing, the placeholder shows as
  a placeholder and never as a working link (standing rule 6).
*/
import TextSurface from "./TextSurface.astro";
import {isPlaceholderEmail, isPlaceholderText, type SiteSettings} from "../lib/content";
import {pick, type Locale} from "../lib/locales";
import {isMarked, voiceState} from "../lib/voice";
import {t} from "../i18n/ui";

interface Props {
  locale: Locale;
  settings: SiteSettings;
  /** Set when the page inverts above it, so the footer joins the second half. */
  theme?: "light" | "dark";
}

const {locale, settings, theme} = Astro.props;

const instagramUrl = settings.instagramUrl?.trim() || null;
// The handle is the fact; the URL is plumbing.
const instagramHandle = instagramUrl
  ? `@${instagramUrl.replace(/\/+$/, "").split("/").pop()}`
  : null;

const email = settings.contactEmail?.trim() || null;
const emailIsPlaceholder = isPlaceholderEmail(email);

const origin = pick(settings.footerOrigin, locale);
const shipping = pick(settings.footerShipping, locale);

/* Our two lines, so drafts in every language rather than translations. */
const voice = voiceState(settings, locale, Boolean(settings.footerCopyIsDraft));
const notice = voice === "translation" ? "translationNotice" : "draftNotice";
const isMarkedLine = (value: string | null) =>
  isMarked(voice) && Boolean(value) && !isPlaceholderText(value);
const anyMarked = isMarkedLine(origin) || isMarkedLine(shipping);
---

<TextSurface theme={theme} class="hairline-h mt-u21 py-u13">
  <footer class="flex flex-col gap-u8">
    <h2 class="sr-only">{t(locale, "footerNav")}</h2>

    {/*
      The inscription. Written lines first, because they are what the brand is,
      then the two ways to reach it. One column, always.
    */}
    <div class="type-label text-label flex flex-col gap-u2">
      {!origin && <span class="placeholder-mark self-start">{"{FOOTER_ORIGIN}"}</span>}
      {origin && <p class:list={[isMarkedLine(origin) && "draft-text"]}>{origin}</p>}

      {!shipping && <span class="placeholder-mark self-start">{"{FOOTER_SHIPPING}"}</span>}
      {shipping && <p class:list={[isMarkedLine(shipping) && "draft-text"]}>{shipping}</p>}
    </div>

    <div class="type-label text-label flex flex-col gap-u2">
      {
        instagramUrl ? (
          <a
            href={instagramUrl}
            rel="me noopener"
            target="_blank"
            class="self-start hover:underline underline-offset-8"
          >
            {instagramHandle}
          </a>
        ) : (
          <span class="placeholder-mark self-start">{"{INSTAGRAM_URL}"}</span>
        )
      }
      {
        emailIsPlaceholder ? (
          <span class="placeholder-mark self-start">{"{CONTACT_EMAIL}"}</span>
        ) : (
          <a href={`mailto:${email}`} class="self-start hover:underline underline-offset-8">
            {email}
          </a>
        )
      }
    </div>

    {anyMarked && <p class="placeholder-mark self-start">{t(locale, notice)}</p>}

    <p class="type-label text-label">Aleksander Cecco</p>
  </footer>
</TextSurface>
