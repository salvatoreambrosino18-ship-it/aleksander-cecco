---
/*
  A STATEMENT: two or three short lines in the brand's voice, on a text surface.

  Line breaks are meaningful and are preserved (type-statement sets
  white-space: pre-line), because the owner writes these as lines, not as a
  paragraph that happens to wrap.

  Three states, and the middle one is the one that matters here:

  - missing:     nothing to say yet, so the {TOKEN} shows as a marked placeholder.
  - placeholder: the field still holds a {LIKE_THIS} token, marked the same way.
  - draft:       real prose that nobody has approved. It stays fully readable,
                 because the owner judges it by reading it on the page, and it
                 carries the draft rule beside it so it can never be mistaken
                 for the brand's own approved voice (DESIGN-PLAN section 17).
*/
import TextSurface from "./TextSurface.astro";
import {isPlaceholderText} from "../lib/content";
import type {Locale} from "../lib/locales";
import {t} from "../i18n/ui";

interface Props {
  /** The lines themselves, already picked for this locale. */
  text: string | null;
  locale: Locale;
  /** Section heading, at label scale. Announced even where it reads small. */
  heading: string;
  /** The token shown when the owner has not written this yet. */
  token: string;
  /** True while the copy is written for the brand rather than by it. */
  isDraft?: boolean;
  theme?: "light" | "dark";
  class?: string;
}

const {text, locale, heading, token, isDraft = false, theme, class: className = ""} = Astro.props;

const isPlaceholder = isPlaceholderText(text);
const showDraftMark = isDraft && Boolean(text) && !isPlaceholder;
---

<TextSurface theme={theme} class:list={["flex flex-col gap-u5 py-u13", className]}>
  <h2 class="type-label text-label">{heading}</h2>

  {showDraftMark && <p class="placeholder-mark self-start">{t(locale, "draftNotice")}</p>}

  {!text && <p class="placeholder-mark self-start">{token}</p>}
  {text && isPlaceholder && <p class="placeholder-mark self-start">{text}</p>}
  {
    text && !isPlaceholder && (
      <p class:list={["type-statement text-statement max-w-prose", showDraftMark && "draft-text"]}>
        {text}
      </p>
    )
  }

  <slot />
</TextSurface>
