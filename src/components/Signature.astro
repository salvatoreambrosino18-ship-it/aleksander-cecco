---
/*
  The brand signature, inlined so it inherits the page color.

  One file serves both polarities: the SVG paints with currentColor, so it is
  black on the paper theme and white on the ink theme with no second asset and
  no cross-fade (DESIGN-PLAN section 3). There is no monogram; the mark is the
  full signature at whatever scale the caller sets.

  THE DRAW (section 70). With `draw`, each path is prepared so CSS can write
  the mark stroke by stroke: pathLength="1" normalises every path, and each
  one carries its own --sig-delay and --sig-dur, proportional to its length,
  so the pen spends its time where the ink actually goes. The SVG is
  OUTLINES, not strokes — traced from the real signature — but a thin script
  mark's outline hugs the pen's path closely enough that tracing it reads as
  writing; the fill then arrives as each path completes and the trace fades,
  leaving exactly the static mark. All timing lives here because it derives
  from the asset; all appearance lives in global.css. Without the arming
  attribute on the root (reduced motion, no JavaScript, or already seen this
  visit) the drawing element is simply not shown.
*/
import rawSignature from "../../assets/logo/logo-signature.svg?raw";

interface Props {
  /** Height utility derived from tokens, e.g. "h-sig-corner". Width follows the viewBox. */
  class?: string;
  /** Decorative when the mark sits next to a text label that already names the brand. */
  decorative?: boolean;
  /** Prepare the paths for the one-time writing animation. */
  draw?: boolean;
  /*
    THE SAME WRITING, SCRUBBED (2026-08-10). Prepares the paths to be written by
    a number rather than by a clock: each one gets the SHARE OF THE PROGRESS it
    owns, --sig-from to --sig-to, and the stylesheet turns a 0..1 progress into
    that path's dash offset. The pen therefore moves at the reader's own speed
    and stops when they stop, which no timed animation can do.

    Used on the boundary wash, whose edge is already a scroll-driven number.
    Same pacing as `draw`, from the same measurement, so the two readings of the
    mark are the same reading.
  */
  scrub?: boolean;
}

const {class: className = "", decorative = false, draw = false, scrub = false} = Astro.props;

// The source file carries role="img", an aria-label and a <title>. When the
// mark is decorative we strip that so it is not announced twice.
let svg = decorative
  ? rawSignature
      .replace(/\s(role|aria-label)="[^"]*"/g, "")
      .replace(/<title>[\s\S]*?<\/title>/, "")
      .replace("<svg", '<svg aria-hidden="true" focusable="false"')
  : rawSignature;

/*
  Both modes pace from the same measurement: each path's share of the total path
  DATA, which tracks drawn length closely enough for pacing. Measured once here
  so `draw` and `scrub` can never drift apart.
*/
const pathShares = (source: string) => {
  const lengths = [...source.matchAll(/<path[^>]*\sd="([^"]*)"/g)].map((m) => m[1]!.length);
  const total = lengths.reduce((a, b) => a + b, 0) || 1;
  return {lengths, total};
};

if (scrub) {
  const {lengths, total} = pathShares(svg);
  /*
    A LIFT BETWEEN PATHS, as in `draw`, expressed as a share of the travel
    rather than as milliseconds: the pen leaves the paper briefly between the
    strokes. The shares are cumulative and the last path's --sig-to is exactly
    1, so at the end of the wash the mark is complete and completely filled —
    which matters, because what is left on screen when the edge finishes is the
    static mark and nothing else.
  */
  const LIFT = 0.04;
  const span = 1 - LIFT * Math.max(lengths.length - 1, 0);
  let cursor = 0;
  let index = 0;
  svg = svg.replace(/<path /g, () => {
    const share = (span * (lengths[index] ?? 0)) / total;
    const from = cursor;
    // Rounding, then clamping the last one to exactly 1: a mark that stops at
    // 0.998 never fills, and nobody would find that by reading the source.
    const to = index === lengths.length - 1 ? 1 : from + share;
    cursor = to + LIFT;
    index += 1;
    return `<path pathLength="1" style="--sig-from:${from.toFixed(4)};--sig-to:${to.toFixed(4)}" `;
  });
}

if (draw) {
  /*
    Writing pace: ~2.4s of ink for the whole mark, plus a breath before the
    pen touches and a lift between paths. Each path's share of the time is
    its share of the total path data, which tracks drawn length closely
    enough for pacing.
  */
  const TOTAL_MS = 2400;
  const START_MS = 400;
  const LIFT_MS = 140;
  const {lengths, total} = pathShares(svg);
  let clock = START_MS;
  let index = 0;
  svg = svg.replace(/<path /g, () => {
    const dur = Math.round((TOTAL_MS * (lengths[index] ?? 0)) / total);
    const style = `--sig-delay:${clock}ms;--sig-dur:${dur}ms`;
    clock += dur + LIFT_MS;
    index += 1;
    return `<path pathLength="1" style="${style}" `;
  });
}
---

<span
  class:list={["signature", draw && "sig-draw", scrub && "sig-scrub", className]}
  set:html={svg}
/>
