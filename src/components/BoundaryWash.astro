---
/*
  THE PASSAGE. What the boundary wash became when the site went to one polarity
  (2026-08-11, section 82).

  WHAT IT WAS. Two stacked full-viewport layers holding the same content, the
  bottom one the polarity being left and the top one the polarity being entered,
  with a hard edge scrubbed down the screen by scroll. It was the site's one
  structural gesture: the border between the world and the shop, performed.

  WHY IT COULD NOT STAY. The owner has decided every page is paper. An inversion
  between two identical colours is not a quiet inversion, it is nothing: the
  edge would travel down a screen that looks the same on both sides of it. A
  gesture that no longer means anything is worse than no gesture, so the
  INVERSION IS GONE — the two layers, the clip-path, the polarity props, all of
  it.

  WHAT REPLACED IT, AND WHY IT IS NOT A CONSOLATION PRIZE. The mark, written by
  the reader. The wash already carried the signature and already computed the
  scroll progress; what was decorative on top of the inversion is now the whole
  event. One held screen at the site's one boundary, and crossing it means
  writing the brand's name with your own scroll before the shop begins.

  That is a better fit for what this site is than the inversion ever was. The
  colour change said "you are somewhere else now" in the site's voice; the
  writing says it in HIS — it is his signature, his hand, the one thing on the
  site that is literally him, and it is the effect he likes most. The boundary
  did not lose its meaning; it changed who speaks at it.

  HOW IT IS PINNED, unchanged: the section is one viewport plus --wipe-pin tall
  and holds a position:sticky child, so the screen is held while the reader
  scrolls the pinned distance and the mark writes across it.

  WITH NO JAVASCRIPT, or under prefers-reduced-motion: the section collapses to
  a single screen and the signature is simply the finished mark. Nothing is
  hidden, nothing is waiting, and the page still reads as a held moment.
*/
import Spine from "./Spine.astro";
import Signature from "./Signature.astro";

interface Props {
  label?: string | null;
  sublabel?: string | null;
}

const {label, sublabel} = Astro.props;
---

<section class="wash" data-wash>
  <div class="wash-sticky">
    <div class="wash-layer frame">
      <Spine />
      <div class="wash-content">
        <div class="w-sig-wash">
          {/*
            THE MARK IS WRITTEN BY THE READER. Same pen, pacing and stroke order
            as the arrival's drawing; the clock is the reader's own scroll, so it
            slows when they slow and stops when they stop. `scrub` degrades to
            the plain filled mark whenever the wash is not live.
          */}
          <Signature decorative scrub />
        </div>
        {label && <p class="type-label text-label">{label}</p>}
        {sublabel && <p class="type-mono text-mono">{sublabel}</p>}
      </div>
    </div>
  </div>
</section>

<script>
  /*
    Drive the mark from scroll. One listener, one rAF, one custom property.

    `--edge-n` is the progress as a bare 0..1, which is what the signature's
    unitless dash offsets divide by. `--edge` went with the clip-path when the
    inversion did.
  */
  const washes = document.querySelectorAll<HTMLElement>("[data-wash]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (washes.length && !reduced.matches) {
    // Tells the stylesheet the scroll is under control: only then does the
    // section take its pinned height.
    document.documentElement.setAttribute("data-wash-live", "");
    let ticking = false;

    const update = () => {
      ticking = false;
      for (const wash of washes) {
        const rect = wash.getBoundingClientRect();
        const set = (progress: number) => wash.style.setProperty("--edge-n", progress.toFixed(4));
        // Off screen entirely: leave it at whichever end it belongs.
        if (rect.bottom < 0) {
          set(1);
          continue;
        }
        if (rect.top > window.innerHeight) {
          set(0);
          continue;
        }
        // How far through the pinned distance the reader has scrolled.
        const travel = rect.height - window.innerHeight;
        const progress = travel > 0 ? Math.min(Math.max(-rect.top / travel, 0), 1) : 0;
        set(progress);
      }
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    /*
      Only listen while a wash is actually on screen: a homepage should not run
      a scroll handler while the reader is three screens away from it.

      A SET, not a counter. An IntersectionObserver fires once per observed
      element on setup, including when it is NOT intersecting, so counting
      +1/-1 starts at minus one and the listener never attaches. That is exactly
      what happened the first time, and the mark sat unwritten for the whole
      pinned distance.
    */
    const onScreen = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }
        if (onScreen.size > 0) {
          window.addEventListener("scroll", onScroll, {passive: true});
          update();
        } else {
          window.removeEventListener("scroll", onScroll);
        }
      },
      {rootMargin: "100% 0px"},
    );
    washes.forEach((wash) => observer.observe(wash));
    update();
  }
</script>
