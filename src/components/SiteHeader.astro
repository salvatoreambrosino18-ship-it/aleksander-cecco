---
/*
  The top of every page: the MENU label and nothing else.

  Revised 2026-08-01. The corner signature and the always-visible IT|EN pair are
  gone from here; both now live inside the menu panel. Chrome does not compete
  with the imagery, and on the home page the signature is the hero rather than a
  corner mark (DESIGN-PLAN sections 1 and 4).

  It is a text surface, so it carries its segment of the spine. It is NOT
  sticky: it scrolls away with the page.
*/
import TextSurface from "./TextSurface.astro";
import Menu from "./Menu.astro";
import type {Locale} from "../lib/locales";

interface Props {
  locale: Locale;
}

const {locale} = Astro.props;
---

<TextSurface class="flex justify-end pt-u3 pb-u8">
  <Menu locale={locale} />
</TextSurface>
