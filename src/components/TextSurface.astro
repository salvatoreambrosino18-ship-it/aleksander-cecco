---
/*
  A TEXT SURFACE: flat paper or flat ink, no image, margins apply, and the spine
  runs down it.

  The site is built from two kinds of screen (DESIGN-PLAN section 4): media
  surfaces, which are full bleed and carry no rule of any kind, and text
  surfaces, which are these. The spine lives here and only here, so a hairline
  is never drawn across the owner's photography. Because consecutive text
  surfaces each draw their own segment at the same offset, the line reads
  continuous down the page and simply stops wherever a photograph interrupts it.

  Replaces the earlier Surface component, which drew the spine everywhere.
*/
import Spine from "./Spine.astro";

interface Props {
  theme?: "light" | "dark";
  /** Apply the text margins. Off only when the caller lays out its own padding. */
  framed?: boolean;
  /*
    THE ARRIVAL (section 69). Marks this surface with data-reveal so it enters
    on the same 900ms curve as the photography — the one motion system the site
    has, not a second one. Set it on the FIRST surface of an interior page and
    nowhere else: an arrival is a ceremony, and a ceremony that repeats down
    the page is a tic. All the reveal's guarantees apply unchanged: reduced
    motion never hides it, no JavaScript never hides it, and it happens once.
  */
  arrive?: boolean;
  class?: string;
}

const {theme, framed = true, arrive = false, class: className = ""} = Astro.props;
---

<section
  data-theme={theme}
  data-reveal={arrive ? "" : undefined}
  class:list={["relative", theme && "bg-bg text-fg", framed && "frame", className]}
>
  <Spine />
  <slot />
</section>
