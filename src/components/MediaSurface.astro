---
/*
  A MEDIA SURFACE: one photograph, full bleed, filling the screen. No card, no
  frame, no margin, no rounded corner, and no spine crossing it.

  Two ways to caption it, chosen per image by the owner in the studio:

  - "over": the label sits on the picture, in solid paper or solid ink (their
    choice), with no scrim and no gray.
  - "below": the label sits under the picture on the page itself, in the page's
    own polarity. This exists because three of the brand's own photographs are
    shot against bright concrete with a dark garment in frame, so the caption
    band holds both extremes and neither text color survives it.

  The fixed signature and MENU no longer pass over the picture at all (section
  87), so this surface publishes nothing for them and the caption's own measured
  polarity is the only overlay value left that matters.

  Video: the schema carries an optional muted loop, and since 2026-08-11
  (section 83) this renders the loop itself over its own poster. Nothing changes
  until a file exists — there are zero <video> elements in the build today — and
  every guarantee sits on the poster rather than on the video. See the note at
  the element below, and the shooting spec in section 83.
*/
import {fullBleedSrcSet, imageUrl, objectPosition} from "../lib/image";
import {overlayTheme, type MediaItem} from "../lib/media";
import {pick, pickAlt, type Locale} from "../lib/locales";

interface Props {
  media: MediaItem;
  locale: Locale;
  /**
   * "screen" fills the viewport, "tall" leaves the next one peeking, "band" is
   * "short" is the low row on the Creature index, "band" is a tile in a stacked
   * pair (58svh on a phone, full height on desktop, see DESIGN-PLAN section
   * 14), and "worn" is a frame inside the horizontal worn band, whose width
   * comes from the flex item around it.
   */
  height?: "screen" | "tall" | "short" | "band" | "worn" | "tile" | "square" | "paired";
  /**
   * A different height from `height` at desktop. It exists for the gallery,
   * where a phone alternates tall and short down one column and a desktop pairs
   * portraits two across, and a pair must agree on its height or the row that
   * has no gutter grows a hole (DESIGN-PLAN section 56).
   */
  desktopHeight?: "screen" | "tall" | "short" | "tile";
  /** The first image on a page is the largest thing it downloads. */
  priority?: boolean;
  /*
    WHAT THE BROWSER IS TOLD ABOUT THE RENDERED WIDTH (section 69). Every
    frame declared sizes="100vw", including tiles that render at a quarter of
    it, so a 360px tile downloaded a 1440px source: sixteen times the pixels,
    and with the hover frame it took the catalogue to 1.8 MB and an 8.7s LCP
    on Slow 4G. Full bleed stays the default; a tile declares its truth
    automatically; any caller whose layout differs can say so.
  */
  sizes?: string;
  /**
   * A second frame revealed on hover, for the catalogue screen. CSS only: no
   * script, and it does not exist for a touch reader, who gets the first frame
   * exactly as before. Under prefers-reduced-motion it swaps with no transition
   * rather than being removed, because the information is the second view of the
   * garment and that is not decoration (DESIGN-PLAN section 60).
   */
  hover?: MediaItem | null;
  /**
   * Reveal this frame as it enters (DESIGN-PLAN section 24). Defaults to on,
   * except for a priority image: the arrival must not be faded in, because it
   * is the LCP element and an arrival that arrives late is not an arrival.
   * The worn band turns it off per frame and reveals as one presence instead.
   */
  reveal?: boolean;
  class?: string;
}

const {
  media,
  locale,
  height = "screen",
  desktopHeight,
  priority = false,
  sizes: sizesProp,
  hover = null,
  reveal,
  class: className = "",
} = Astro.props;

const revealThis = reveal ?? !priority;

/* The tile grid is two across, four from the xl breakpoint (80rem). */
const isTile = height === "tile" || desktopHeight === "tile";
/*
  AN INSTAGRAM SQUARE IS NOT FULL BLEED (2026-08-11). It fell through to
  `100vw` and so declared itself fourteen hundred pixels wide while rendering at
  most 416 — the section 69 trap exactly, a `sizes` that lies and no tool that
  flags it. Its real width is --ig-s, min(72vw, 21rem), growing to the 26rem
  ceiling once the row has room. Declared here so the browser can pick the
  smallest source that is still sharp, which is also what decides whether a
  1067px original is enough.
*/
const sizes =
  sizesProp ??
  (isTile
    ? "(min-width: 80rem) 25vw, 50vw"
    : height === "square"
      ? "(min-width: 48rem) 26rem, 72vw"
      : "100vw");

/*
  THE CHROME BAND NO LONGER CROSSES THIS FRAME (2026-08-11, section 87). The
  signature and MENU sit in page ground above the photograph, so `overlayChrome`
  and the polarity this surface used to publish are both gone. What remains is
  the CAPTION's own measured value, below, which is a different band with a
  different answer and is still load-bearing.
*/
/*
  The caption is at the OTHER END of the photograph from the chrome, so it takes
  its own measured polarity. One value for both was what put eight captions
  below WCAG AA (DESIGN-PLAN section 58).
*/
const captionTheme = overlayTheme(media.overlayCaption ?? media.overlay);
const alt = pickAlt(media.alt, locale);
const caption = pick(media.caption, locale);
/*
  A TILE IS 195 PIXELS WIDE ON A PHONE AND THERE ARE THIRTY-SIX OF THEM
  (section 95). Fifty-five there, eighty everywhere else. Measured on a real
  phone, this line took the catalogue from 1524 KB to 1180; the flick strip
  going from four frames to two took it from 2315 to 1524. Neither is visible at
  that size and both are worth 200 KB on the page a buyer lands on.

  A FULL-BLEED FRAME KEEPS 80: it is the whole screen and it is the work.
*/
const quality = isTile ? 55 : 80;
const src = imageUrl(media.poster, 1440, quality);
const srcset = fullBleedSrcSet(media.poster, quality);

const below = media.captionPlacement === "below";
/*
  AN EMPTY CAPTION IS NOT A CAPTION (2026-08-11, section 84).

  `Astro.slots.has("default")` answers "were children passed", not "do they
  render anything". A Creature page maps over its frames and writes the name and
  price only for the first — `{index === 0 && (...)}` — which is still a child
  expression on every other frame. So every frame after the first rendered an
  EMPTY <figcaption>, and for the "below" placement that is `frame py-u3`: two
  units of page padding, about 50 to 70px of blank paper, opening between two
  full-bleed photographs on the shop's most important page. Thirty-three of them
  across the English Creature pages alone, in the built HTML, invisible to every
  check because the markup is valid and the gap is only space.

  Rendering the slot and asking whether it produced anything is the only honest
  test; `has()` cannot see through a false branch.
*/
const slotHtml = Astro.slots.has("default") ? await Astro.slots.render("default") : "";
const hasSlot = slotHtml.trim() !== "";
const hasLabel = Boolean(caption) || hasSlot;

/*
  IS THIS SURFACE THE PAGE'S FULL WIDTH? (2026-08-10)

  A "below" caption sits on the page rather than on the picture, so it takes the
  page margins — correct for a full-bleed frame, and wrong for a frame that is
  not the page. Inside the worn band a frame is `--worn-w`, min(32vw, 26rem):
  at 1440 that is a 416px item, and `frame` was giving its caption 175px of left
  padding and 115px of right, leaving a garment's name 126px to wrap inside. The
  Instagram squares are the same shape of container.

  A contained frame takes the caption inset instead, which is the same edge
  distance an "over" caption already uses on the same photograph. So the two
  placements agree at the edge, and only the polarity differs — which is the
  entire point of the choice.
*/
const contained =
  height === "worn" || height === "square" || height === "tile" || desktopHeight === "tile";
---

<figure
  data-reveal={revealThis ? "" : undefined}
  class:list={["relative w-full", className]}
>
  <div
    class:list={[
      "relative w-full overflow-hidden",
      height === "screen" && "h-media-screen",
      height === "tall" && "h-media-tall",
      height === "short" && "h-media-short",
      height === "band" && "h-media-band md:h-media-screen",
      height === "worn" && "h-worn",
      /*
        A CATALOGUE TILE AT EVERY WIDTH: the photograph's own 3:4. Two across on
        a phone means a viewport-height frame would be a 195px-wide column two
        screens deep, so the tile keeps its proportion instead of the viewport's.
      */
      height === "tile" && "h-auto aspect-[3/4]",
      /* Instagram's native shape (section 71): the recognition signal is the
         square itself. The hotspot decides what survives it. */
      height === "square" && "h-auto aspect-square",
      /* Half of a paired screen: a phone stacks it at 62svh, desktop fills. */
      height === "paired" && "h-media-short lg:h-full",
      desktopHeight === "screen" && "md:h-media-screen",
      desktopHeight === "tall" && "md:h-media-tall",
      desktopHeight === "short" && "md:h-media-short",
      /*
        A shop tile: the photograph's own 3:4 at desktop instead of a viewport
        unit, because a dense grid of viewport-height frames is a wall of
        letterboxes. Phone keeps whatever `height` says.
      */
      desktopHeight === "tile" && "md:h-auto md:aspect-[3/4]",
    ]}
  >
    {/*
      THE LOOP, WHEN ONE EXISTS (2026-08-11, section 83).

      The schema has carried an optional muted loop since the beginning and the
      query has projected `hasVideo` as a boolean the whole time — so nothing
      could ever play it, and "video drops in without a rebuild" was not true.
      It is now.

      Every guarantee is on the POSTER, not on the video:

      - the poster is the `poster` attribute AND the img below is what a reader
        sees until a frame decodes, so a failed or blocked video is invisible;
      - `preload="none"` because asset bandwidth is the one thing capable of
        straining the free plan (standing rule 12). It fetches when it plays;
      - it plays only while on screen and pauses when it leaves, so a page of
        loops is never a page of decoders;
      - REDUCED MOTION GETS THE STILL. Not a paused video, no element at all:
        a loop is motion by definition and there is no reduced version of it.
      - no controls, muted, playsinline, loop: it is a moving photograph, not a
        player, and it must never take over an iPhone's screen.
    */}
    {
      media.videoUrl && (
        <video
          class="video-loop absolute inset-0 h-full w-full object-cover"
          src={media.videoUrl}
          poster={src ?? undefined}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          tabindex="-1"
          style={`object-position: ${objectPosition(media.poster)}`}
        />
      )
    }

    {
      src && (
        <img
          src={src}
          srcset={srcset}
          sizes={sizes}
          alt={alt}
          width={media.dimensions?.width}
          height={media.dimensions?.height}
          loading={priority ? "eager" : "lazy"}
          decoding={priority ? "sync" : "async"}
          fetchpriority={priority ? "high" : "auto"}
          style={`object-position: ${objectPosition(media.poster)}`}
          class="h-full w-full object-cover"
        />
      )
    }

    {
      /*
        The hover frame downloads ONLY where hover exists (section 69). A
        phone can never show it, and seventeen of them were roughly a third
        of the catalogue's transfer. The <source media="(hover: hover)">
        carries the real srcset; on touch the <img> falls back to a
        transparent pixel and fetches nothing else.
      */
      hover?.poster && (
        <picture>
          <source media="(hover: hover)" srcset={fullBleedSrcSet(hover.poster, quality)} sizes={sizes} />
          <img
            src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
            alt=""
            aria-hidden="true"
            width={hover.dimensions?.width}
            height={hover.dimensions?.height}
            loading="lazy"
            decoding="async"
            style={`object-position: ${objectPosition(hover.poster)}`}
            class="hover-frame absolute inset-0 h-full w-full object-cover"
          />
        </picture>
      )
    }

    {
      hasLabel && !below && (
        <figcaption
          data-theme={captionTheme}
          class="text-fg absolute inset-x-0 bottom-0 flex flex-col gap-u1 p-caption"
        >
          {hasSlot && <Fragment set:html={slotHtml} />}
          {caption && <span class="type-label text-label">{caption}</span>}
        </figcaption>
      )
    }
  </div>

  {
    hasLabel && below && (
      /* On the page, not on the picture: page polarity, inside the margins —
         or inside the caption inset when the frame is not the page's width. */
      <figcaption class:list={["flex flex-col gap-u1", contained ? "p-caption" : "frame py-u3"]}>
        {hasSlot && <Fragment set:html={slotHtml} />}
        {caption && <span class="type-label text-label">{caption}</span>}
      </figcaption>
    )
  }
</figure>
