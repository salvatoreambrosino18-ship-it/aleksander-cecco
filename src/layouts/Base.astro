---
/*
  The shell every page sits inside: the document head, the spine, the corner
  treatment, and the footer. Pages supply only their own content.

  Polarity is a property of the page (or later, of a section): `theme` sets
  data-theme, and every token resolves from it. There is no interpolated state
  between the two themes anywhere (DESIGN-PLAN section 3).
*/
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {getSiteSettings} from "../lib/content";
import {pick} from "../lib/locales";
import {imageUrl} from "../lib/image";
import {LOCALES, localePath, switchLocalePath, type Locale} from "../lib/locales";
import {t} from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Page title, without the brand name; the brand is appended here. */
  title?: string;
  description?: string;
  theme?: "light" | "dark";
  /**
   * Polarity of the fixed chrome on first paint, before any observer runs.
   * On a media-led page this is the first media item's overlay polarity.
   */
  chrome?: "light" | "dark";
  /** Absolute URL of the sharing image. Always a real photograph, never art. */
  image?: string | null;
  /*
    The shipping line is SHOP dress (section 68). It opens every commerce
    surface, and it leaves the two culture pages: process and about are where
    a visitor enters the brand's world, and logistics before the first pixel
    of a world is how the spell breaks. Ferdressed, whose device the banner
    is, sets it under the wordmark; nobody crowns an about page with it.
  */
  shopChrome?: boolean;
  /**
   * The polarity the page ENDS in. On a page that inverts partway down, the
   * footer belongs to the second half, not the first.
   */
  footerTheme?: "light" | "dark";
}

const {locale, title, description: rawDescription, theme = "light", chrome, image, footerTheme, shopChrome = true} =
  Astro.props;

/*
  A description is a single line by the time it reaches a search result or a
  share card, so collapse it here rather than asking every page to remember.
  His copy carries meaningful line breaks on the page; they are not meaningful
  in a meta tag.
*/
const description = rawDescription?.replace(/\s+/g, " ").trim() || undefined;

const settings = await getSiteSettings();

const brand = "Aleksander Cecco";

/*
  TITLES AS A SYSTEM (2026-08-03), because a tab and a history entry are the two
  places a person meets this site without seeing any of its design.

  The shape is `Thing / Aleksander Cecco`, narrow to wide, so the distinguishing
  word is FIRST: a reader with six tabs open sees "Oblivion", "Gallery",
  "Corvinus", not six identical brand names truncated at the same point. The
  brand still closes every one, because the tab may be the only place a visitor
  who arrived from Instagram reads the name at all.

  A Creature adds its price, because that is the fact a person is most often
  tab-hoarding in order to compare, and it costs nothing to give it to them.
*/
const documentTitle = title ? `${title} / ${brand}` : brand;

const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site) : null;

const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";

const banner = pick(settings.shippingFree, locale);

const shareImage =
  image ?? (settings.openingMedia ? imageUrl(settings.openingMedia.poster, 1200) : null);
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}

    {/*
      THE MARK IN THE TAB is the AC monogram EXTRACTED from the signature
      itself (section 72, superseding 71): the owner chose his actual hand
      over the redrawn candidate's easy legibility, and asked for the A alone
      — the 'l' that shares the A's continuous outline was cut away along a
      corridor measured by scanline. At 16px the mark reads as his gesture
      rather than as the letters, and he accepted exactly that trade. The
      redrawn candidate stays in docs/monogram/ as the recorded alternative.
      The SVG follows the reader's system theme; the full signature stays
      everywhere else.
    */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={theme === "dark" ? "#0A0A0A" : "#FAFAF8"} />

    {/*
      Pre-launch: keep an unfinished site carrying {PLACEHOLDER} copy out of
      search results. Follows one switch, PUBLIC_ALLOW_INDEXING, so launch is a
      configuration change rather than an edit to every page. The second lock is
      the X-Robots-Tag header in public/_headers, removed by hand at launch.
      DESIGN-PLAN section 16.
    */}
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical.href} />}
    {
      Astro.site &&
        LOCALES.map((code) => (
          <link rel="alternate" hreflang={code} href={new URL(switchLocalePath(pathname, code), Astro.site).href} />
        ))
    }
    {Astro.site && <link rel="alternate" hreflang="x-default" href={new URL(localePath("en"), Astro.site).href} />}

    {/*
      Sharing metadata. The image is always one of the owner's photographs, from
      the page it belongs to. There is no generated card and no invented
      artwork. Description is present only where the content supplies one:
      inventing brand copy for a meta tag is still inventing brand copy.
    */}
    <meta property="og:site_name" content={brand} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:locale" content={locale === "it" ? "it_IT" : "en_GB"} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {description && <meta property="og:description" content={description} />}
    {/*
      EVERY page gets a share image, not just the ones that thought to pass one.
      Traffic arrives from Instagram, so a shared link IS the first impression,
      and a link with no card is a worse first impression than any photograph.
      Falls back to the arrival, which is the drop the brand is currently
      showing, so the card changes when he changes that one field.
    */}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta name="twitter:card" content="summary_large_image" />}
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    {/* Preload only the first-screen typeface (Archivo). Mono is not on the hero. */}
    <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a
      href="#content"
      class="type-mono text-mono sr-only focus:not-sr-only focus:absolute focus:left-content focus:top-u1 focus:z-10 focus:bg-bg focus:p-u1 focus:text-fg"
    >
      {t(locale, "skipToContent")}
    </a>

    {/*
      No spine at this level. The spine belongs to text surfaces only and stops
      at the edge of any full-bleed media (DESIGN-PLAN section 2). Header,
      footer and every text section draw their own segment at the same offset,
      so the line reads continuous and breaks exactly where a photograph starts.
    */}
    {/*
      THE SHIPPING LINE (2026-08-04). One thin line at the top of every page:
      his real policy, in his own words (`shippingFree`, unmarked because both
      the fact and the wording are his). His other shop runs exactly this banner
      over the same photography and it reads as a shop within a second, which is
      what this site was failing to do.

      STATIC, not fixed: it scrolls away with the page, so it says its one thing
      at arrival and then leaves the photography alone. It is not the persistent
      bar section 4 removed, because it does not persist.
    */}
    {banner && shopChrome && (
      <div class="bg-bg text-fg hairline-b frame flex justify-center py-u1">
        <p class="type-label text-label banner-line text-center">{banner}</p>
      </div>
    )}
    <SiteHeader locale={locale} chrome={chrome ?? theme} pageTheme={theme} />

    <div class="flex min-h-svh flex-col">
      <main id="content" class="flex-1">
        <slot />
      </main>
      <SiteFooter locale={locale} settings={settings} theme={footerTheme} />
    </div>

    {/*
      Chrome polarity. Each media surface declares the polarity its overlay text
      needs (the owner's per-image choice in the studio). As one passes under
      the fixed chrome, the chrome takes the same polarity, so the signature and
      MENU stay legible over any photograph without a scrim, a blend mode, or a
      third color. This is a state swap, not motion: nothing animates, and with
      JavaScript off the chrome simply keeps the polarity the page declared.
    */}
    <script is:inline>
      (() => {
        const chrome = document.getElementById("site-chrome");
        const zones = document.querySelectorAll("[data-chrome-polarity]");
        if (!chrome || !zones.length || !("IntersectionObserver" in window)) return;

        const fallback = chrome.getAttribute("data-theme") || "light";
        let active = [];

        const apply = () => {
          const top = active
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          const polarity = top ? top.target.getAttribute("data-chrome-polarity") : fallback;
          chrome.setAttribute("data-theme", polarity || fallback);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              active = active.filter((e) => e.target !== entry.target).concat(entry);
            }
            apply();
          },
          // a thin band across the very top of the viewport: whatever is under
          // the chrome right now is what the chrome must be legible against
          {rootMargin: "0px 0px -95% 0px", threshold: 0},
        );

        zones.forEach((zone) => observer.observe(zone));
      })();
    </script>

    {/*
      THE PHOTOGRAPHY REVEAL (DESIGN-PLAN section 24). A presence arriving: the
      frame rises a little and resolves, once, and is never touched again.

      Two refusals are the important part of this script.

      IT MARKS THE ROOT BEFORE HIDING ANYTHING. The hidden state lives behind
      data-reveal-live, so a reader with JavaScript off, or with a blocked
      script, or on a browser without IntersectionObserver, gets every
      photograph visible. On a site that is entirely photographs, the failure
      mode of getting this wrong is a blank page, so it is not left to chance.

      IT UNOBSERVES ON FIRST SIGHT. A frame reveals once and never re-hides on
      the way back up. Motion that repeats every time a reader scrolls past is
      the "elements bouncing" this is meant to avoid.

      Reduced motion: the root is never marked, so nothing is ever hidden and no
      transition is ever declared. The CSS repeats the guarantee in case the
      preference changes after load.
    */}
    <script is:inline>
      (() => {
        const frames = document.querySelectorAll("[data-reveal]");
        if (!frames.length) return;
        if (!("IntersectionObserver" in window)) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        document.documentElement.setAttribute("data-reveal-live", "");

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.setAttribute("data-revealed", "");
              observer.unobserve(entry.target);
            }
          },
          // A little into the viewport, so a frame is already resolving by the
          // time it is properly on screen rather than starting at the edge.
          {rootMargin: "0px 0px -8% 0px"},
        );

        frames.forEach((frame) => observer.observe(frame));
      })();
    </script>
  </body>
</html>
