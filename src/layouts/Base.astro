---
/*
  The shell every page sits inside: the document head, the spine, the corner
  treatment, and the footer. Pages supply only their own content.

  Polarity is a property of the page (or later, of a section): `theme` sets
  data-theme, and every token resolves from it. There is no interpolated state
  between the two themes anywhere (DESIGN-PLAN section 3).
*/
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {getSiteSettings} from "../lib/content";
import {LOCALES, localePath, switchLocalePath, type Locale} from "../lib/locales";
import {t} from "../i18n/ui";

interface Props {
  locale: Locale;
  /** Page title, without the brand name; the brand is appended here. */
  title?: string;
  description?: string;
  theme?: "light" | "dark";
  /**
   * Polarity of the fixed chrome on first paint, before any observer runs.
   * On a media-led page this is the first media item's overlay polarity.
   */
  chrome?: "light" | "dark";
  /** Absolute URL of the sharing image. Always a real photograph, never art. */
  image?: string | null;
  /**
   * The polarity the page ENDS in. On a page that inverts partway down, the
   * footer belongs to the second half, not the first.
   */
  footerTheme?: "light" | "dark";
}

const {locale, title, description, theme = "light", chrome, image, footerTheme} = Astro.props;

const settings = await getSiteSettings();

const brand = "Aleksander Cecco";
const documentTitle = title ? `${title} / ${brand}` : brand;

const pathname = Astro.url.pathname;
const canonical = Astro.site ? new URL(pathname, Astro.site) : null;

const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === "true";
---

<!doctype html>
<html lang={locale} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    {description && <meta name="description" content={description} />}

    {/*
      Pre-launch: keep an unfinished site carrying {PLACEHOLDER} copy out of
      search results. Follows one switch, PUBLIC_ALLOW_INDEXING, so launch is a
      configuration change rather than an edit to every page. The second lock is
      the X-Robots-Tag header in public/_headers, removed by hand at launch.
      DESIGN-PLAN section 16.
    */}
    {!allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical.href} />}
    {
      Astro.site &&
        LOCALES.map((code) => (
          <link rel="alternate" hreflang={code} href={new URL(switchLocalePath(pathname, code), Astro.site).href} />
        ))
    }
    {Astro.site && <link rel="alternate" hreflang="x-default" href={new URL(localePath("it"), Astro.site).href} />}

    {/*
      Sharing metadata. The image is always one of the owner's photographs, from
      the page it belongs to. There is no generated card and no invented
      artwork. Description is present only where the content supplies one:
      inventing brand copy for a meta tag is still inventing brand copy.
    */}
    <meta property="og:site_name" content={brand} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:locale" content={locale === "it" ? "it_IT" : "en_GB"} />
    {canonical && <meta property="og:url" content={canonical.href} />}
    {description && <meta property="og:description" content={description} />}
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    {/* Preload only the first-screen typeface (Archivo). Mono is not on the hero. */}
    <link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a
      href="#content"
      class="type-mono text-mono sr-only focus:not-sr-only focus:absolute focus:left-content focus:top-u1 focus:z-10 focus:bg-bg focus:p-u1 focus:text-fg"
    >
      {t(locale, "skipToContent")}
    </a>

    {/*
      No spine at this level. The spine belongs to text surfaces only and stops
      at the edge of any full-bleed media (DESIGN-PLAN section 2). Header,
      footer and every text section draw their own segment at the same offset,
      so the line reads continuous and breaks exactly where a photograph starts.
    */}
    <SiteHeader locale={locale} chrome={chrome ?? theme} />

    <div class="flex min-h-svh flex-col">
      <main id="content" class="flex-1">
        <slot />
      </main>
      <SiteFooter locale={locale} settings={settings} theme={footerTheme} />
    </div>

    {/*
      Chrome polarity. Each media surface declares the polarity its overlay text
      needs (the owner's per-image choice in the studio). As one passes under
      the fixed chrome, the chrome takes the same polarity, so the signature and
      MENU stay legible over any photograph without a scrim, a blend mode, or a
      third color. This is a state swap, not motion: nothing animates, and with
      JavaScript off the chrome simply keeps the polarity the page declared.
    */}
    <script is:inline>
      (() => {
        const chrome = document.getElementById("site-chrome");
        const zones = document.querySelectorAll("[data-chrome-polarity]");
        if (!chrome || !zones.length || !("IntersectionObserver" in window)) return;

        const fallback = chrome.getAttribute("data-theme") || "light";
        let active = [];

        const apply = () => {
          const top = active
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
          const polarity = top ? top.target.getAttribute("data-chrome-polarity") : fallback;
          chrome.setAttribute("data-theme", polarity || fallback);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              active = active.filter((e) => e.target !== entry.target).concat(entry);
            }
            apply();
          },
          // a thin band across the very top of the viewport: whatever is under
          // the chrome right now is what the chrome must be legible against
          {rootMargin: "0px 0px -95% 0px", threshold: 0},
        );

        zones.forEach((zone) => observer.observe(zone));
      })();
    </script>
  </body>
</html>
