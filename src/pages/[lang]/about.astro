---
/*
  About, rebuilt 2026-08-02 as a story (DESIGN-PLAN section 22).

  This is the one page where the owner's text appears COMPLETE and UNBROKEN, in
  his order, nothing cut. Everywhere else on the site carries an excerpt of it;
  here it exists whole, so there is always one place a reader can go and get the
  brand in its own words rather than in fragments we chose.

  THE FORM. One photograph with a single line over it, then a descent: a screen
  of text, a photograph, the next screen of text, and so on. The text sets the
  pace and the photographs are the evidence for it. Paragraphs come from the
  owner's own blank lines, so HE controls where the page breathes; we do not
  re-cut his writing to fit a layout.

  Two registers, chosen by length rather than by rule. His short declamatory
  paragraphs take the statement register; his long discursive ones take body.
  Uppercasing a sixty-word sentence at statement size is shouting, and the
  register exists to serve the voice, not the other way round.

  WHOSE WORDS. His, so no draft mark. In Italian they are our translation of
  his, so the page says exactly that, once, at the top. See lib/voice.ts: an
  "unapproved draft" would wrongly imply the brand has not decided what it says.

  Reduced from a full screen: the opening photograph is the only sealed screen,
  and every frame after it is "tall", so the next block always peeks.
*/
import Base from "../../layouts/Base.astro";
import TextSurface from "../../components/TextSurface.astro";
import MediaSurface from "../../components/MediaSurface.astro";
import Statement from "../../components/Statement.astro";
import {getSiteSettings, isPlaceholderText} from "../../lib/content";
import {LOCALES, pick, toLocale} from "../../lib/locales";
import {overlayTheme} from "../../lib/media";
import {imageUrl} from "../../lib/image";
import {isMarked, voiceState} from "../../lib/voice";
import {t} from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const settings = await getSiteSettings();

const about = pick(settings.about, locale);
const aboutIsPlaceholder = isPlaceholderText(about);
const openingLine = pick(settings.aboutOpeningLine, locale);
const openingMedia = settings.aboutOpeningMedia;
const photographs = settings.aboutMedia ?? [];

/*
  aboutIsDraft means "we wrote this", which is now false: the story is his. What
  remains is whether this language is one he approved.
*/
const voice = voiceState(settings, locale, Boolean(settings.aboutIsDraft));
const marked = isMarked(voice) && Boolean(about) && !aboutIsPlaceholder;
const noticeKey = voice === "translation" ? "translationNotice" : "draftNotice";

/*
  His blank lines are the paragraph breaks. Short paragraphs get the statement
  register, long ones get body; the threshold is a word count, not a guess about
  which sentence is more important.
*/
const paragraphs = (about ?? "")
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const isShort = (p: string) => p.split(/\s+/).length <= 18;

/*
  THE PERSON, folded in from the former /designer page (2026-08-03). The
  portrait, and his biography when he writes one. His making lines are NOT
  repeated here: they are already on this page, inside his complete text.
*/
const portrait = settings.designerPortrait;
const designerText = pick(settings.designerText, locale);
---

<Base
  locale={locale}
  title={t(locale, "about")}
  description={openingLine ?? undefined}
  theme="dark"
  footerTheme="dark"
  chrome={overlayTheme(openingMedia?.overlay)}
  image={openingMedia ? imageUrl(openingMedia.poster, 1200) : null}
>
  {/*
    THE ARRIVAL: one photograph, one line. The line is a whole sentence of his,
    unaltered, and it is deliberately the shortest one he wrote.
  */}
  {
    openingMedia ? (
      <MediaSurface media={openingMedia} locale={locale} priority>
        <h1 class="type-statement text-statement">{openingLine ?? t(locale, "about")}</h1>
      </MediaSurface>
    ) : (
      <TextSurface theme="dark" class="flex min-h-svh flex-col justify-center">
        <h1 class="type-label text-label">{t(locale, "about")}</h1>
        <p class="placeholder-mark self-start">{"{ABOUT_OPENING_PHOTOGRAPH}"}</p>
      </TextSurface>
    )
  }

  {/*
    The mark, once, at the top of the story rather than beside every paragraph.
    Repeating it down the page would turn a single honest caveat into noise.
  */}
  {
    marked && (
      <TextSurface theme="dark" class="pt-u8">
        <p class="placeholder-mark self-start">{t(locale, noticeKey)}</p>
      </TextSurface>
    )
  }

  {!about && (
    <TextSurface theme="dark" class="py-u13">
      <p class="placeholder-mark self-start">{"{ABOUT}"}</p>
    </TextSurface>
  )}

  {
    about && aboutIsPlaceholder && (
      <TextSurface theme="dark" class="py-u13">
        <p class="placeholder-mark self-start">{about}</p>
      </TextSurface>
    )
  }

  {/*
    THE DESCENT. A paragraph, then a photograph, then the next paragraph. If
    there are more paragraphs than frames, or the other way round, the leftovers
    simply continue: the page degrades to plain prose, or to a sequence of
    photographs, without a rewrite.
  */}
  {
    about &&
      !aboutIsPlaceholder &&
      paragraphs.map((paragraph, index) => (
        <>
          <TextSurface theme="dark" class="py-u13">
            <p
              class:list={[
                isShort(paragraph) ? "type-statement text-statement" : "type-body text-body",
                "max-w-prose whitespace-pre-line",
                marked && "draft-text",
              ]}
            >
              {paragraph}
            </p>
          </TextSurface>

          {photographs[index] && (
            <MediaSurface media={photographs[index]} locale={locale} height="tall" />
          )}
        </>
      ))
  }

  {/* Any frames left over after the text simply continue the sequence. */}
  {photographs.slice(paragraphs.length).map((media) => (
    <MediaSurface media={media} locale={locale} height="tall" />
  ))}

  {/*
    THE PERSON, folded in from the designer page on 2026-08-03 by the owner's
    instruction. They were two sections telling one story: the brand, then the
    man who makes it. Read one after the other they are a single descent, and
    the reason the separate page existed (an international buyer needs to see
    that one real person makes these, DESIGN-PLAN sections 32 and 33) is served
    better at the END of the story than on a page nobody was sent to.

    THE PORTRAIT IS LAST, and that ordering is the whole point: the story first,
    the person at the bottom, so the page arrives at him rather than opening on
    him. The route is gone and 301s to here; the menu carries one entry.
  */}
  {/*
    Heading and placeholder in ONE block, not two. Rendered as two they stacked
    two lots of vertical padding and read as an empty box waiting for text,
    which is a different thing from the deliberate emptiness this site uses.
  */}
  {(designerText || portrait) && (
    <TextSurface theme="dark" class="hairline-h flex flex-col gap-u5 py-u13">
      <h2 class="type-label text-label">{t(locale, "designer")}</h2>
      {!designerText && <p class="placeholder-mark self-start">{"{DESIGNER_BIOGRAPHY}"}</p>}
    </TextSurface>
  )}

  {/*
    NO MAKING TEXT HERE, and that is the correction the merge needed. On its own
    page this section carried his making lines, because it had no other text.
    Folded into the story those same sentences are already ON this page, a few
    screens above, inside his complete text: the page said them twice, which is
    exactly the kind of seam a merge leaves and a reader notices.

    What belongs to the PERSON rather than to the brand is the portrait and a
    biography he has not written yet. So that is all this carries.
  */}

  {/*
    Everything a designer page normally carries and this one cannot yet. A
    marked placeholder, never a plausible sentence: inventing where someone
    trained is the same offence as inventing what the brand believes. His name
    is deliberately NOT here (section 44): whether the maker is named in public
    is his decision and he has not made it.
  */}
  {/*
    His biography when he writes one, in his voice and marked like the rest of
    it. Until then the heading block above carries the placeholder: a marked
    gap, never a plausible sentence about where someone trained.
  */}
  {designerText && (
    <Statement text={designerText} locale={locale} voice={voice} register="body" theme="dark" />
  )}

  {portrait && <MediaSurface media={portrait} locale={locale} height="tall" />}
</Base>
