---
/*
  About. A text surface on the spine: no media unless the owner supplies one.

  The about copy comes from site settings and is a placeholder until the brand
  writes its own. While it is a placeholder it is MARKED as one, rather than
  being smoothed into something that reads like the brand's voice.
*/
import Base from "../../layouts/Base.astro";
import TextSurface from "../../components/TextSurface.astro";
import {getSiteSettings, isPlaceholderText} from "../../lib/content";
import {LOCALES, pick, toLocale} from "../../lib/locales";
import {t} from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const settings = await getSiteSettings();
const about = pick(settings.about, locale);
const aboutIsPlaceholder = isPlaceholderText(about);
// A real text nobody has approved. Marked, not hidden: the owner has to be able
// to read it on the page to judge it, and a visitor has to be able to tell.
const aboutIsDraft = Boolean(settings.aboutIsDraft) && !aboutIsPlaceholder;
---

<Base locale={locale} title={t(locale, "about")}>
  <TextSurface class="flex min-h-svh flex-col gap-u8 pt-chrome pb-u21">
    <h1 class="type-label text-label">{t(locale, "about")}</h1>

    {
      about ? (
        aboutIsPlaceholder ? (
          <p class="placeholder-mark self-start">{about}</p>
        ) : (
          <div class="flex flex-col gap-u3">
            {aboutIsDraft && <p class="placeholder-mark self-start">{t(locale, "draftNotice")}</p>}
            <p
              class:list={[
                "type-body text-body max-w-prose whitespace-pre-line",
                aboutIsDraft && "draft-text",
              ]}
            >
              {about}
            </p>
          </div>
        )
      ) : (
        <p class="placeholder-mark self-start">{"{ABOUT}"}</p>
      )
    }
  </TextSurface>
</Base>
