---
/*
  About, rebuilt 2026-08-02 as a story (DESIGN-PLAN section 22).

  This is the one page where the owner's text appears COMPLETE and UNBROKEN, in
  his order, nothing cut. Everywhere else on the site carries an excerpt of it;
  here it exists whole, so there is always one place a reader can go and get the
  brand in its own words rather than in fragments we chose.

  THE FORM. One photograph with a single line over it, then a descent: a screen
  of text, a photograph, the next screen of text, and so on. The text sets the
  pace and the photographs are the evidence for it. Paragraphs come from the
  owner's own blank lines, so HE controls where the page breathes; we do not
  re-cut his writing to fit a layout.

  Two registers, chosen by length rather than by rule. His short declamatory
  paragraphs take the statement register; his long discursive ones take body.
  Uppercasing a sixty-word sentence at statement size is shouting, and the
  register exists to serve the voice, not the other way round.

  WHOSE WORDS. His, so no draft mark. In Italian they are our translation of
  his, so the page says exactly that, once, at the top. See lib/voice.ts: an
  "unapproved draft" would wrongly imply the brand has not decided what it says.

  Reduced from a full screen: the opening photograph is the only sealed screen,
  and every frame after it is "tall", so the next block always peeks.
*/
import Base from "../../layouts/Base.astro";
import TextSurface from "../../components/TextSurface.astro";
import MediaSurface from "../../components/MediaSurface.astro";
import PairedSurface from "../../components/PairedSurface.astro";
import {getSiteSettings, isPlaceholderText} from "../../lib/content";
import {LOCALES, pick, toLocale} from "../../lib/locales";
import {imageUrl} from "../../lib/image";
import {isMarked, voiceState} from "../../lib/voice";
import {t} from "../../i18n/ui";
import {SHOW_UNAPPROVED_MARKS} from "../../lib/marks";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const settings = await getSiteSettings();

const about = pick(settings.about, locale);
const aboutIsPlaceholder = isPlaceholderText(about);
const openingLine = pick(settings.aboutOpeningLine, locale);
const openingMedia = settings.aboutOpeningMedia;
const photographs = settings.aboutMedia ?? [];

/*
  aboutIsDraft means "we wrote this", which is now false: the story is his. What
  remains is whether this language is one he approved.
*/
const voice = voiceState(settings, locale, Boolean(settings.aboutIsDraft));
const marked = SHOW_UNAPPROVED_MARKS && isMarked(voice) && Boolean(about) && !aboutIsPlaceholder;
const noticeKey = voice === "translation" ? "translationNotice" : "draftNotice";

/*
  His blank lines are the paragraph breaks. Short paragraphs get the statement
  register, long ones get body; the threshold is a word count, not a guess about
  which sentence is more important.
*/
const paragraphs = (about ?? "")
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const isShort = (p: string) => p.split(/\s+/).length <= 18;

/*
  THE PEOPLE. His own text names them (2026-08-04), so the page ends on a
  partnership: the two creators, the shop they work with, and the portrait.
*/
const portrait = settings.designerPortrait;
const creators = settings.creators ?? [];
const partnerName = settings.partnerName?.trim() || null;
const partnerUrl = settings.partnerUrl?.trim() || null;
---

<Base shopChrome={false}
  locale={locale}
  title={t(locale, "about")}
  description={openingLine ?? undefined}
  image={openingMedia ? imageUrl(openingMedia.poster, 1200) : null}
>
  {/*
    THE ARRIVAL: one photograph, one line. The line is a whole sentence of his,
    unaltered, and it is deliberately the shortest one he wrote.
  */}
  {
    openingMedia ? (
      <MediaSurface media={openingMedia} locale={locale} priority>
        <h1 class="type-display text-display">{openingLine ?? t(locale, "about")}</h1>
      </MediaSurface>
    ) : (
      <TextSurface class="flex min-h-svh flex-col justify-center">
        <h1 class="type-display text-display">{t(locale, "about")}</h1>
        <p class="placeholder-mark self-start">{"{ABOUT_OPENING_PHOTOGRAPH}"}</p>
      </TextSurface>
    )
  }

  {/*
    The mark, once, at the top of the story rather than beside every paragraph.
    Repeating it down the page would turn a single honest caveat into noise.
  */}
  {
    marked && (
      <TextSurface class="pt-u8">
        <p class="placeholder-mark self-start">{t(locale, noticeKey)}</p>
      </TextSurface>
    )
  }

  {!about && (
    <TextSurface class="py-u13">
      <p class="placeholder-mark self-start">{"{ABOUT}"}</p>
    </TextSurface>
  )}

  {
    about && aboutIsPlaceholder && (
      <TextSurface class="py-u13">
        <p class="placeholder-mark self-start">{about}</p>
      </TextSurface>
    )
  }

  {/*
    THE DESCENT. A paragraph, then a photograph, then the next paragraph. If
    there are more paragraphs than frames, or the other way round, the leftovers
    simply continue: the page degrades to plain prose, or to a sequence of
    photographs, without a rewrite.
  */}
  {/*
    HIS WHOLE STORY IN ONE COLUMN, BESIDE ONE PHOTOGRAPH (2026-08-13, section
    107), which is what both references do and what this page did not.

    It gave each paragraph its own paired surface: four screens to carry a
    hundred and twenty words, one 30-word paragraph floating beside a
    photograph at a time. Rick Owens sets an entire show note — eight or ten
    paragraphs — in a single narrow column with the photography beside and below
    it; Vivienne Westwood's heritage pages stack five or six paragraphs against
    one image. Neither ever gives a paragraph a screen.

    So the passage is one column now, in his order, unbroken, which is also what
    section 22 asks of this page: it is the one place his text appears COMPLETE.
    The frames that were carrying a paragraph each are freed and run below as a
    mosaic, which is where the density the owner is asking for actually comes
    from — more photographs visible at once, not more space between them.
  */}
  {about && !aboutIsPlaceholder && (
    <PairedSurface media={photographs[0] ?? null} locale={locale} side="left">
      <div class="flex flex-col gap-u5">
        {paragraphs.map((paragraph) => (
          <p
            class:list={[
              isShort(paragraph) ? "type-display text-display" : "type-body text-body",
              "whitespace-pre-line",
              marked && "draft-text",
            ]}
          >
            {paragraph}
          </p>
        ))}
      </div>
    </PairedSurface>
  )}

  {/*
    THE REST OF THE PHOTOGRAPHY, AS A MOSAIC (section 107). Two across at
    desktop, alternating tall and short on a phone, the same arrangement
    /process uses — so the page ends in pictures rather than in a column of
    single frames each sealing its own screen.
  */}
  <div class="grid grid-cols-1 md:grid-cols-2">
    {photographs.slice(1).map((media, index) => (
      <MediaSurface
        media={media}
        locale={locale}
        height={index % 2 === 0 ? "tall" : "short"}
        desktopHeight="tall"
        sizes="(min-width: 48rem) 50vw, 100vw"
      />
    ))}
  </div>

  {/*
    THE TWO CREATORS (2026-08-04). {DESIGNER_BIOGRAPHY} is answered: his own
    approved text names Ferdinando Palmieri and Ciro Cecco, so the page is
    built around a PARTNERSHIP rather than around one portrait.

    Nothing here is invented, and nothing needed to be. His origin passage is
    the last paragraph of the story above; this block only sets the two names
    out as facts, in the label register, and links Ferdressed, because an
    established shop vouching for a young label is the strongest trust signal
    an international buyer gets, and it is a FACT rather than a claim.

    THE PORTRAIT IS STILL LAST. The page arrives at them.
  */}
  {(creators.length > 0 || partnerName) && (
    <TextSurface class="hairline-h flex flex-col gap-u5 py-u13">
      <h2 class="type-label text-label">{t(locale, "creators")}</h2>
      <ul class="type-display text-display flex flex-col gap-u1">
        {creators.map((person) => <li>{person}</li>)}
      </ul>
      {partnerName && (
        <p class="type-label text-label">
          {t(locale, "inCollaborationWith")}{" "}
          {partnerUrl ? (
            <a href={partnerUrl} rel="noopener" target="_blank" class="hairline-under">
              {partnerName}
            </a>
          ) : (
            partnerName
          )}
        </p>
      )}
    </TextSurface>
  )}

  {portrait && <MediaSurface media={portrait} locale={locale} height="tall" />}
</Base>
