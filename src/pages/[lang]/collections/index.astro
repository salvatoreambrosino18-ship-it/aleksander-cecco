---
/*
  The collections index. Step 5 of the build order.

  One full-bleed media screen per collection, with its name and season as a
  label. Scrolling the index is scrolling through the collections themselves.
  Not a grid, not chips, not cards (DESIGN-PLAN sections 4 and 5).
*/
import Base from "../../../layouts/Base.astro";
import MediaSurface from "../../../components/MediaSurface.astro";
import TextSurface from "../../../components/TextSurface.astro";
import {getCollections, getGarments} from "../../../lib/content";
import {announcementLine, describingLines} from "../../../lib/statement";
import {LOCALES, localePath, pick, toLocale} from "../../../lib/locales";
import {imageUrl} from "../../../lib/image";
import {t} from "../../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);

// A collection without a cover has nothing to show on a media-led index, and
// the schema requires one, so this only guards against a half-filled document.
const [collectionsAll, garments] = await Promise.all([getCollections(), getGarments()]);
const collections = collectionsAll.filter((collection) => collection.cover);
const first = collections[0]?.cover;

/* Pieces per drop: the count is the fact that says a drop is real. */
const countBySlug = new Map<string, number>();
for (const g of garments) {
  const slug = g.collection?.slug;
  if (slug) countBySlug.set(slug, (countBySlug.get(slug) ?? 0) + 1);
}
---

{/*
  INK, amended 2026-08-10 (section 78). The approved assignment in s77 put this
  page on paper with the shop, and walking the site showed that was wrong by
  s77's OWN rule: the drops index inverted into a drop's page on a tap, which is
  the exact fault the catalogue move had just fixed on the other side.

  Asked properly — which of the two things is this page? — a drops index is a
  TABLE OF CONTENTS FOR THE WORLD. Its cards carry his announcement and lead
  into a chapter; nobody buys here. The piece count is the only shop-shaped fact
  on it, and a count is a fact about a chapter as much as about a shelf.

  So: index (ink) -> a drop (ink), and the boundary stays where the wipe is.
*/}
<Base
  locale={locale}
  title={t(locale, "collections")}
  image={first ? imageUrl(first.poster, 1200) : null}
  theme="dark"
  footerTheme="dark"
>
  <TextSurface theme="dark" arrive class="flex flex-col gap-u2 pt-chrome pb-u5">
    {/*
      No intro line (2026-08-04): every fetched reference keeps category pages
      free of editorial, and the drop card below opens with HIS statement,
      which says more than any line of ours explained.
    */}
    <h1 class="type-display text-display">{t(locale, "collections")}</h1>
  </TextSurface>

  {/*
    A DROP IS AN EVENT, and its card reads like one (2026-08-04): the cover,
    then his own words, the piece count as a hard fact, and the way in. One
    photograph with a name on it read as a broken page, not a quiet one. The
    words are HIS approved text, which is better than any intro we could write.

    HIS ANNOUNCEMENT, AND ONLY THAT (2026-08-10). The line above already said
    where the announcement sentence naturally lives — "the drop page announces
    the drop" — but the card was printing the statement WHOLE, so all three of
    his lines appeared here, on /new, and on the drop's own page, and two of
    them appeared on the home page as well. A card in a list of drops wants the
    sentence that declares the drop and nothing else; that is what makes it a
    card rather than a second copy of the page it links to. The whole statement
    stays where it is read rather than scanned.
  */}
  {
    collections.map((collection, index) => {
      const statement =
        announcementLine(pick(collection.statement, locale)) ??
        describingLines(pick(collection.statement, locale))[0];
      const count = countBySlug.get(collection.slug) ?? 0;
      const href = localePath(locale, `collections/${collection.slug}`);
      return (
        <>
          <MediaSurface media={collection.cover!} locale={locale} height="tall" priority={index === 0}>
            <a href={href} class="flex flex-col gap-u1">
              <h2 class="type-label text-label">{collection.name}</h2>
              {/*
                The season, which this card never carried (2026-08-10). Trading
                his three statement lines for one announcement made the card
                scannable and made the page thin, and a list of drops wants FACTS
                to tell its entries apart rather than more prose: the name, when
                it was, how many pieces. Two of those three were already here.
                Home's chapter covers have set name-over-season since s21; this
                is the same pair on the page whose whole job is comparing drops.
              */}
              {collection.season && <span class="type-mono text-mono">{collection.season}</span>}
            </a>
          </MediaSurface>
          <TextSurface theme="dark" class="flex flex-col gap-u5 py-u13">
            {statement && (
              <p class="type-display text-display max-w-prose whitespace-pre-line">{statement}</p>
            )}
            <p class="type-mono text-mono">{count} {t(locale, "countCreatures")}</p>
            <a href={href} class="type-label text-label hairline-under self-start">
              {t(locale, "enterDrop")}
            </a>
          </TextSurface>
        </>
      );
    })
  }

  {
    collections.length === 0 && (
      <TextSurface theme="dark" class="flex min-h-svh flex-col justify-center">
        <p class="placeholder-mark">{"{NO_COLLECTIONS_PUBLISHED}"}</p>
      </TextSurface>
    )
  }
</Base>
