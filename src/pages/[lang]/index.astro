---
/*
  Home, rebuilt 2026-08-02 as a narrative sequence (DESIGN-PLAN section 21).

  WHAT WAS WRONG. The page was a stack of closed compositions: signature, then a
  screen-filling photograph, then tiles, then the wipe, then more screen-filling
  photographs. Every block sealed itself at exactly one viewport, so each one
  read as an ending and nothing pulled the reader into the next. It looked like
  a set of postcards rather than a site with a direction.

  THE SEQUENCE NOW, and each movement earns its place:

    1. ARRIVAL   one photograph, the whole screen. The signature is no longer
                 the opening gesture; it is persistent corner chrome, drawn by
                 SiteHeader on every page, so the brand is still named without
                 spending the first screen on it. This settles the question
                 deferred in DESIGN-PLAN section 14 in favour of image first.
    2. THE WORK  who the brand is, in three lines, on a text surface.
    3. WORN      the pieces on people, scrolled sideways. The one horizontal
                 region on the site (see WornBand.astro).
    4. MAKING    the work behind the pieces, and the one route to asking for
                 one. Section 2 makes a claim; this is where it is shown.
    [ THE WIPE ] the boundary wash. INK above it, paper below, footer included.
                 Nigredo then Albedo: see the note at the wash itself.
    5. COLLECTIONS as chapters, on paper.

  HOW THE PULL IS BUILT, since that was the actual complaint. Only the arrival
  is a sealed screen, because an arrival should be. Everything after it is
  height="tall" (88svh), so the next frame is always already peeking above the
  fold, and the text surfaces are sized to their content rather than to the
  viewport. The reader is never shown a boundary that looks like the end.

  The blocks stay flat siblings, as they were, so reordering the page is a move
  rather than a rewrite. The STORY SLOT comment is gone: the question it was
  holding open has been answered.
*/
import Base from "../../layouts/Base.astro";
import TextSurface from "../../components/TextSurface.astro";
import MediaSurface from "../../components/MediaSurface.astro";
import Statement from "../../components/Statement.astro";
import WornBand from "../../components/WornBand.astro";
import BoundaryWash from "../../components/BoundaryWash.astro";
import {getCollections, getGarments, getSiteSettings} from "../../lib/content";
import {LOCALES, localePath, pick, toLocale} from "../../lib/locales";
import {overlayTheme} from "../../lib/media";
import {voiceState} from "../../lib/voice";
import {imageUrl} from "../../lib/image";
import {t} from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const [collections, settings, creature] = await Promise.all([
  getCollections(),
  getSiteSettings(),
  getGarments(),
]);

const opening = settings.openingMedia;
const instagramFrames = settings.instagramFrames ?? [];
const instagramUrl = settings.instagramUrl?.trim() || null;
const instagramHandle = instagramUrl
  ? `@${instagramUrl.replace(/\/+$/, "").split("/").pop()}`
  : null;

/*
  WHAT THE ARRIVAL SAYS. His title, his sentence, and one line of ours.

  `dropLine` is the FIRST line of his own collection statement, unaltered and in
  his order, so the opening screen speaks in his voice rather than in ours. The
  price line is ours and is flagged as `homeLines` in site settings: it names the
  lowest real price in the catalogue rather than a claim, so it cannot drift out
  of date while the prices are right.
*/
const [drop] = collections;
void drop;
const dropStatement = pick(drop?.statement ?? null, locale);
/*
  His first TWO lines, which is the Sorcinelli register measured in section 14:
  two short lines over a full-bleed frame. The first names the drop, so no
  separate label sits above them; printing the collection name and then his
  sentence that opens "We present MONUMENTUS" said it twice.
*/
const dropLine =
  dropStatement
    ?.split(/\n/)
    .map((l) => l.trim())
    .filter(Boolean)
    .slice(0, 2)
    .join("\n") ?? null;

const prices = creature.map((c) => c.price).filter((p): p is number => typeof p === "number");
const priceFrom = prices.length
  ? `${t(locale, "priceFrom")} ${new Intl.NumberFormat(locale === "it" ? "it-IT" : "en-GB", {
      style: "currency",
      currency: "EUR",
      maximumFractionDigits: 0,
    }).format(Math.min(...prices))}  /  ${t(locale, "madeToMeasure")}`
  : null;
const worn = settings.homeSequence ?? [];
const makingMedia = settings.makingMedia ?? [];
const homeStatement = pick(settings.homeStatement, locale);
const makingStatement = pick(settings.makingStatement, locale);
// Both blocks are the owner's own words now, so the only question left is
// whether this language is one he approved. See lib/voice.ts.
const voice = voiceState(settings, locale);

const shareImage = opening ?? collections.find((c) => c.cover)?.cover ?? null;
---

{/* chrome: the first screen is a photograph now, so the fixed signature and
    MENU take that photograph's overlay polarity on first paint. */}
<Base
  locale={locale}
  image={shareImage ? imageUrl(shareImage.poster, 1200) : null}
  chrome={overlayTheme(opening?.overlay)}
  theme="dark"
  footerTheme="light"
>
  {/*
    1. ARRIVAL. The one sealed screen on the page, and the only priority image:
    it is the largest thing the site downloads and the first thing seen.
  */}
  {
    opening ? (
      <>
        <h1 class="sr-only">Aleksander Cecco</h1>
        {/*
          WORDS ON THE ARRIVAL (2026-08-03). The page used to open on a
          photograph carrying nothing at all, which read as a screensaver: a
          visitor arriving from Instagram could not tell what this was, what it
          cost, or how to get one, and had to scroll to find out. Every reference
          puts words on its opening image, and the sparse ones are still never
          silent.

          Four lines and no more. The collection is HIS title, the line under it
          is HIS sentence from the collection statement, and only the third is
          ours: the price the work starts at and the fact that everything is made
          to measure, which are the two questions a first-time visitor actually
          has. Then one route in.
        */}
        <MediaSurface media={opening} locale={locale} priority>
          <div class="flex flex-col gap-u2">
            {dropLine && (
              <p class="type-statement text-statement max-w-prose whitespace-pre-line">
                {dropLine}
              </p>
            )}
            {priceFrom && <p class="type-mono text-mono">{priceFrom}</p>}
            <a
              href={localePath(locale, "creature")}
              class="type-label text-label hairline-under self-start"
            >
              {t(locale, "allCreatures")}
            </a>
          </div>
        </MediaSurface>
      </>
    ) : (
      <TextSurface class="flex min-h-svh flex-col justify-center">
        <h1 class="type-label text-label">Aleksander Cecco</h1>
        <p class="placeholder-mark self-start">{"{OPENING_PHOTOGRAPH}"}</p>
      </TextSurface>
    )
  }

  {/*
    2. THE WORK. The owner's own opening two sentences. Body register, not the
    statement register: he writes long discursive prose, and uppercasing it at
    statement size turns a manifesto into shouting (DESIGN-PLAN section 22).
  */}
  <Statement
    text={homeStatement}
    locale={locale}
    heading={t(locale, "theWork")}
    token={"{HOME_STATEMENT}"}
    voice={voice}
    register="body"
  >
    <a
      href={localePath(locale, "about")}
      class="type-label text-label self-start hover:underline underline-offset-8"
    >
      {t(locale, "about")}
    </a>
  </Statement>

  {/* 3. WORN. The pieces on people, sideways. */}
  <WornBand tiles={worn} locale={locale} label={t(locale, "worn")} />

  {/*
    4. THE MAKING. Section 2 claims the work is a transformation; this is the
    evidence for it, and it is the only place the home page says how a piece is
    actually got. The frames are "tall", so the wash below is already showing.
  */}
  <Statement
    text={makingStatement}
    locale={locale}
    heading={t(locale, "theMaking")}
    token={"{MAKING_STATEMENT}"}
    voice={voice}
    register="body"
    class="pt-u13 pb-u8"
  >
    <p class="type-mono text-mono">{t(locale, "madeToMeasureValue")}</p>
    {/*
      Two routes out, not one. The index is the shortest path to any Creature:
      one tap to the index and one more to a piece, which is the two-tap depth
      the old Shopify site had and this one had lost.
    */}
    <a
      href={localePath(locale, "creature")}
      class="type-label text-label self-start hover:underline underline-offset-8"
    >
      {t(locale, "allCreatures")}
    </a>
    <a
      href={localePath(locale, "collections")}
      class="type-label text-label self-start hover:underline underline-offset-8"
    >
      {t(locale, "collections")}
    </a>
  </Statement>

  {makingMedia.map((media) => <MediaSurface media={media} locale={locale} height="tall" />)}

  {/*
    THE BOUNDARY, reversed 2026-08-02. The page has been INK since the arrival;
    from here it is paper.

    It used to run the other way, and the direction is no longer arbitrary. The
    collection is MONUMENTUS: Tenebrae & Lux, and the owner's text names the two
    alchemical stages in order: Nigredo, the blackening, then Albedo, the
    whitening. Darkness, then light. A wipe that travelled from white into black
    ran the sequence backwards.

    Nothing is added and nothing says so. Two props changed. If a reader feels
    it, good; if not, the page is still a page that inverts once, which is what
    it was before (DESIGN-PLAN section 22).
  */}
  {/*
    INSTAGRAM, AND THE LIST. Both sit here, before the wipe, because this is
    where a reader who has come down the whole page is deciding whether to keep
    the brand or leave it.

    THE FEED IS NOT A FEED (DESIGN-PLAN section 62): four frames he chooses in
    the studio, linking to his profile. A live one needs a token that expires
    every sixty days and empties the section silently; every embed is a
    third-party script, which rules 4 and 13 forbid.

    THE LIST IS THE BIGGEST GAP nobody had named: his model is drops, two pieces,
    released and gone, and with no list every drop reaches only whoever opens
    Instagram that day. The form is here and COLLECTS NOTHING: it posts to the
    same Function, which answers that sign-up is not open. It sits behind the
    same legal gate as the enquiry, and that gate has not moved.
  */}
  {
    instagramFrames.length > 0 && (
      <section class="relative">
        <TextSurface class="flex flex-col gap-u2 pt-u13 pb-u5">
          <h2 class="type-label text-label">{t(locale, "instagram")}</h2>
          {instagramUrl && (
            <a
              href={instagramUrl}
              rel="me noopener"
              target="_blank"
              class="type-mono text-mono self-start hover:underline underline-offset-4"
            >
              {instagramHandle}
            </a>
          )}
        </TextSurface>

        <ul class="grid grid-cols-2 md:grid-cols-4">
          {instagramFrames.map((media) => (
            <li>
              <a href={instagramUrl ?? "#"} rel="me noopener" target="_blank" class="block">
                <MediaSurface media={media} locale={locale} height="short" desktopHeight="short" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <TextSurface class="flex flex-col gap-u5 py-u13">
    <h2 class="type-label text-label">{t(locale, "newsletter")}</h2>
    <p class="type-body text-body max-w-prose">{t(locale, "newsletterLine")}</p>
    <form method="POST" action="/api/enquiry" class="flex max-w-prose flex-col gap-u3">
      <div class="field">
        <label class="type-label text-label" for="list-email">Email</label>
        <input id="list-email" name="email" type="email" required maxlength="254" autocomplete="email" />
      </div>
      {/* Hidden from people, not from bots, exactly as on the enquiry form. */}
      <div class="spam-trap" aria-hidden="true">
        <label for="list-website">Website</label>
        <input id="list-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="intent" value="newsletter" />
      <input type="hidden" name="lang" value={locale} />
      <button type="submit" class="type-label text-label hairline-under self-start">
        {t(locale, "newsletterAction")}
      </button>
    </form>
  </TextSurface>

  <BoundaryWash
    from="dark"
    to="light"
    label={collections[0]?.name ?? null}
    sublabel={collections[0]?.season ?? null}
  />

  {/* 5. THE COLLECTIONS, now on paper. */}
  {
    collections.map((collection) => {
      const statement = pick(collection.statement, locale);
      const href = localePath(locale, `collections/${collection.slug}`);
      return (
        <>
          {collection.cover && (
            /*
              "tall", not "screen": a chapter cover that seals itself at exactly
              one viewport is the postcard problem. Leaving the next block
              peeking is what keeps the reader descending.
            */
            <MediaSurface media={collection.cover} locale={locale} height="tall">
              <a href={href} class="flex flex-col gap-u1">
                <h2 class="type-label text-label">{collection.name}</h2>
                {collection.season && <span class="type-mono text-mono">{collection.season}</span>}
              </a>
            </MediaSurface>
          )}

          {statement && (
            <TextSurface theme="light" class="flex flex-col gap-u5 py-u13">
              <p class="type-statement text-statement max-w-prose">{statement}</p>
              <a href={href} class="type-label text-label self-start hover:underline underline-offset-8">
                {collection.name}
              </a>
            </TextSurface>
          )}
        </>
      );
    })
  }
</Base>
