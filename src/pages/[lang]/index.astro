---
/*
  Home. Step 4 of the build order.

  The sequence, and it is deliberately a flat list of sibling blocks:

    1. OPENING     the signature at hero width, in emptiness, nothing else
    2. per collection:
       2a. COVER   the collection cover as a full-bleed chapter
       2b. VOICE   its statement on a text surface

  The blocks are siblings on purpose. The owner sent Isaac Sellam as a model,
  where the order is photograph, then story, then pieces, and our opening is the
  signature rather than a photograph (DESIGN-PLAN section 14, "The home sequence
  question"). That is an open decision. Should it go the Sellam way, the change
  is: move block 1 below the first cover, and drop a STORY text surface in at
  the marked slot. No component changes, no data changes, no rewrite.
*/
import Base from "../../layouts/Base.astro";
import TextSurface from "../../components/TextSurface.astro";
import MediaSurface from "../../components/MediaSurface.astro";
import Signature from "../../components/Signature.astro";
import {getCollections} from "../../lib/content";
import {LOCALES, localePath, pick, toLocale} from "../../lib/locales";
import {imageUrl} from "../../lib/image";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const collections = await getCollections();
const shareImage = collections.find((c) => c.cover)?.cover ?? null;
---

<Base locale={locale} image={shareImage ? imageUrl(shareImage.poster, 1200) : null}>
  {/* 1. OPENING. The one thing on the site allowed to be large. */}
  <TextSurface framed={false} class="flex min-h-svh flex-col justify-center">
    <h1 class="w-sig-hero self-center">
      <Signature />
    </h1>
  </TextSurface>

  {/*
    STORY SLOT. If the home sequence becomes image, story, pieces, the story
    text surface goes here, reading siteSettings.about. Nothing else moves
    except block 1, which drops below the first cover.
  */}

  {
    collections.map((collection, index) => {
      const statement = pick(collection.statement, locale);
      const href = localePath(locale, `collections/${collection.slug}`);
      return (
        <>
          {/* 2a. COVER */}
          {collection.cover && (
            <MediaSurface media={collection.cover} locale={locale} priority={index === 0}>
              <a href={href} class="flex flex-col gap-u1">
                <h2 class="type-label text-label">{collection.name}</h2>
                {collection.season && <span class="type-mono text-mono">{collection.season}</span>}
              </a>
            </MediaSurface>
          )}

          {/* 2b. VOICE */}
          {statement && (
            <TextSurface class="flex flex-col gap-u5 py-u13">
              <p class="type-statement text-statement max-w-prose">{statement}</p>
              <a href={href} class="type-label text-label self-start hover:underline underline-offset-8">
                {collection.name}
              </a>
            </TextSurface>
          )}
        </>
      );
    })
  }
</Base>
