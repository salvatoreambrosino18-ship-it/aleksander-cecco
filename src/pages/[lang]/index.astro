---
/*
  Home, rebuilt 2026-08-02 as a narrative sequence (DESIGN-PLAN section 21).

  WHAT WAS WRONG. The page was a stack of closed compositions: signature, then a
  screen-filling photograph, then tiles, then the wipe, then more screen-filling
  photographs. Every block sealed itself at exactly one viewport, so each one
  read as an ending and nothing pulled the reader into the next. It looked like
  a set of postcards rather than a site with a direction.

  THE SEQUENCE NOW, and each movement earns its place:

    1. ARRIVAL   one photograph, the whole screen. The signature is no longer
                 the opening gesture; it is persistent corner chrome, drawn by
                 SiteHeader on every page, so the brand is still named without
                 spending the first screen on it. This settles the question
                 deferred in DESIGN-PLAN section 14 in favour of image first.
    2. THE WORK  who the brand is, in three lines, on a text surface.
    3. WORN      the pieces on people, scrolled sideways. The one horizontal
                 region on the site (see WornBand.astro).
    4. MAKING    the work behind the pieces, and the one route to asking for
                 one. Section 2 makes a claim; this is where it is shown.
    [ THE WASH ] the held screen where the reader WRITES the brand's name with
                 their own scroll (section 82). It used to invert the page here;
                 every page is paper now, so the mark is the whole event and
                 this is still the page's one structural moment.
    5. COLLECTIONS as chapters.

  HOW THE PULL IS BUILT, since that was the actual complaint. Only the arrival
  is a sealed screen, because an arrival should be. Everything after it is
  height="tall" (88svh), so the next frame is always already peeking above the
  fold, and the text surfaces are sized to their content rather than to the
  viewport. The reader is never shown a boundary that looks like the end.

  The blocks stay flat siblings, as they were, so reordering the page is a move
  rather than a rewrite. The STORY SLOT comment is gone: the question it was
  holding open has been answered.
*/
import Base from "../../layouts/Base.astro";
import TextSurface from "../../components/TextSurface.astro";
import MediaSurface from "../../components/MediaSurface.astro";
import WornBand from "../../components/WornBand.astro";
import TwoUp from "../../components/TwoUp.astro";
import BoundaryWash from "../../components/BoundaryWash.astro";
import InstagramMark from "../../components/InstagramMark.astro";
import PairedSurface from "../../components/PairedSurface.astro";
import Statement from "../../components/Statement.astro";
import Signature from "../../components/Signature.astro";
import Spine from "../../components/Spine.astro";
import {byStage, getCollections, getGarmentsInCollection, getSiteSettings} from "../../lib/content";
import {unspentLine} from "../../lib/statement";
import {LOCALES, localePath, pick, toLocale} from "../../lib/locales";
import {overlayTheme} from "../../lib/media";
import {voiceState} from "../../lib/voice";
import {imageUrl} from "../../lib/image";
import {t} from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const [collections, settings] = await Promise.all([getCollections(), getSiteSettings()]);

/*
  THE TWO-UP PAIR (2026-08-12, section 114). Two Creature from the current drop,
  side by side at full height, which is the composition Rick Owens' home page
  uses four times in fifty screenshots and this page had never had.

  THE FIRST TWO OF THE DROP, in his own drag order, and that is not laziness: it
  is the only choice available that is HIS. Picking two frames because they
  happen to share a ground would be us curating his photography, and the pair
  that arrives first in his order is the pair he put first.

  It renders only when both frames exist, so a drop of one degrades to nothing
  rather than to a half-empty screen.
*/
const dropSlug = collections[0]?.slug ?? null;
const dropPieces = dropSlug ? await getGarmentsInCollection(dropSlug) : [];
const twoUp = byStage(dropPieces)
  .filter((g) => g.media?.[0] && g.name)
  .slice(0, 2)
  .map((g) => ({
    media: g.media![0],
    label: g.name!,
    href: localePath(locale, `creature/${g.slug}`),
  }));

const opening = settings.openingMedia;
const instagramFrames = settings.instagramFrames ?? [];
const instagramUrl = settings.instagramUrl?.trim() || null;
const instagramHandle = instagramUrl
  ? `@${instagramUrl.replace(/\/+$/, "").split("/").pop()}`
  : null;

/*
  THE ARRIVAL SPEAKS HIS OWN LINES NOW (2026-08-12, section 99), from
  `openingLines`, written for this screen. What stood here was assembled: the
  drop's name as a label, the first describing line of its statement, and a
  price line of OURS. All three are gone — with them goes the reason this page
  needed the drop at all before its chapters block.

  `spentLines` survives because the chapters block still asks lib/statement for
  a line this page has not already used; it simply starts empty now.
*/
const spentLines: string[] = [];

const worn = settings.homeSequence ?? [];
const makingMedia = settings.makingMedia ?? [];
const homeStatement = pick(settings.homeStatement, locale);
const openingLines = pick(settings.openingLines, locale);
const philosophy = (settings.philosophy ?? []).filter((r) => pick(r.text, locale));
/*
  ONE LINE, because /process is the page this passage is FOR (2026-08-10).
  `makingStatement` is three lines, and /process printed all three while this
  block printed all three too — and it is also paragraph three of `about`
  verbatim, so home → process → about served the same sentences three times.
  Home makes the claim and points at the evidence; the evidence page keeps the
  whole passage.
*/
// Both blocks are the owner's own words now, so the only question left is
// whether this language is one he approved. See lib/voice.ts.
const voice = voiceState(settings, locale);

const shareImage = opening ?? collections.find((c) => c.cover)?.cover ?? null;
---

{/*
  NO INVERSION ON THIS PAGE, OR ANY PAGE (2026-08-11, section 82).

  What stood here was the argument for which half of this page was ink and
  which was paper, settled by counting outbound links (6 agreed and 2 inverted
  one way round, against 2 and 6 the other). The owner has since decided every
  page is paper, so there is no half to assign and no direction of travel to
  get backwards. The history is in sections 77 to 82; what is left on this page
  is the wash, and what happens there is his signature being written.
*/}

{/*
  THE ARRIVAL BEGINS AT PIXEL ZERO AGAIN (2026-08-12, section 115). `opening` is
  this page's first block and the chrome floats on it, in the polarity the owner
  measured for that exact frame. With no opening photograph the page falls
  through to a text surface and passes nothing, so the band comes back — which
  is correct, because there would be nothing for a mark to float on.
*/}
<Base
  locale={locale}
  chromeOver={opening?.overlay ?? null}
  image={shareImage ? imageUrl(shareImage.poster, 1200) : null}
>
  {/*
    1. ARRIVAL. The one sealed screen on the page, and the only priority image:
    it is the largest thing the site downloads and the first thing seen.
  */}
  {
    opening ? (
      <>
        <h1 class="sr-only">Aleksander Cecco</h1>
        {/*
          WORDS ON THE ARRIVAL (2026-08-03). The page used to open on a
          photograph carrying nothing at all, which read as a screensaver: a
          visitor arriving from Instagram could not tell what this was, what it
          cost, or how to get one, and had to scroll to find out. Every reference
          puts words on its opening image, and the sparse ones are still never
          silent.

          Four lines and no more. The collection is HIS title, the line under it
          is HIS sentence from the collection statement, and only the third is
          ours: the price the work starts at and the fact that everything is made
          to measure, which are the two questions a first-time visitor actually
          has. Then one route in.

          THE WORDS CAME OFF THE PHOTOGRAPH (2026-08-11, section 89). Measured,
          the caption band of the arrival is 1.5:1 WORST CASE — no text colour
          survives it, which is what `captionPlacement: below` exists for
          (section 58). So the four lines now sit on paper directly under the
          picture, at 19.6:1, and they are the same four lines in the same order.

          AND THE FRAME IS "tall", NOT "screen", which is the other half of that
          fix and is not cosmetic. Below a full-height photograph the block would
          begin exactly at the fold and a first-time visitor would meet a silent
          screen — the screensaver this section was written to end. At 88svh the
          drop's name and the start of his sentence are ON the first screen,
          legible, and the peek is the same device every other sequence on this
          site uses to pull a reader down.

          What this cannot fix is the photograph: a frame with a quiet band at
          the bottom would let the words go back on the picture. That is his to
          shoot, and it is on the open list.
        */}
        {/*
          THE ARRIVAL IS A LOOP NOW (2026-08-12, section 117), and it is the
          only loop on the site.

          Section 116 made `film` the default because no clip in the folder
          returned to where it began. `scripts/find-loop.mjs` then searched
          every clip for its steadiest WINDOW rather than judging it whole, and
          one came back usable: `IMG_0263` between 2.50s and 4.00s, a hand
          pulling a jacket off its hook against the concrete wall. **Seam 5.2 of
          255, border drift 3.2** — the two end frames put side by side are all
          but identical.

          IT GOES HERE BECAUSE THIS IS THE POSITION THAT CANNOT HAVE CONTROLS.
          An arrival with a play button is not an arrival. Everywhere else a
          clip can be a film, so everywhere else a clip IS one, and nothing
          judders in a corner of the site to satisfy a rule.

          The poster is the loop's own first frame, so the still and the motion
          agree exactly and there is no jump when it starts.
        */}
        <div class="relative">
          <MediaSurface media={opening} locale={locale} priority height="tall" videoMode="loop">
            <div class="flex flex-col gap-u2">
              {/*
                HIS THREE LINES, VERBATIM (2026-08-12, section 99), replacing
                the drop's name, a borrowed line from its statement, and our
                invented price line. He wrote these FOR this screen; everything
                they replaced was assembled for it by us.
              */}
              {openingLines && (
                <p class="type-display text-display max-w-prose">{openingLines}</p>
              )}
              <a
                href={localePath(locale, "creature")}
                class="type-label text-label hairline-under self-start"
              >
                {t(locale, "allCreatures")}
              </a>
            </div>
          </MediaSurface>
        </div>

        {/*
          THE HAND SIGNS ON PAPER (2026-08-12, section 96).

          The ceremony used to happen ON the arrival photograph, and it was the
          last defect on the site: measured 1.49:1 and 1.69:1, four faults, on
          the first screen. Tuning it to this photograph was refused — a
          ceremony tuned to one picture breaks the day the picture changes — so
          it moved to ground no photograph can reach.

          It writes itself at hero scale on the paper directly under the
          picture, where his four lines already sit since section 89. Ink on
          paper is 19.6:1 tonight, on his next photograph, and on every
          photograph after that. Nothing is measured, nothing can drift, and the
          gesture is unchanged: same pen, same stroke order, same once a visit.

          It reads BETTER here than it did over the picture, which is the part
          worth saying: a signature belongs at the foot of a thing, not across
          it, and there was never a photograph in this dataset it did not fight.
        */}
        <div class="frame relative pt-u5 pb-u3" aria-hidden="true">
          <Spine />
          {/*
            FULL WIDTH OF THE MEASURE, not 92vw. `--sig-hero-w` is sized for a
            FULL-BLEED context — 92vw on a phone, with the 4vw either side doing
            the work of a margin. Inside a framed block the page margin is
            already there, so the two insets add up and the mark hangs 17px off
            the right edge of a 390px screen, which the audit caught as an
            overflow the moment it moved here.
          */}
          <Signature draw decorative class="w-full" />
        </div>
        <script is:inline>
          (() => {
            try {
              if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
              if (sessionStorage.getItem("ac-sig-drawn")) return;
              sessionStorage.setItem("ac-sig-drawn", "1");
              document.documentElement.setAttribute("data-sig-live", "");
            } catch {}
          })();
        </script>
      </>
    ) : (
      <TextSurface class="flex min-h-svh flex-col justify-center">
        <h1 class="type-label text-label">Aleksander Cecco</h1>
        <p class="placeholder-mark self-start">{"{OPENING_PHOTOGRAPH}"}</p>
      </TextSurface>
    )
  }

  {/*
    2. THE WORK. The owner's own opening two sentences. Body register, not the
    statement register: he writes long discursive prose, and uppercasing it at
    statement size turns a manifesto into shouting (DESIGN-PLAN section 22).
  */}
  {/*
    COMPOSED WITH A PHOTOGRAPH (2026-08-11, section 82). This was a screen of
    text between two screens of photography, which at 1440 meant a 640px column
    with the rest of the width empty. It now shares a screen with the first
    making frame, so the passage is never alone and its measure comes from the
    half it sits in rather than from a cap.
  */}
  {/*
    THROUGH `Statement`, NOT BY HAND (2026-08-11, section 84). This page printed
    his words in a raw <p> and computed `voice` without ever using it — so the
    home page was the one place his brand copy appeared outside the system that
    decides whether words are his, our translation, or our draft. It cost
    nothing today, because every language is approved; it would have cost the
    home page its notice the moment one was not, which is precisely when it
    matters. Same register, same markup, one fewer thing to remember.
  */}
  {/*
    THE SPLIT, SECOND SCREEN (2026-08-12, section 114), which is exactly where
    the reference puts it: full-bleed atmosphere, then two pictures arguing.

    The owner looked at two days of work and said the site looked the same. He
    was right, and this is the reason — every screen on this page was ONE thing:
    a photograph, then a passage, then a band, then a passage. A reader met one
    object at a time from top to bottom, and no amount of tightening padding
    changes what kind of page that is. This is the first screen where two
    photographs are held against each other, and it is the single most
    recognisable device on the page it comes from.
  */}
  <TwoUp locale={locale} items={twoUp} />

  <PairedSurface media={makingMedia[0] ?? null} locale={locale} side="left">
    <Statement
      text={homeStatement}
      locale={locale}
      heading={t(locale, "theProject")}
      voice={voice}
      register="body"
      bare
    >
      <a href={localePath(locale, "about")} class="type-label text-label self-start hairline-under">
        {t(locale, "about")}
      </a>
    </Statement>
  </PairedSurface>

  {/* 3. WORN. The pieces on people, sideways. */}
  {/*
    BODY OF LIGHT (2026-08-12, section 99). His name for this band, replacing
    ours. The line under it goes: he named the section and did not write a
    subtitle for it, and inventing one under his own title is exactly the thing
    every other block on this page just stopped doing.
  */}
  <WornBand tiles={worn} locale={locale} label={t(locale, "bodyOfLight")} />

  {/*
    4. THE THREE REASONS (2026-08-12, section 99), which replaced THE MAKING
    entirely at the owner's instruction: OUR SKINS, REASONS, REBORN, his words
    and his order.

    NO HEADING OVER THEM. He asked whether the block wanted one and suggested
    PHILOSOPHY. It does not: each reason already carries his own title, and a
    heading above three headings is a label on a label. The site names a section
    when the section has no voice of its own — WORN, THE PROJECT — and this one
    speaks for itself three times.

    Composed with the making frames, as the passage it replaces was, because a
    body-register passage is never alone on this site (section 82).
  */}
  {philosophy.length > 0 && (
    /*
      ONE PHOTOGRAPH, THREE REASONS, ONE COMPOSITION (2026-08-12, section 103).

      He sent ONE photograph for this block. The first attempt gave each reason
      its own paired surface, and with one frame available the same skirt
      appeared twice and the third reason stood alone on flat ground — which is
      precisely what section 82 forbids for a body-register passage.

      So the three reasons share a screen with his photograph the way a single
      passage would. They are one thought in three parts, his titles are the
      punctuation between them, and the block reads as what he called it.
    */
    <PairedSurface media={makingMedia[1] ?? makingMedia[0] ?? null} locale={locale} side="right">
      <div class="flex flex-col gap-u8">
        {philosophy.map((reason) => (
          <Statement
            text={pick(reason.text, locale)}
            locale={locale}
            heading={reason.title}
            voice={voice}
            register="body"
            bare
          />
        ))}
        <a href={localePath(locale, "creature")} class="type-label text-label self-start hairline-under">
          {t(locale, "allCreatures")}
        </a>
      </div>
    </PairedSurface>
  )}

  {/* Any making frame beyond the two composed above simply continues. */}
  {makingMedia.slice(2).map((media) => <MediaSurface media={media} locale={locale} height="tall" />)}

  {/*
    THE BOUNDARY. One held screen, and crossing it means writing the brand's
    name with your own scroll (section 82). Nigredo and Albedo are words in his
    drop statement now rather than something the page performs; that was the
    price of one polarity and he was told it before he paid it.
  */}
  {/*
    INSTAGRAM, AND THE LIST. Both sit here, before the wipe, because this is
    where a reader who has come down the whole page is deciding whether to keep
    the brand or leave it.

    THE FEED IS NOT A FEED (DESIGN-PLAN section 62): four frames he chooses in
    the studio, linking to his profile. A live one needs a token that expires
    every sixty days and empties the section silently; every embed is a
    third-party script, which rules 4 and 13 forbid.

    THE LIST IS THE BIGGEST GAP nobody had named: his model is drops, two pieces,
    released and gone, and with no list every drop reaches only whoever opens
    Instagram that day. The form is here and COLLECTS NOTHING: it posts to the
    same Function, which answers that sign-up is not open. It sits behind the
    same legal gate as the enquiry, and that gate has not moved.
  */}
  {/*
    INSTAGRAM READS AS INSTAGRAM (section 71): squares, because the square is
    the recognition signal — no logo, no feed, no token, nothing that
    expires. The handle sits above the strip in the display voice; each
    square goes to ITS OWN post when the owner has pasted the link, to the
    profile otherwise. The strip is the worn band's language: one row, a
    frame cut by the edge as the cue, and the same focusable-region contract.
    The section is complete with one frame or six, and absent with none.
  */}
  {
    instagramFrames.length > 0 && (
      <section class="relative" aria-labelledby="ig-heading">
        <TextSurface class="flex flex-col gap-u2 pt-u8 pb-u3">
          <h2 id="ig-heading" class="type-label text-label">{t(locale, "instagram")}</h2>
          {instagramUrl && (
            <a
              href={instagramUrl}
              rel="me noopener"
              target="_blank"
              class="type-display text-display self-start hairline-under flex items-center gap-u2"
            >
              <InstagramMark />
              {instagramHandle}
            </a>
          )}
        </TextSurface>

        {/*
          EACH SQUARE GOES TO ITS OWN POST, and says that it leaves the site.

          `rel="me"` belongs to the PROFILE link above and to nothing else: it
          is a claim that the destination is this brand's own identity, which is
          true of the profile and false of a post. The squares carry
          `noopener` alone.

          A frame with neither a post nor a profile is rendered UNLINKED rather
          than pointed at "#": a link that goes nowhere is worse than a
          photograph, and the studio allows both fields to be empty.
        */}
        <ul class="square-strip" role="region" aria-labelledby="ig-heading" tabindex="0">
          {instagramFrames.map((frame) => {
            const href = frame.postUrl?.trim() || instagramUrl;
            /*
              THE GLYPH SITS ON THE SQUARE (corrected 2026-08-10, after looking).

              It was passed through MediaSurface's caption slot so it would take
              the owner's per-image placement. Every one of these frames is set
              to "below", so on the page four glyphs ended up in a strip of bare
              ink UNDER the squares, detached from the photographs they belong
              to and reading as debris rather than as an affordance. The DOM was
              correct and the page was wrong, which is the whole argument for
              having a browser.

              A caption is words about a photograph and may sit off it. This is
              not a caption: it marks what a TAP does, so it belongs on the
              thing being tapped. It still takes the frame's own measured
              polarity, so the site's one rule about marks on photography holds.
            */
            const square = (
              <div class="relative">
                <MediaSurface media={frame.media} locale={locale} height="square" />
                <span
                  class="ig-badge"
                  data-theme={overlayTheme(frame.media.overlayCaption ?? frame.media.overlay)}
                >
                  <InstagramMark />
                </span>
              </div>
            );
            return (
              <li>
                {href ? (
                  <a
                    href={href}
                    rel="noopener"
                    target="_blank"
                    aria-label={t(locale, "instagramOpen")}
                    class="block"
                  >
                    {square}
                  </a>
                ) : (
                  square
                )}
              </li>
            );
          })}
        </ul>
      </section>
    )
  }

  <TextSurface class="flex flex-col gap-u5 pt-u8 pb-u5">
    <h2 class="type-label text-label">{t(locale, "newsletter")}</h2>
    <p class="type-body text-body max-w-prose">{t(locale, "newsletterLine")}</p>
    <form method="POST" action="/api/enquiry" class="flex max-w-prose flex-col gap-u3">
      <div class="field">
        <label class="type-label text-label" for="list-email">Email</label>
        <input id="list-email" name="email" type="email" required maxlength="254" autocomplete="email" />
      </div>
      {/* Hidden from people, not from bots, exactly as on the enquiry form. */}
      <div class="spam-trap" aria-hidden="true">
        <label for="list-website">Website</label>
        <input id="list-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <input type="hidden" name="intent" value="newsletter" />
      <input type="hidden" name="lang" value={locale} />
      <button type="submit" class="type-label text-label hairline-under self-start">
        {t(locale, "newsletterAction")}
      </button>
    </form>
  </TextSurface>

  <BoundaryWash
    label={collections[0]?.name ?? null}
    sublabel={collections[0]?.season ?? null}
  />

  {/* 5. THE COLLECTIONS. */}
  {/*
    The chapters get a name and a line, like every other movement: the reader
    has scrolled four screens by here and deserves to be told what this last
    sequence is. Ours, flagged as homeLines.
  */}
  {collections.length > 0 && (
    <TextSurface class="flex flex-col gap-u1 pt-u8 pb-u3">
      {/*
        The heading alone: "The current drop, in full." explained the page.
        u8/u3 rather than u13/u5 (section 105): one label in a 229px box was
        94% air, measured.
      */}
      <h2 class="type-label text-label">{t(locale, "collections")}</h2>
    </TextSurface>
  )}

  {
    collections.map((collection) => {
      /*
        ONE LINE, NOT THE STATEMENT (2026-08-10). This block printed his drop
        statement WHOLE — announcement included — four screens after the arrival
        had deliberately stripped that same announcement and shown the line
        underneath it. One page, two rules, and the reader met "Presentiamo
        MONUMENTUS" on a screen that already has the drop's name on the
        photograph above it.

        His statement whole belongs to the two pages that are FOR it: /new and
        the drop's own page. Here the chapter takes one line, in the same
        register the arrival uses, and never a line this page has already spent.
      */
      const line = unspentLine(pick(collection.statement, locale), spentLines);
      if (line) spentLines.push(line);
      const href = localePath(locale, `collections/${collection.slug}`);
      return (
        <>
          {collection.cover && (
            /*
              "tall", not "screen": a chapter cover that seals itself at exactly
              one viewport is the postcard problem. Leaving the next block
              peeking is what keeps the reader descending.
            */
            <MediaSurface media={collection.cover} locale={locale} height="tall">
              <a href={href} class="flex flex-col gap-u1">
                <h2 class="type-label text-label">{collection.name}</h2>
                {collection.season && <span class="type-mono text-mono">{collection.season}</span>}
              </a>
            </MediaSurface>
          )}

          {line && (
            <TextSurface class="flex flex-col gap-u5 py-u8">
              <p class="type-display text-display max-w-prose">{line}</p>
              {/*
                THE WAY IN, NOT THE NAME AGAIN (2026-08-10). This link repeated
                the drop's name, which the photograph directly above it already
                carries as its caption — the same words twice inside one screen,
                the second time as the only thing asking to be clicked. A link
                under a statement is an action, so it says the action. `enterDrop`
                is the same word the drops index uses for the same journey, so
                the two routes into a drop now sound like one site.
              */}
              <a href={href} class="type-label text-label self-start hairline-under">
                {t(locale, "enterDrop")}
              </a>
            </TextSurface>
          )}
        </>
      );
    })
  }
</Base>
