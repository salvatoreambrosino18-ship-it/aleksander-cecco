---
/*
  SOLVET ET COAGULA. The one home of imagery (2026-08-04).

  The gallery dissolved into this page (DESIGN-PLAN section 65): its fifteen
  artistic frames and the eight process frames descend it together, so
  photographs-as-photographs live here and products only ever live in the shop.
  The menu says Process, because the formula is
  illegible to anyone who does not already know the brand; the formula is THIS
  page's title, inside, in the one display size (section 67).

  THE ORDER, UNWOVEN (2026-08-11, section 85, and it reopens section 65).

  The eight process frames are a NARRATIVE — pattern, cut, dye, dry, build, the
  parts, the finished garments — and section 65's weave dealt up to two artistic
  frames into every gap between them: pattern, two artistic, cut, two artistic,
  dye. So the sequence existed in the data and was unreadable on the page, which
  is the fault a proposal to make this page scroll-driven uncovered. The page did
  not need a mechanism. It needed its own order back.

  So: the eight making frames run CONSECUTIVELY, in the order the work happens,
  and the artistic frames follow as a CODA. Nothing is removed — every artistic
  frame still appears, in its own order, the gallery's dark-to-light descent —
  and nothing is added: no captions, no words, no motion. The story is told by
  sequence alone, which is the only way this page has ever been willing to tell
  anything.

  What section 65 was right about is untouched: the gallery is dissolved,
  photographs-as-photographs live here, and products live only in the shop.
  What it got wrong was interleaving two sequences that each mean something in
  their own order and mean nothing shuffled together.

  NO CAPTIONS, still. The only text is the formula and his own making lines.
  The page invents nothing.

  Portraits pair at desktop, exactly as the gallery did and for the same
  measured reason (section 56): a single full-bleed portrait at 1440 is a
  letterbox that destroys the photograph.
*/
import Base from "../../layouts/Base.astro";
import MediaSurface from "../../components/MediaSurface.astro";
import PairedSurface from "../../components/PairedSurface.astro";
import Statement from "../../components/Statement.astro";
import TextSurface from "../../components/TextSurface.astro";
import {getGallery, getSiteSettings} from "../../lib/content";
import type {MediaItem} from "../../lib/media";
import {LOCALES, localePath, pick, toLocale} from "../../lib/locales";
import {imageUrl} from "../../lib/image";
import {voiceState} from "../../lib/voice";
import {t} from "../../i18n/ui";
import {SHOW_UNAPPROVED_MARKS} from "../../lib/marks";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const [settings, gallery] = await Promise.all([getSiteSettings(), getGallery()]);

const process = settings.processMedia ?? [];
const artistic = gallery.flatMap((piece) => piece.media ?? []);

/*
  THE WORK FIRST, IN ITS OWN ORDER, THEN THE PHOTOGRAPHS. Two sequences, each
  kept whole, rather than one shuffled out of two. This replaces the deal that
  put up to two artistic frames between every stage of the making.
*/
const sequence: MediaItem[] = [...process, ...artistic];

/*
  THE PAIRED FRAMES ARE THIS PAGE'S OWN (section 82), AND THEY COME OUT OF THE
  CODA, NOT OUT OF THE WORK (section 85).

  Two constraints meet here and the second one is new.

  `makingMedia` is a SUBSET of `processMedia`, so anchoring a composition on a
  frame home already uses puts the same photograph at the head of a composition
  on two pages. That was section 82's rule and it still holds.

  But an anchor is LIFTED OUT of the descending sequence and shown at the top of
  the page, so anchoring on a making frame would punch a hole in the very
  narrative section 85 just restored — pattern, cut, then dye missing because it
  is up there beside a paragraph. So the anchors are taken from the ARTISTIC
  frames, which are a descent rather than a sequence and lose nothing by giving
  up two, and all eight making frames stay consecutive and in work order.

  It also reads better than it did: the stages passage is now directly above the
  eight frames it describes, with nothing between them.

  Falls back to any frame home does not use, and then to the sequence itself, so
  a dataset with no artistic frames still renders a composed page.
*/
const homeRefs = new Set(
  (settings.makingMedia ?? []).map((m) => m.poster?.asset?._ref).filter(Boolean),
);
const unusedByHome = (items: MediaItem[]) =>
  items.filter((m) => !homeRefs.has(m.poster?.asset?._ref));
const anchors = unusedByHome(artistic);
const fallback = unusedByHome(sequence);
const [pairA, pairB] =
  anchors.length >= 2 ? anchors : fallback.length >= 2 ? fallback : sequence;
const pairedRefs = new Set([pairA, pairB].map((m) => m?.poster?.asset?._ref).filter(Boolean));
const mosaic = sequence.filter((m) => !pairedRefs.has(m.poster?.asset?._ref));

const [first] = sequence;
const making = pick(settings.makingStatement, locale);
/*
  The stages text is OURS in every language, so it is a draft rather than a
  translation and says so wherever marks are shown.
*/
const processText = pick(settings.processText, locale);
const processIsMarked = SHOW_UNAPPROVED_MARKS && Boolean(processText);
const notice = "draftNotice";

const voice = voiceState(settings, locale);

const isLandscape = (media: MediaItem) => {
  const d = media.dimensions;
  return Boolean(d && d.width > d.height);
};
---

<Base
  locale={locale}
  shopChrome={false}
  title={t(locale, "process")}
  description={making ?? undefined}
  image={first ? imageUrl(first.poster, 1200) : null}
>
  {/*
    The formula, inside, in the site's one display size. Then his own account
    of the work, once, and then only photographs.
  */}
  <TextSurface arrive class="flex min-h-[50svh] flex-col justify-end gap-u3 pt-u8 pb-u8">
    <h1 class="type-display text-display">{t(locale, "processTitle")}</h1>
    <p class="type-label text-label">{t(locale, "process")}</p>
  </TextSurface>

  {/*
    COMPOSED, NOT ALONE ON A SCREEN (2026-08-11, section 82). His account of the
    making shares a screen with a photograph rather than sitting on a flat one
    above it — a passage in the body register is never alone on this site.

    Its frame comes from the gallery rather than from the making sequence
    (section 85): an anchor is lifted out of the descent below, and the eight
    frames of the work must stay whole and in order.
  */}
  <PairedSurface media={pairA ?? null} locale={locale} side="left">
    <Statement text={making} locale={locale} voice={voice} register="body" bare />
  </PairedSurface>

  {/*
    THE STAGES (2026-08-11, section 81). The page carried the formula, his three
    lines, and then eight photographs — a reader was shown the work and never
    told what they were looking at.

    OURS, and flagged as `processText`, so it counts against launch-check like
    every other sentence we wrote on his behalf. It names the five stages the
    photographs actually show and claims nothing he has not said; when he writes
    his own account it replaces this and the flag comes off.

    ONE PARAGRAPH, deliberately. Four short lines is a page telling you what you
    are looking at; a line per photograph would be a caption gallery, which is
    what this page has always refused to be.

    IT NOW SITS DIRECTLY ABOVE WHAT IT DESCRIBES (section 85). While the frames
    were woven, this paragraph named five stages and the page then dealt
    unrelated photographs between every one of them. The eight making frames
    follow it immediately and in work order.
  */}
  {processText && (
    <PairedSurface media={pairB ?? null} locale={locale} side="right">
      {processIsMarked && <p class="placeholder-mark self-start">{t(locale, notice)}</p>}
      <p class:list={["type-body text-body whitespace-pre-line", processIsMarked && "draft-text"]}>
        {processText}
      </p>
    </PairedSurface>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2">
    {
      mosaic.map((media, index) => (
        <div class:list={["contents md:block", isLandscape(media) && "md:col-span-2"]}>
          <MediaSurface
            media={media}
            locale={locale}
            height={index % 2 === 0 ? "tall" : "short"}
            desktopHeight="tall"
            priority={index === 0}
            sizes={isLandscape(media) ? "100vw" : "(min-width: 48rem) 50vw, 100vw"}
          />
        </div>
      ))
    }
  </div>

  <TextSurface class="hairline-h flex flex-col gap-u3 py-u13">
    <a
      href={localePath(locale, "creature")}
      class="type-label text-label self-start hairline-under"
    >
      {t(locale, "allCreatures")}
    </a>
  </TextSurface>
</Base>
