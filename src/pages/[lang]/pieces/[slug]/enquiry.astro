---
/*
  The enquiry. The reason the site exists.

  The page is STATIC, like every other page: one is built per garment per
  language at deploy time, with the piece already filled in, so nothing has to
  be looked up or scripted in the browser. It posts to /api/enquiry, which is a
  Cloudflare Pages Function, and that function answers with the confirmation or
  with what went wrong.

  No JavaScript anywhere in the path. A visitor on a broken connection, an old
  phone or with scripts off can still ask for a garment, which is the only thing
  this site is for. The browser's own required and type checks catch the
  ordinary mistakes; the function re-checks everything, because nothing arriving
  from a browser is trusted.

  Nothing here invents a promise. How soon a reply comes is the {REPLY_WINDOW}
  placeholder until the owner agrees one.
*/
import Base from "../../../../layouts/Base.astro";
import TextSurface from "../../../../components/TextSurface.astro";
import {getGarments, type Garment} from "../../../../lib/content";
import {LOCALES, localePath, pick, toLocale} from "../../../../lib/locales";
import {enquiryCopy, ENQUIRY_COPY_IS_DRAFT} from "../../../../i18n/enquiry";
import {t} from "../../../../i18n/ui";

export async function getStaticPaths() {
  const garments = await getGarments();
  return LOCALES.flatMap((lang) =>
    garments.map((garment) => ({params: {lang, slug: garment.slug}, props: {garment}})),
  );
}

const {garment} = Astro.props as {garment: Garment};
const locale = toLocale(Astro.params.lang);
const copy = enquiryCopy(locale);
const notOffered = Boolean(garment.notOffered);
const notOfferedNote = pick(garment.notOfferedNote, locale);
---

<Base locale={locale} title={`${t(locale, "enquire")} / ${garment.name}`}>
  <TextSurface class="flex min-h-svh flex-col gap-u8 pt-chrome pb-u21">
    <div class="flex flex-col gap-u1">
      <h1 class="type-label text-label">{t(locale, "enquire")}</h1>
      <p class="type-mono text-mono">
        {[garment.name, garment.referenceCode].filter(Boolean).join("  /  ")}
      </p>
    </div>

    {ENQUIRY_COPY_IS_DRAFT && <p class="placeholder-mark self-start">{t(locale, "draftNotice")}</p>}

    {
      notOffered ? (
        /* Nothing to send: the piece is not being offered. */
        <p class="type-label text-label max-w-prose">
          {notOfferedNote ?? <span class="placeholder-mark">{"{NOT_OFFERED_NOTE}"}</span>}
        </p>
      ) : (
        <>
          <p class:list={["type-body text-body max-w-prose", ENQUIRY_COPY_IS_DRAFT && "draft-text"]}>
            {copy.intro}
          </p>

          <form method="POST" action="/api/enquiry" class="flex max-w-prose flex-col gap-u5">
            <div class="field">
              <label class="type-label text-label" for="name">{t(locale, "yourName")}</label>
              <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" />
            </div>

            <div class="field">
              <label class="type-label text-label" for="email">Email</label>
              <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />
            </div>

            <fieldset class="flex flex-col gap-u3">
              <legend class="flex flex-col gap-u1">
                <span class="type-label text-label">{t(locale, "yourMeasurements")}</span>
                <span class="type-label text-label">{copy.measureTitle}</span>
              </legend>

              {(["chest", "shoulders", "length"] as const).map((key, index) => (
                <div class="field">
                  <label class="type-label text-label" for={key}>
                    {copy.measures[index].label} (cm)
                  </label>
                  <input
                    id={key}
                    name={key}
                    type="number"
                    inputmode="decimal"
                    step="0.5"
                    required
                    aria-describedby={`${key}-how`}
                  />
                  <p
                    id={`${key}-how`}
                    class:list={["type-body text-body", ENQUIRY_COPY_IS_DRAFT && "draft-text"]}
                  >
                    {copy.measures[index].how}
                  </p>
                </div>
              ))}
            </fieldset>

            <div class="field">
              <label class="type-label text-label" for="note">{t(locale, "note")}</label>
              <textarea id="note" name="note" rows="4" maxlength="2000" />
            </div>

            {/* Hidden from people, not from bots: they fill it in, humans cannot. */}
            <div class="spam-trap" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <input type="hidden" name="lang" value={locale} />
            <input type="hidden" name="slug" value={garment.slug} />
            <input type="hidden" name="garmentName" value={garment.name} />
            <input type="hidden" name="garmentRef" value={garment.referenceCode ?? ""} />
            <input type="hidden" name="renderedAt" value={String(Date.now())} />

            <button type="submit" class="type-label text-label hairline-box self-start px-u3 py-u2">
              {t(locale, "enquire")}
            </button>
          </form>

          <a
            href={localePath(locale, `pieces/${garment.slug}`)}
            class="type-label text-label self-start hover:underline underline-offset-8"
          >
            {garment.name}
          </a>
        </>
      )
    }
  </TextSurface>
</Base>
