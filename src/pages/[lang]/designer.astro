---
/*
  THE DESIGNER. One page, one person, one photograph.

  WHY IT EXISTS. It is the strongest international-trust lever identified in
  DESIGN-PLAN sections 32 and 33. A buyer in Tokyo cannot visit the studio and
  is being asked to send four figures to one person they have never met, and
  every signal that the person is real matters more than any signal that the
  brand has taste. Isaac Sellam carries the same page for the same reason.

  IT IS NOT THE ABOUT PAGE. About is the brand's story, in the brand's voice.
  This is who makes it, and the evidence is the photograph: him at the machine,
  a hide on the table.

  NO INVENTED BIOGRAPHY. The text here is only what is already approved: his own
  words about how the work is made, which is the one thing he has written that
  is genuinely about HIM rather than about the brand. Everything a designer page
  normally carries and we do not have (a name, where he trained, how long he has
  been doing this, whether he works alone) is a MARKED PLACEHOLDER rather than a
  plausible sentence. The questions to ask him are listed in section 41.
*/
import Base from "../../layouts/Base.astro";
import MediaSurface from "../../components/MediaSurface.astro";
import Statement from "../../components/Statement.astro";
import TextSurface from "../../components/TextSurface.astro";
import {getSiteSettings} from "../../lib/content";
import {LOCALES, localePath, pick, toLocale} from "../../lib/locales";
import {overlayTheme} from "../../lib/media";
import {imageUrl} from "../../lib/image";
import {voiceState} from "../../lib/voice";
import {t} from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const settings = await getSiteSettings();

const portrait = settings.designerPortrait;
/*
  His own words, and the only ones used here. `designerText` is his biography
  when he writes one; until then the page shows the making lines, which he DID
  write and which describe how he works, plus a placeholder for the rest.
*/
const written = pick(settings.designerText, locale);
const making = pick(settings.makingStatement, locale);
const voice = voiceState(settings, locale);
---

<Base
  locale={locale}
  title={t(locale, "designer")}
  chrome={overlayTheme(portrait?.overlay)}
  image={portrait ? imageUrl(portrait.poster, 1200) : null}
  theme="dark"
  footerTheme="dark"
>
  {/* The photograph carries this page. It is the evidence, not decoration. */}
  {
    portrait ? (
      <MediaSurface media={portrait} locale={locale} priority>
        <h1 class="type-label text-label">{t(locale, "designer")}</h1>
      </MediaSurface>
    ) : (
      <TextSurface theme="dark" class="flex min-h-svh flex-col justify-center">
        <h1 class="type-label text-label">{t(locale, "designer")}</h1>
        <p class="placeholder-mark self-start">{"{DESIGNER_PORTRAIT}"}</p>
      </TextSurface>
    )
  }

  {/*
    His own account of the work. Approved, so unmarked in the languages he has
    approved, and it is the only text on this page that is not a placeholder.
  */}
  <Statement text={making} locale={locale} voice={voice} register="body" theme="dark" />

  {/*
    Everything a designer page normally carries and this one cannot yet. A
    marked placeholder, never a plausible sentence: inventing where someone
    trained is the same offence as inventing what the brand believes.
  */}
  {
    written ? (
      <Statement text={written} locale={locale} voice={voice} register="body" theme="dark" />
    ) : (
      <TextSurface theme="dark" class="flex flex-col gap-u3 py-u13">
        <p class="placeholder-mark self-start">{"{DESIGNER_BIOGRAPHY}"}</p>
      </TextSurface>
    )
  }

  <TextSurface theme="dark" class="flex flex-col gap-u3 pb-u13">
    <a
      href={localePath(locale, "creature")}
      class="type-label text-label self-start hover:underline underline-offset-8"
    >
      {t(locale, "allCreatures")}
    </a>
    <a
      href={localePath(locale, "contact")}
      class="type-label text-label self-start hover:underline underline-offset-8"
    >
      {t(locale, "contact")}
    </a>
  </TextSurface>
</Base>
