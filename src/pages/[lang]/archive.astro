---
/*
  The archive: past work, as a sequence of full-screen frames.

  Deliberately not a grid. A grid would turn the only evidence that a body of
  work exists into a contact sheet, and the brief forbids thumbnails anyway.
  Deliberately not all of it either: the archive is curated, and its length is
  the design. Frames sit at --media-h-tall so the next one always peeks and the
  eye is pulled down rather than stalled.

  Each frame carries at most a year and a name, in the mono register. With
  nothing at all it is a mood board; with a year it is an archive.
*/
import Base from "../../layouts/Base.astro";
import MediaSurface from "../../components/MediaSurface.astro";
import TextSurface from "../../components/TextSurface.astro";
import {getArchive} from "../../lib/content";
import {LOCALES, toLocale} from "../../lib/locales";
import {imageUrl} from "../../lib/image";
import {overlayTheme} from "../../lib/media";
import {t} from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const pieces = (await getArchive()).filter((piece) => piece.media?.length);
const first = pieces[0]?.media?.[0] ?? null;
---

<Base
  locale={locale}
  title={t(locale, "archive")}
  chrome={overlayTheme(first?.overlay)}
  image={first ? imageUrl(first.poster, 1200) : null}
>
  <h1 class="sr-only">{t(locale, "archive")}</h1>

  {
    pieces.map((piece, index) =>
      piece.media!.map((media, mediaIndex) => (
        <MediaSurface
          media={media}
          locale={locale}
          height="tall"
          priority={index === 0 && mediaIndex === 0}
        >
          {mediaIndex === 0 && (piece.title || piece.year) && (
            <div class="flex flex-col gap-u1">
              {piece.title && <h2 class="type-label text-label">{piece.title}</h2>}
              {piece.year && <span class="type-mono text-mono">{piece.year}</span>}
            </div>
          )}
        </MediaSurface>
      )),
    )
  }

  {
    pieces.length === 0 && (
      <TextSurface class="flex min-h-svh flex-col justify-center">
        <p class="placeholder-mark self-start">{"{ARCHIVE_EMPTY}"}</p>
      </TextSurface>
    )
  }
</Base>
