---
/*
  L'INFORMATIVA PRIVACY (2026-08-17, sezione 137).

  STA DA SOLA, e non insieme alle condizioni di vendita, per una ragione sola e
  pratica: è il documento a cui punta la riga sotto le due casse. Chi segue quel
  link sta per lasciare nome e email e vuole sapere dove finiscono, e deve
  atterrare sull'informativa, non in fondo a una pagina lunga che comincia con
  la spedizione.

  NIENTE DI QUESTA PAGINA VIENE DAL PANNELLO. Il testo è in src/content/legal.ts,
  trascritto parola per parola dal file dell'avvocato. Vedi quel file per il
  perché.
*/
import Base from "../../layouts/Base.astro";
import TextSurface from "../../components/TextSurface.astro";
import LegalDocument from "../../components/LegalDocument.astro";
import {privacyDoc} from "../../content/legal";
import {LOCALES, toLocale} from "../../lib/locales";
import {t} from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const doc = privacyDoc(locale);
---

<Base locale={locale} title={t(locale, "privacyTitle")}>
  <TextSurface class="flex flex-col gap-u5 pt-u13 pb-u13">
    <LegalDocument doc={doc} />
  </TextSurface>
</Base>
