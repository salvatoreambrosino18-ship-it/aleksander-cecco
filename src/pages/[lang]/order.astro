---
/*
  ORDER SEVERAL PIECES (2026-08-17, section 126) — the cart.

  WHAT A CART COSTS ON THIS SITE, stated before it was built because the answer
  shapes the thing. A cart is per-visitor mutable state that has to survive
  navigation. This site is static HTML on a CDN: there is no session, no
  per-request render, and no database. That leaves exactly three ways to hold
  such state, and two of them are not available here:

  - LOCALSTORAGE. Needs JavaScript. Keeps every page static.
  - A COOKIE READ BY THE SERVER. Needs every cart-bearing page to be rendered
    per request, which means routing the whole site through a Function and
    giving up the static CDN model, the deploy hook and the URL. That is an
    infrastructure decision, not a shopping-basket one.
  - THE URL. Would work with no JavaScript, but only if every "add" link on
    every page already carried the current basket — and a static build cannot
    know a visitor's basket when it writes those links.

  So: A CART THAT FOLLOWS A READER FROM PAGE TO PAGE REQUIRES JAVASCRIPT, and
  so does a total that updates as they choose. There is no version of those two
  things without it, short of changing how the site is served.

  WHAT DOES NOT REQUIRE IT is this page. It is one form listing everything that
  can be bought, with a size and a quantity against each piece, and it posts
  once. No cross-page state exists, so none has to be kept. With JavaScript off
  it is a complete, working way to order six pieces at once — the reader simply
  does not see a running total until the confirmation page, which computes it
  server-side from prices the buyer cannot edit.

  With JavaScript on, the same form gains what a cart is for: `Add to order` on
  a piece's own page writes to localStorage, this page arrives filled in, the
  total adds up as you type, and the chrome carries a count. Every one of those
  is an ENHANCEMENT of a control that already works without it.

  Nothing else on the site changed. Every other page still renders and
  navigates with JavaScript disabled, which was verified rather than assumed:
  identical text, links and forms in both states.

  PAYMENT IS NOT HERE, and the form says so. It collects who is buying and what
  they want and sends it to the brand; money is settled in the reply, when he
  has a fiscal position for it. And it posts to the SAME endpoint family as the
  enquiry, behind the SAME gate: with the Resend bindings unset the endpoint
  answers 503 and says sending is not switched on. Nothing leaves this site
  until the privacy notice exists.
*/
import Base from "../../layouts/Base.astro";
import TextSurface from "../../components/TextSurface.astro";
import {getGarments} from "../../lib/content";
import {isPlaceholderText} from "../../lib/content";
import {LOCALES, localePath, toLocale} from "../../lib/locales";
import {t} from "../../i18n/ui";

export function getStaticPaths() {
  return LOCALES.map((lang) => ({params: {lang}}));
}

const locale = toLocale(Astro.params.lang);
const garments = await getGarments();

/*
  THE SAME FILTER THE PRICE LIST USES, and it has to stay the same: a piece
  offered here and absent from order-catalogue.json would be an order the
  endpoint refuses to price. `notOffered` is on the site to be looked at and
  `privateOrder` was made once for somebody.
*/
const buyable = garments
  .filter((g) => g.availability === "readyNow" || g.availability === "unique")
  .filter((g) => typeof g.price === "number" && g.price > 0)
  .filter((g) => !isPlaceholderText(g.name));

const money = (n: number, currency: string | null) =>
  new Intl.NumberFormat(locale === "it" ? "it-IT" : "en-GB", {
    style: "currency",
    currency: currency ?? "EUR",
    maximumFractionDigits: 0,
  }).format(n);
---

<Base locale={locale} title={t(locale, "orderSeveral")}>
  <TextSurface class="flex flex-col gap-u5 pt-u13 pb-u8">
    <h1 class="type-display text-display">{t(locale, "orderSeveral")}</h1>
    <p class="type-body text-body max-w-prose">{t(locale, "orderSeveralIntro")}</p>
  </TextSurface>

  <TextSurface class="pb-u21">
    {
      buyable.length === 0 ? (
        <p class="type-body text-body">{t(locale, "orderEmpty")}</p>
      ) : (
        <form method="POST" action="/api/enquiry" class="flex flex-col gap-u8" data-order-form>
          <h2 class="type-label text-label">{t(locale, "orderPieces")}</h2>

          {/*
            ONE ROW PER PIECE, and the row is the whole control. A quantity of
            zero is a piece not ordered, which is why nothing here is `required`
            and why the endpoint drops empty rows rather than complaining about
            them: a form that refuses to submit until you have set fifteen
            quantities to zero is not a form.
          */}
          <ul class="flex flex-col gap-u5">
            {buyable.map((g) => (
              <li class="order-row" data-slug={g.slug} data-price={g.price}>
                <div class="flex flex-col gap-u1">
                  <a
                    href={localePath(locale, `creature/${g.slug}`)}
                    class="type-label text-label hairline-under self-start"
                  >
                    {g.name}
                  </a>
                  <span class="type-mono text-mono">{money(g.price!, g.currency)}</span>
                  {g.availability === "unique" && (
                    <span class="type-label text-label">{t(locale, "orderOnePiece")}</span>
                  )}
                </div>

                <div class="flex flex-wrap items-end gap-u5">
                  {g.sizes && g.sizes.length > 0 && (
                    <fieldset class="flex flex-col gap-u2">
                      <legend class="type-label text-label">{t(locale, "chooseSize")}</legend>
                      <div class="flex flex-wrap gap-u3">
                        {g.sizes.map((size, i) => (
                          <label class="type-label text-label flex items-baseline gap-u1">
                            <input
                              type="radio"
                              name={`size:${g.slug}`}
                              value={size}
                              checked={i === 0}
                            />
                            {size}
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  )}

                  <div class="field">
                    <label class="type-label text-label" for={`qty-${g.slug}`}>
                      {t(locale, "orderQuantity")}
                    </label>
                    <input
                      id={`qty-${g.slug}`}
                      name={`qty:${g.slug}`}
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max={g.availability === "unique" ? "1" : "10"}
                      step="1"
                      value="0"
                      data-qty
                    />
                  </div>
                </div>
              </li>
            ))}
          </ul>

          {/*
            THE TOTAL IS A CONVENIENCE, NOT A PRICE. It is filled in by script
            from the prices printed above it and stays empty without one; the
            authoritative figure is computed by the endpoint from
            order-catalogue.json, which a buyer cannot edit. Marked `aria-live`
            so a screen reader hears it change rather than having to hunt.
          */}
          <p class="type-mono text-mono flex gap-u3" data-total-row hidden>
            <span>{t(locale, "orderTotal")}</span>
            <output data-total aria-live="polite"></output>
          </p>

          <h2 class="type-label text-label">{t(locale, "orderYourOrder")}</h2>

          <div class="field">
            <label class="type-label text-label" for="name">{t(locale, "yourName")}</label>
            <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" />
          </div>

          <div class="field">
            <label class="type-label text-label" for="email">Email</label>
            <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />
          </div>

          <div class="field">
            <label class="type-label text-label" for="note">{t(locale, "note")}</label>
            <textarea id="note" name="note" rows="4" maxlength="2000" />
          </div>

          <p class="type-body text-body max-w-prose">{t(locale, "deliveryLine")}</p>
          <p class="type-body text-body max-w-prose">{t(locale, "orderNoPayment")}</p>

          {/* Hidden from people, not from bots: they fill it in, humans cannot. */}
          <div class="spam-trap" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <input type="hidden" name="lang" value={locale} />
          <input type="hidden" name="renderedAt" value={String(Date.now())} />

          <button
            type="submit"
            class="type-label text-body hairline-under self-start"
            data-sending={t(locale, "sending")}
          >
            {t(locale, "orderSend")}
          </button>
        </form>
      )
    }
  </TextSurface>

  {/*
    THE ENHANCEMENT, and every line of it is optional. It adds up the total, it
    fills the form in from whatever `Add to order` put in localStorage, and it
    writes back as the reader types so the count in the chrome agrees. With no
    script the form above is already complete and already posts.
  */}
  <script is:inline define:vars={{totalLabel: t(locale, "orderTotal")}}>
    (() => {
      const form = document.querySelector("[data-order-form]");
      if (!form) return;
      const KEY = "ac-order";
      const rows = [...form.querySelectorAll(".order-row")];
      const totalRow = form.querySelector("[data-total-row]");
      const out = form.querySelector("[data-total]");

      const read = () => {
        try {
          return JSON.parse(localStorage.getItem(KEY) || "{}") || {};
        } catch {
          return {};
        }
      };
      const write = (v) => {
        try {
          localStorage.setItem(KEY, JSON.stringify(v));
        } catch {
          /* private mode: the form still works, it just does not remember */
        }
      };

      /* fill in whatever a piece page put there */
      const saved = read();
      for (const row of rows) {
        const slug = row.dataset.slug;
        const entry = saved[slug];
        if (!entry) continue;
        const qty = row.querySelector("[data-qty]");
        if (qty) qty.value = String(Math.min(Number(entry.qty) || 0, Number(qty.max) || 10));
        if (entry.size) {
          const radio = row.querySelector(`input[type=radio][value="${CSS.escape(entry.size)}"]`);
          if (radio) radio.checked = true;
        }
      }

      const currency = document.documentElement.lang === "it" ? "it-IT" : "en-GB";
      const fmt = new Intl.NumberFormat(currency, {
        style: "currency",
        currency: "EUR",
        maximumFractionDigits: 0,
      });

      const sync = () => {
        let total = 0;
        const next = {};
        for (const row of rows) {
          const qty = Number(row.querySelector("[data-qty]")?.value) || 0;
          if (qty <= 0) continue;
          total += qty * (Number(row.dataset.price) || 0);
          const size = row.querySelector("input[type=radio]:checked")?.value;
          next[row.dataset.slug] = size ? {qty, size} : {qty};
        }
        write(next);
        if (out) out.textContent = fmt.format(total);
        if (totalRow) totalRow.hidden = total <= 0;
        document.dispatchEvent(new CustomEvent("ac-order-changed"));
      };

      form.addEventListener("input", sync);
      form.addEventListener("change", sync);
      sync();
    })();
  </script>
</Base>
