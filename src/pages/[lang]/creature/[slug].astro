---
/*
  The garment page. Step 2 of the build order, and the page that matters most.

  Structure (DESIGN-PLAN section 4): the gallery is the page. Every image is a
  full-bleed media surface at screen height, the name and reference sit over the
  first one at label scale, and only then does a text surface carry the mono
  facts and the single action. The diptych is withdrawn, so nothing caps the
  photograph at half the viewport.

  HOW A CREATURE CAN BE HAD, since 2026-08-12 (section 98) and settled on
  2026-08-16 (section 130): it EXISTS, it is bought as it is, and the buyer
  CHOOSES A SIZE. There is no made to measure anywhere — not a flow, not a
  state, and since section 130 not a sentence either. A piece already sold
  (private order) or withdrawn (not taking requests) carries no action, and a
  1 of 1 is bought exactly like anything else.
*/
import Base from "../../../layouts/Base.astro";
import TextSurface from "../../../components/TextSurface.astro";
import MediaSurface from "../../../components/MediaSurface.astro";
import {getGarments, isPlaceholderText, neighbours, type Garment} from "../../../lib/content";
import {imageUrl} from "../../../lib/image";
import {LOCALES, localePath, pick, toLocale, type Locale} from "../../../lib/locales";
import {t} from "../../../i18n/ui";
import {SHOW_UNAPPROVED_MARKS} from "../../../lib/marks";

export async function getStaticPaths() {
  const garments = await getGarments();
  return LOCALES.flatMap((lang) =>
    garments.map((garment) => ({
      params: {lang, slug: garment.slug},
      // The whole set travels with the page so it can name its neighbours.
      props: {garment, all: garments},
    })),
  );
}

const {garment, all} = Astro.props as {garment: Garment; all: Garment[]};
const locale = toLocale(Astro.params.lang) as Locale;


/*
  NEXT AND PREVIOUS. Without them every Creature was a dead end and seeing two
  meant returning to the index in between, which was the most repeated action
  on the site. Same order as the index and the collection, and it WRAPS: a
  sequence that stops has an end, and an end invites leaving.
*/
const {previous, next} = neighbours(all, garment.slug);


const media = garment.media ?? [];
const [firstMedia] = media;

/*
  A provisional frame says so on the page, not only in the studio. The hat's
  only photograph is a crop out of the designer portrait, and an unmarked
  stopgap is how a stopgap becomes permanent (standing rule 6, in spirit).
*/
const hasProvisional = media.some((item) => item.isProvisional);

const description = pick(garment.description, locale);
const materials = pick(garment.materials, locale);
const availabilityNote = pick(garment.availabilityNote, locale);

/*
  HOW THIS CREATURE CAN BE HAD. Four states, not two (DESIGN-PLAN section 24).
  Only "made to order" carries the enquiry action: a unique piece and a private
  commission are both already made and already someone's, so offering to build
  another would be a lie. They stay fully visible at full scale, which is the
  rule that has always governed a withdrawn action here.
*/
const availability = garment.availability ?? "readyNow";
/*
  TWO STATES CAN BE ENQUIRED ABOUT (2026-08-03). A piece available now and a
  piece made to order are both things a visitor can ask for; what differs is
  WHAT they are asking for, which the enquiry form goes on to ask.
*/
/*
  A 1 OF 1 CAN BE BOUGHT (2026-08-04), which "unique" previously could not: it
  was grouped with private orders and carried no action at all. The owner has
  confirmed these are private commissions that exist and are for sale AS THEY
  ARE, so they take the action and never the remake choice.
*/
/*
  EVERY PIECE IS BOUGHT AS IT EXISTS (section 98). `madeToOrder` is kept in the
  union only so a document nobody has re-saved still renders and still sells;
  the studio no longer offers it.
*/
const canEnquire =
  availability === "readyNow" || availability === "unique" || availability === "madeToOrder";
/*
  A PIECE CAN ONLY JOIN A BASKET IF IT HAS A PRICE (2026-08-17, section 126).

  The single-piece order works without one — it asks him for a piece and he
  answers with a figure — but a basket has a TOTAL, and a line with no price
  either breaks the sum or silently counts as zero. The endpoint prices from
  order-catalogue.json, which excludes anything unpriced, so an `Add to order`
  on such a piece would put it in the basket and then quietly drop it.

  Rubedo is the case that found this: eleven photographs, first in the worn
  band, availability `unique`, and no price in the dataset. It keeps its
  Acquire line and loses only the basket, which is the honest split — the
  number is his to set, and nothing here should invent one.
*/
const canAddToOrder = canEnquire && typeof garment.price === "number" && garment.price > 0;
/*
  The sizes the ADD control offers. ONE is filtered out for the same reason the
  order form filters it (section 101): a piece that is one size has nothing to
  choose, so it carries no radios and its cart line carries no size.
*/
const addSizes = (garment.sizes ?? []).filter((size) => size !== "ONE");
const isUnique = availability === "unique";
const availabilityLabel = {
  readyNow: t(locale, "availableNow"),
  unique: t(locale, "unique"),
  privateOrder: t(locale, "privateOrder"),
  notOffered: t(locale, "notTakingRequests"),
}[availability] ?? t(locale, "availableNow");

const price =
  typeof garment.price === "number"
    ? new Intl.NumberFormat(locale === "it" ? "it-IT" : "en-GB", {
        style: "currency",
        currency: garment.currency || "EUR",
        maximumFractionDigits: 0,
      }).format(garment.price)
    : null;

/*
  THE INSCRIPTION, in his own caption format (DESIGN-PLAN section 26):

      Creature: Tomar. Composition: 100% lambskin. Handcrafted.

  It replaced a seven row definition list. His caption for the same kind of
  object is one line; seven labelled rows is a product sheet, and a product
  sheet is what this site is not. Each part still shows a marked placeholder
  where the owner has not supplied the fact, so nothing is invented to make the
  sentence read well.
*/
const named = Boolean(garment.name) && !isPlaceholderText(garment.name);
const composed = Boolean(materials) && !isPlaceholderText(materials);

const inscription: Array<{text: string | null; token: string}> = [
  {text: named ? `${t(locale, "creature")}: ${garment.name}.` : null, token: "{GARMENT_NAME}"},
  {text: composed ? `${t(locale, "composition")}: ${materials}.` : null, token: "{MATERIALS}"},
  /*
    A Creature with no collection SAYS so. Rubedo is outside MONUMENTUS:
    Tenebrae & Lux, confirmed by the owner, and an empty collection row would
    read as an oversight rather than as a fact (DESIGN-PLAN section 31).
  */
  ...(garment.collection ? [] : [{text: t(locale, "outsideCollections"), token: ""}]),
  /*
    "Handcrafted. Made to measure." was the constant here until 2026-08-12, when
    the owner removed made to measure from the shop (section 98). What is
    always true of a Creature now is that it is handcrafted in South Italy.
    Being built to someone's measurements is not offered at all since section
    130, so there is no longer a line about it anywhere on this page.
  */
  {text: t(locale, "handcrafted"), token: ""},
];

/*
  What is left after the inscription: facts that are real but subordinate. The
  reference measurements stay here rather than behind a disclosure, because with
  no sizes they are the ONLY way to judge cut and proportion (section 17) and
  hiding them behind a click would be the wrong kind of restraint.

  Category is GONE (2026-08-02): the owner confirmed that Uomo/Donna
  contradicted his own words about Armonyen. What replaced it, the tenebrae/lux
  stage, is deliberately not printed here: it is already inside the names he
  gives his Creature, and a page that also printed "Stage: Tenebrae" would be
  the site explaining itself. It drives the collection page's order instead.

  Price STAYS: the owner confirmed prices are visible on the site.
*/
const sizes = garment.sizes ?? [];

const subordinate: Array<{term: string; value: string | null; placeholder?: string}> = [
  {
    /*
      THE SIZES HE MAKES THIS PIECE IN (section 101), or One Size when the list
      is empty — which is a fact about the object rather than a missing value,
      so it prints rather than showing a placeholder.
    */
    term: t(locale, "sizeQuestion"),
    value: sizes.includes("ONE")
      ? t(locale, "oneSize")
      : sizes.length > 0
        ? sizes.join("  /  ")
        : null,
    placeholder: "{SIZES}",
  },
  {
    term: t(locale, "collection"),
    value: garment.collection
      ? [garment.collection.name, garment.collection.season].filter(Boolean).join("  /  ")
      : null,
  },
  {
    /*
      THE LABEL FOLLOWS THE STATE, and this is not cosmetic. On a made to order
      piece these are the measurements of the photographed sample, offered as
      context. On a piece that already exists they are the measurements of the
      object that will arrive, which is a different claim about the same number
      (DESIGN-PLAN sections 31 and 49). One field, two truthful labels, rather
      than two fields an owner would have to keep in step.
    */
    /*
      ALWAYS THIS PIECE'S OWN MEASUREMENTS (section 98). The label used to
      follow the state — reference measurements on a made-to-order piece, this
      piece's on a ready one — and there is only one state now: the object that
      will arrive is the object in the photograph.
    */
    /*
      MEASUREMENTS ARE REFERENCE INFORMATION NOW, NOT FIT INFORMATION (section
      101). The buyer chooses a size and he makes the piece in it, so nobody has
      to reason from a number to know whether it fits. Oblivion's numbers are
      HIS and stay, because a person who wants to know how long a sleeve is
      should be able to find out — but a missing set is no longer a hole, so
      there is no placeholder and the row simply does not appear.
    */
    term: t(locale, "thisPieceMeasurements"),
    value: garment.measurements,
  },
  {term: t(locale, "price"), value: price, placeholder: "{PRICE_EUR}"},
];
---

{/*
  A CREATURE OPENS AT PIXEL ZERO TOO (2026-08-12, section 115). Neither
  reference folder contains a product detail page — 77 of 77 opened, section 107
  — so nothing here is copied from them. What IS carried over is the site's own
  rule: a page whose first block is a full-bleed photograph floats its chrome on
  that photograph, in the polarity the owner measured for it, and a page that
  opens on words does not. This page opens on the garment.
*/}
<Base
  locale={locale}
  chromeOver={firstMedia?.overlay ?? null}
  title={garment.name}
  description={description ?? undefined}
  image={firstMedia ? imageUrl(firstMedia.poster, 1200) : null}
>
  {
    media.map((item, index) => (
      <MediaSurface
        media={item}
        locale={locale}
        priority={index === 0}
        class={index === 0 ? "piece-hero" : undefined}
      >
        {index === 0 && (
          <>
            <h1 class="type-display text-display">{garment.name}</h1>
            {/*
              The price answers "what does it cost" on the FIRST screen, not
              seven screens down at the technical block (2026-08-04). A buyer
              arriving from Instagram decides whether to keep scrolling on this
              number; his own shop shows it beside every name.
            */}
            {price && <span class="type-mono text-mono">{price}</span>}
          </>
        )}
      </MediaSurface>
    ))
  }

  <TextSurface class="flex flex-col gap-u8 py-u13">
    <h2 class="sr-only">{t(locale, "details")}</h2>

    {hasProvisional && SHOW_UNAPPROVED_MARKS && (
      <p class="placeholder-mark self-start">{t(locale, "provisionalPhoto")}</p>
    )}

    {/* The inscription. One statement, three short lines, no labels. */}
    <div class="type-display text-display flex flex-col gap-u1">
      {
        inscription.map(({text, token}) =>
          text ? (
            <p>{text}</p>
          ) : token ? (
            <p class="placeholder-mark self-start">{token}</p>
          ) : null,
        )
      }
      {/*
        The availability line appears only when it says something the constant
        line above it does not: "Made to order." under "Handcrafted. Made to
        measure." was a tautology, found by reading the page as a buyer. The
        other four states carry real information and stay.
      */}
      <p>{availabilityLabel}</p>
    </div>

    {/*
      MADE TO MEASURE IS GONE FROM THE PIECE (2026-08-16, section 130). THE
      OWNER'S DECISION, in the same breath as the sizes: XS, S, M, L on
      everything, and NO MADE TO MEASURE.

      What stood here was OUR sentence, flagged `madeToMeasureLine`, inviting a
      reader to write about a made-to-measure piece. The moment he decided there
      is none, it stopped being an unapproved draft and became a FALSE OFFER on
      the page where a person commits — which is the exact fault section 108
      removed two words from his own /about text for, and the rule it set:
      **a site that says less is not exposed and a site that says the wrong
      thing is.**

      THE SENTENCE, so it can come back without archaeology:
        "Su misura, solo su richiesta: scrivici e ne parliamo."
        "Made to measure on request only: write to us and we will talk."
      It is recorded here, in DESIGN-PLAN section 130, and nowhere else — the
      string, its studio field and its draft flag were all removed, because a
      field in the studio that no page reads is a promise the studio cannot
      keep.

      AND THE DELIVERY LINE WENT TOO (2026-08-16, section 131). It said the
      piece is MADE AFTER THE ORDER, two lines under "Available now." Both were
      claims about the terms of sale and they contradicted each other on the
      page where a person commits. The owner chose: available now is what the
      site says. Nothing stands here now — the availability line above has
      already said the thing a buyer needs.
    */}

    {description && <p class="type-body text-body max-w-prose">{description}</p>}

    {/*
      Subordinate facts. Demoted by SIZE, not by opacity: the inscription above
      is --t-statement (18 to 28px) and this is --t-mono (12px), which is a 2x
      contrast on its own. Fading these to 60% would paint gray text, and there
      is no gray in this system at all (standing rule 1). It nearly shipped that
      way, which is exactly why the rule is absolute rather than a preference.
    */}
    {/*
      A MISSING FACT SHOWS NOTHING (2026-08-17, section 127). This list was
      printing "{SIZES}" to visitors on all fifteen Creature in both languages,
      and "{PRICE_EUR}" on Rubedo — literal braces in mono with a dashed rule
      under them, on the live site, because a row rendered whenever it had a
      value OR a placeholder.

      That is the same mistake section 59 already settled for the unapproved
      marks and settled the same way: a visitor cannot act on the distinction,
      and it makes a real brand look like a rehearsal. SHOW_UNAPPROVED_MARKS
      turned those off and left these on, which is the worst of both — the
      site looked finished except for the one thing it admitted.

      So the token follows the same switch, and the row it was standing in
      disappears with it. The measurements row above has worked this way since
      section 101 and says why in its own note; this is that rule applied to
      the two rows that were still shouting. Nothing is hidden from the people
      who can fix it: `npm run launch-check` still refuses on both, naming
      every piece with no size and every piece with no price.
    */}
    <dl class="flex flex-col gap-u2">
      {
        subordinate.map(({term, value, placeholder}) =>
          value || (placeholder && SHOW_UNAPPROVED_MARKS) ? (
            <div class="flex flex-wrap items-baseline gap-u2">
              <dt class="type-mono text-mono">{term}</dt>
              <dd class="type-mono text-mono">
                {value ?? <span class="placeholder-mark">{placeholder}</span>}
              </dd>
            </div>
          ) : null,
        )
      }
    </dl>

    {/*
      A buyer who can neither visit nor try anything on has only these numbers.
      The line is deliberately true under BOTH answers to the open question in
      section 31: comparing against a garment you already own works whether
      these are the measurements of the photographed sample or of the object
      that will arrive.
    */}
    {/*
      BODY, NOT LABEL (2026-08-10). This is a SENTENCE of advice — "compare it
      against a garment you already own that fits the way you want" — and it was
      set in the label register: uppercase, tracked at 0.08em, 11px. That made
      the single most useful piece of guidance on the page the hardest thing on
      it to read, and it is the clearest case of the registers being misused
      rather than being wrong. Label is for names, seasons, captions, buttons
      and the menu. A sentence a person has to act on is body.
    */}
    {/*
      Only where his own numbers exist, and only as reference: the size choice
      is what decides fit now (section 101).
    */}
    {garment.measurements && <p class="type-body text-body max-w-prose">{t(locale, "fitGuidance")}</p>}

    {
      canEnquire ? (
        /*
          THE ACTION NAMES THE TRANSACTION (2026-08-04): Acquire, with the
          price on it, because that is the number a person confirms before
          pressing anything. It leads to the order page; the enquiry framing is
          gone. Still one action, still the field language of section 26.
        */
        <div class="flex flex-col gap-u3">
          <a
            href={localePath(locale, `creature/${garment.slug}/order`)}
            class="type-label text-body hairline-under self-start"
          >
            {t(locale, isUnique ? "uniqueAction" : "acquire")}{price ? ` — ${price}` : ""}
          </a>

          {/*
            CHOOSE A SIZE AND ADD IT TO THE CART (2026-08-16, section 129), the
            OWNER's call: what every shop has, on the page where a person is
            deciding.

            IT IS ABSENT WITHOUT JAVASCRIPT, and that is the honest shape rather
            than a shortcut. Section 126 made this a LINK to an order page
            listing everything, so it worked with no script; the owner has seen
            that page and does not want it, so there is nothing left to fall
            back to. A button that cannot add, or radios whose answer nothing
            reads, would be furniture pretending to be a control. `.cart-add` is
            `display: none` until the document carries `js`.

            WHAT A READER WITH NO SCRIPT GETS IS EXACTLY WHAT THEY GOT BEFORE
            ANY OF THIS EXISTED: the Acquire line above, which leads to this
            piece's own order form, which asks for the size itself and posts
            without a line of JavaScript. Nothing was taken from them.

            ONE LINE PER PIECE, and the size lives on that line. Adding a piece
            already in the cart raises its quantity and takes the size now
            chosen; there is no second line for the same piece in another size.
            The wire format the endpoint already validates is one quantity and
            one size per slug, and with sixteen pieces, most of them 1 of 1, a
            second line is a shop-scale feature this shop does not have. The
            cart shows the line, so nothing about it is hidden.
          */}
          {canAddToOrder && (
            <div class="cart-add">
              {/*
                ONE SIZE carries no control (section 101): there is nothing to
                choose, and a question with one answer is furniture. The empty
                list is a different state — nobody has decided — and
                `launch-check` refuses on it, so it must not silently become
                One Size here.
              */}
              {addSizes.length > 0 && (
                <fieldset class="flex flex-col gap-u2">
                  <legend class="type-label text-label">{t(locale, "chooseSize")}</legend>
                  <div class="flex flex-wrap gap-u3">
                    {/*
                      NOTHING IS PRE-CHECKED, and that is the point (section
                      130). The first radio used to be selected, so a reader who
                      never noticed the control added the piece in XS — on a
                      1850 euro jacket, the smallest size, silently. A default
                      is a choice made on the buyer's behalf, and this is the
                      one choice on the site that nobody else can make.
                    */}
                    {addSizes.map((size) => (
                      <label class="type-label text-label flex items-baseline gap-u1">
                        <input type="radio" name="cart-size" value={size} />
                        {size}
                      </label>
                    ))}
                  </div>
                </fieldset>
              )}

              {/*
                `data-fallback-href` is where a reader goes when storage refuses
                — private browsing, a full store. This piece's own order form:
                no storage, no script, and it can still sell them the thing they
                just asked for.
              */}
              <button
                type="button"
                class="type-label text-body hairline-under self-start"
                data-add-to-cart={garment.slug}
                data-added-label={t(locale, "cartAdded")}
                data-needs-size={t(locale, "chooseSizeFirst")}
                data-fallback-href={localePath(locale, `creature/${garment.slug}/order`)}
              >
                {t(locale, "cartAdd")}
              </button>
            </div>
          )}
        </div>
      ) : (
        /*
          No action, and no apology. The Creature stays visible at full scale
          and the inscription above has already said what it is; only the
          owner's own extra line, where he wrote one, is added here.
        */
        availabilityNote && <p class="type-label text-label max-w-prose">{availabilityNote}</p>
      )
    }
  </TextSurface>

  {/*
    The sequence. Label register, hanging off the spine, no arrows or chevrons:
    the words are the control, as everywhere else on this site.
  */}
  {
    (previous || next) && (
      <TextSurface class="hairline-h flex flex-wrap justify-between gap-u3 py-u5">
        {previous ? (
          <a
            href={localePath(locale, `creature/${previous.slug}`)}
            class="type-label text-label hairline-under"
          >
            {t(locale, "previousCreature")}
          </a>
        ) : (
          <span />
        )}
        <a
          href={localePath(locale, "creature")}
          class="type-label text-label hairline-under"
        >
          {t(locale, "allCreatures")}
        </a>
        {next ? (
          <a
            href={localePath(locale, `creature/${next.slug}`)}
            class="type-label text-label hairline-under"
          >
            {t(locale, "nextCreature")}
          </a>
        ) : (
          <span />
        )}
      </TextSurface>
    )
  }
</Base>
