---
/*
  The garment page. Step 2 of the build order, and the page that matters most.

  Structure (DESIGN-PLAN section 4): the gallery is the page. Every image is a
  full-bleed media surface at screen height, the name and reference sit over the
  first one at label scale, and only then does a text surface carry the mono
  facts and the single action. The diptych is withdrawn, so nothing caps the
  photograph at half the viewport.

  How a Creature can be had is a four-state fact, not a boolean: made to order,
  unique (1 of 1), a private order, or not in the making now. Only the first
  carries an enquiry action (DESIGN-PLAN section 24).
*/
import Base from "../../../layouts/Base.astro";
import TextSurface from "../../../components/TextSurface.astro";
import MediaSurface from "../../../components/MediaSurface.astro";
import {getGarments, type Garment} from "../../../lib/content";
import {overlayTheme} from "../../../lib/media";
import {imageUrl} from "../../../lib/image";
import {LOCALES, localePath, pick, toLocale, type Locale} from "../../../lib/locales";
import {t} from "../../../i18n/ui";

export async function getStaticPaths() {
  const garments = await getGarments();
  return LOCALES.flatMap((lang) =>
    garments.map((garment) => ({params: {lang, slug: garment.slug}, props: {garment}})),
  );
}

const {garment} = Astro.props as {garment: Garment};
const locale = toLocale(Astro.params.lang) as Locale;

const media = garment.media ?? [];
const [firstMedia] = media;

const description = pick(garment.description, locale);
const materials = pick(garment.materials, locale);
const availabilityNote = pick(garment.availabilityNote, locale);

/*
  HOW THIS CREATURE CAN BE HAD. Four states, not two (DESIGN-PLAN section 24).
  Only "made to order" carries the enquiry action: a unique piece and a private
  commission are both already made and already someone's, so offering to build
  another would be a lie. They stay fully visible at full scale, which is the
  rule that has always governed a withdrawn action here.
*/
const availability = garment.availability ?? "madeToOrder";
const canEnquire = availability === "madeToOrder";
const availabilityLabel = {
  madeToOrder: t(locale, "madeToOrder"),
  unique: t(locale, "unique"),
  privateOrder: t(locale, "privateOrder"),
  notOffered: t(locale, "notTakingRequests"),
}[availability] ?? t(locale, "madeToOrder");

// Category values are controlled ("uomo" / "donna"). Whether the English
// catalogue translates them is still an open question in the plan's
// need-from-you list, so the stored value is shown as it is, in both locales.
const category = garment.category;

const price =
  typeof garment.price === "number"
    ? new Intl.NumberFormat(locale === "it" ? "it-IT" : "en-GB", {
        style: "currency",
        currency: garment.currency || "EUR",
        maximumFractionDigits: 0,
      }).format(garment.price)
    : null;

const facts: Array<{term: string; value: string | null; placeholder?: string}> = [
  {
    term: t(locale, "collection"),
    value: garment.collection
      ? [garment.collection.name, garment.collection.season].filter(Boolean).join("  /  ")
      : null,
  },
  {term: t(locale, "category"), value: category},
  // Not a field any more: every piece is made to measure, always, so this is a
  // fact about the brand rather than a property of one garment.
  {term: t(locale, "madeToMeasure"), value: t(locale, "madeToMeasureValue")},
  {term: t(locale, "materials"), value: materials, placeholder: "{MATERIALS}"},
  {term: t(locale, "availability"), value: availabilityLabel},
  {
    term: t(locale, "referenceMeasurements"),
    value: garment.measurements,
    placeholder: "{MEASUREMENTS}",
  },
  {term: t(locale, "price"), value: price, placeholder: "{PRICE_EUR}"},
];
---

<Base
  locale={locale}
  title={garment.name}
  description={description ?? undefined}
  chrome={overlayTheme(firstMedia?.overlay)}
  image={firstMedia ? imageUrl(firstMedia.poster, 1200) : null}
>
  {
    media.map((item, index) => (
      <MediaSurface media={item} locale={locale} priority={index === 0}>
        {index === 0 && (
          <>
            <h1 class="type-label text-label">{garment.name}</h1>
            {garment.referenceCode && (
              <span class="type-mono text-mono">{garment.referenceCode}</span>
            )}
          </>
        )}
      </MediaSurface>
    ))
  }

  <TextSurface class="flex flex-col gap-u8 py-u13">
    <h2 class="sr-only">{t(locale, "details")}</h2>

    {description && <p class="type-body text-body max-w-prose">{description}</p>}

    <dl class="flex flex-col gap-u3">
      {
        facts.map(({term, value, placeholder}) =>
          value || placeholder ? (
            <div class="flex flex-col gap-u1">
              <dt class="type-label text-label">{term}</dt>
              <dd class="type-mono text-mono">
                {value ?? <span class="placeholder-mark">{placeholder}</span>}
              </dd>
            </div>
          ) : null,
        )
      }
    </dl>

    {
      canEnquire ? (
        <a
          href={localePath(locale, `creature/${garment.slug}/enquiry`)}
          class="type-label text-label hairline-box self-start px-u3 py-u2"
        >
          {t(locale, "enquire")}
        </a>
      ) : (
        /*
          No action, and no apology. The Creature stays visible at full scale
          and the line says plainly what it is. The owner's own extra line wins
          where he wrote one; the default is the state itself, which for a
          unique piece is the whole truth.
        */
        <p class="type-label text-label max-w-prose">{availabilityNote ?? availabilityLabel}</p>
      )
    }
  </TextSurface>
</Base>
