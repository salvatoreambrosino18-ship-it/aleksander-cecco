---
/*
  THE CATALOGUE. Everything, on one page (2026-08-04).

  A CONTROL ROW, in the manner of the owner's own shop: filter by drop, filter
  by who a piece is for, and the piece count. All of it CSS: radio inputs and
  `:has()`, no script and no bundle, so filtering survives JavaScript being off
  exactly as the order form does. The count is precomputed per combination and
  the matching one revealed, because CSS cannot count elements.

  THREE MOVEMENTS, with visible headings, which is what replaced the idea of
  menu sub-items: sectioning belongs inside the page, not in the menu.

    1. AVAILABLE   ready now and made to order, the things a visitor can have
    2. 1 OF 1      private commissions, made once, bought as they are
    3. SOLD OUT    marked, at the bottom, carrying no price

  GENDER IS A FILTER, NEVER A STRUCTURE. Seventeen pieces do not need halving,
  and a garment cut to the measurements of the person ordering is that person's
  garment (section 26). An UNSET piece appears under every filter, which is the
  honest behaviour when nobody has said which.

  Four across at desktop, TWO ON A PHONE, as asked. A tile keeps the
  photograph's own 3:4 at every width rather than a viewport height, because
  two across a 390px screen is a 195px column and a viewport-tall frame there
  is a chimney. Name and price below the frame; second photograph on hover.
*/
import Base from "../../../layouts/Base.astro";
import TextSurface from "../../../components/TextSurface.astro";
import MediaSurface from "../../../components/MediaSurface.astro";
import {byStage, getGarments, isPlaceholderText, type Garment} from "../../../lib/content";
import {LOCALES, localePath, toLocale} from "../../../lib/locales";
import {imageUrl} from "../../../lib/image";
import {t} from "../../../i18n/ui";

export async function getStaticPaths() {
  const garments = await getGarments();
  return LOCALES.map((lang) => ({params: {lang}, props: {garments}}));
}

const {garments: unordered} = Astro.props as {garments: Garment[]};
const locale = toLocale(Astro.params.lang);

const creature = byStage(unordered).filter((g) => g.media?.[0]);
const first = creature[0]?.media?.[0];

const allNamed = creature.every((garment) => !isPlaceholderText(garment.name));

const money = new Intl.NumberFormat(locale === "it" ? "it-IT" : "en-GB", {
  style: "currency",
  currency: "EUR",
  maximumFractionDigits: 0,
});
const priceOf = (garment: Garment) =>
  typeof garment.price === "number" ? money.format(garment.price) : null;

const isSold = (g: Garment) =>
  g.availability === "notOffered" || g.availability === "privateOrder";

/* The three movements, in the order a buyer cares about them. */
const MOVEMENTS = [
  {
    key: "available",
    label: t(locale, "movementAvailable"),
    items: creature.filter(
      (g) => !g.availability || g.availability === "readyNow" || g.availability === "madeToOrder",
    ),
  },
  {
    key: "oneOfOne",
    label: t(locale, "movementOneOfOne"),
    items: creature.filter((g) => g.availability === "unique"),
  },
  {key: "sold", label: t(locale, "movementSold"), items: creature.filter(isSold)},
].filter((m) => m.items.length > 0);

/* The drops present in the catalogue, for the filter. */
const drops = [
  ...new Map(
    creature
      .filter((g) => g.collection?.slug)
      .map((g) => [g.collection!.slug!, g.collection!.name] as const),
  ).entries(),
];

const WORN = ["men", "women"] as const;

/*
  Counts per combination, precomputed. CSS cannot count, so every count is
  rendered and `:has()` reveals the one matching the current filters. A piece
  with no `wornBy` counts under every filter, matching how it displays.
*/
const matches = (g: Garment, drop: string, worn: string) =>
  (drop === "all" || g.collection?.slug === drop) &&
  (worn === "all" || !g.wornBy || g.wornBy === worn || g.wornBy === "both");

/*
  Only the combinations that can actually be selected. The drop control is
  hidden while there is a single drop (a filter with one option is furniture,
  section 62), so emitting per-drop counts then put two visible counts on the
  page at once, which is exactly what it looked like: "17 Creature17 Creature".
*/
const dropKeys = drops.length > 1 ? ["all", ...drops.map(([slug]) => slug)] : ["all"];
const countKeys: Array<{drop: string; worn: string; n: number}> = [];
for (const drop of dropKeys) {
  for (const worn of ["all", ...WORN]) {
    countKeys.push({drop, worn, n: creature.filter((g) => matches(g, drop, worn)).length});
  }
}
---

<Base
  locale={locale}
  title={t(locale, "allCreatures")}
  image={first ? imageUrl(first.poster, 1200) : null}
>
  <div class="catalogue">
    <TextSurface arrive class="flex flex-col gap-u2 pt-u8 pb-u3 md:gap-u3 md:pb-u5">
      <h1 class="type-display text-display">{t(locale, "allCreatures")}</h1>
      <p class="type-body text-body max-w-prose">{t(locale, "shopIntro")}</p>

      <div class="flex flex-wrap items-baseline gap-x-u5 gap-y-u2 pt-u2">
        {/*
          Each control is a LABEL WRAPPING ITS RADIO, so focus can be styled
          generically (`label:has(:focus-visible)`) without a rule per id, and a
          keyboard reader never focuses something invisible.
        */}
        {drops.length > 1 && (
          <div class="flex flex-wrap items-baseline gap-u3">
            <label class="filter-label type-label text-label">
              <input class="filter-state" type="radio" name="drop" value="all" checked />
              {t(locale, "filterAll")}
            </label>
            {drops.map(([slug, name]) => (
              <label class="filter-label type-label text-label">
                <input class="filter-state" type="radio" name="drop" value={slug} />
                {name}
              </label>
            ))}
          </div>
        )}

        <div class="flex flex-wrap items-baseline gap-u3">
          <label class="filter-label type-label text-label">
            <input class="filter-state" type="radio" name="worn" value="all" checked />
            {t(locale, "filterEveryone")}
          </label>
          {WORN.map((w) => (
            <label class="filter-label type-label text-label">
              <input class="filter-state" type="radio" name="worn" value={w} />
              {t(locale, w === "men" ? "filterMen" : "filterWomen")}
            </label>
          ))}
        </div>

        <p class="type-mono text-mono">
          {countKeys.map(({drop, worn, n}) => (
            <span class="count" data-drop={drop} data-worn={worn}>
              {n} {t(locale, "countCreatures")}
            </span>
          ))}
        </p>
      </div>
    </TextSurface>

    {
      creature.length > 0 ? (
        MOVEMENTS.map((movement) => (
          <section class="movement" aria-label={movement.label}>
            {/*
              The movement heading arrives on the reveal's own curve as it is
              scrolled to (section 72): the three movements are the page's
              architecture, and architecture can be walked into. Same system as
              every arrival — no new mechanism, reduced-motion and no-JS
              guarantees unchanged. Remove by deleting `arrive`.
            */}
            {/*
              THE FIRST MOVEMENT LOSES ITS HEADING (2026-08-12, section 111),
              and the argument is the project's own: section 98 note 7 already
              recorded that after made to measure left the shop, "the
              catalogue's first movement is now everything that is not sold or
              private, which is most of the site. Its heading still reads
              AVAILABLE, which is right, but it no longer distinguishes
              anything."

              A display-size heading and a hairline that separate a set from
              nothing are a band a reader crosses to reach the product. Rick
              Owens' listing pages carry no heading over the grid at all, and
              their category pages carry ONE. Ours carried two before a visitor
              saw a garment: the page title with its intro and filters, then
              this.

              1 DI 1 AND ESAURITI KEEP THEIRS, because those two still divide
              something real — a private commission and a piece that is gone.
              The architecture survives exactly where it means something.

              The section keeps its accessible name either way: a heading a
              sighted reader does not need is still a landmark a screen reader
              does, so it becomes `aria-label` rather than disappearing.
            */}
            {movement.key !== "available" && (
              <TextSurface arrive class="hairline-h flex flex-col gap-u1 pt-u5 pb-u2 md:pt-u8 md:pb-u3">
                <h2 class="type-display text-display">{movement.label}</h2>
              </TextSurface>
            )}

            {/*
              A ROW GUTTER (2026-08-12, section 111). The grid had none, so
              seventeen photographs ran together as one wall from the first tile
              to the last. Rick Owens' listing leaves roughly 155px of white
              between rows at desktop, and it is what lets each row read as a
              row of objects rather than as texture.

              u13 is 156px at 1920 and it is the site's own rhythm token, so
              nothing new is invented. A phone keeps u5: at two across, a
              desktop gutter is a third of the screen spent on nothing.

              COLUMNS STAY CLOSED deliberately. Their products are cut out on
              white seamless, so white between columns is the same white as the
              product's own ground; ours are full-bleed photographs, and paper
              between them would frame every tile as a card. The row gutter is
              the half of their arrangement our material can actually take.
            */}
            <div class="grid grid-cols-2 gap-y-u5 md:gap-y-u13 xl:grid-cols-4">
              {movement.items.map((garment, index) => (
                <a
                  href={localePath(locale, `creature/${garment.slug}`)}
                  class="tile"
                  data-drop={garment.collection?.slug ?? "none"}
                  data-worn={garment.wornBy ?? "unset"}
                  data-piece
                >
                  {/*
                    BROWSE WITHOUT CLICKING (section 72), his request. On a
                    device that cannot hover, the tile is a flick strip: up to
                    four frames, scroll-snap, each frame 94% wide so the next
                    peeks at the edge — the site's own continuation cue. A pan
                    scrolls, a tap still navigates (browsers cancel the click
                    on drag), so the preview can never trap anyone. On hover
                    devices the strip collapses to today's exact behaviour:
                    frame one plus the hover swap; display:none frames are
                    never fetched. No JavaScript, no dots, no counter.
                    Not focusable on purpose: seventeen extra tab stops would
                    be hostile, and every frame lives on the piece's own page.
                    Remove by deleting .tile-flick and this map.
                  */}
                  {/*
                    TWO FRAMES, NOT FOUR (2026-08-12, section 95). Measured on a
                    real phone — touch, so no hover, so the whole strip is
                    fetched — this page was 2315 KB and 55 photographs. The
                    strip was four frames per piece and it is the reason. Two
                    keeps the gesture, the peek and the second view; the rest of
                    a piece is one tap away on its own page, which is where the
                    detail crops belong anyway.
                  */}
                  <div class="tile-flick">
                    {garment.media!.slice(0, 2).map((frame, f) => (
                      <MediaSurface
                        media={frame}
                        locale={locale}
                        height="tile"
                        priority={index < 2 && f === 0}
                        reveal={f === 0 ? undefined : false}
                        hover={f === 0 ? garment.media![1] : undefined}
                      />
                    ))}
                  </div>
                  {allNamed && (
                    <div class="flex flex-col gap-u1 px-caption py-u2">
                      <h3 class="type-label text-label">{garment.name}</h3>
                      {isSold(garment) ? (
                        <span class="type-mono text-mono">{t(locale, "soldOut")}</span>
                      ) : (
                        priceOf(garment) && <span class="type-mono text-mono">{priceOf(garment)}</span>
                      )}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))
      ) : (
        <TextSurface class="flex min-h-svh flex-col justify-center gap-u5">
          <p class="type-display text-display">{t(locale, "nothingYet")}</p>
          <a href={localePath(locale, "process")} class="type-label text-label self-start hairline-under">
            {t(locale, "process")}
          </a>
        </TextSurface>
      )
    }

    {/*
      When a filter matches nothing at all, every movement is hidden and the
      page would end on the control row. This says so and offers the way back.
    */}
    <TextSurface class="empty-filter flex-col gap-u3 py-u13">
      <p class="type-display text-display">{t(locale, "noneMatch")}</p>
      <p class="type-label text-label">{t(locale, "noneMatchHint")}</p>
    </TextSurface>
  </div>

  {/*
    NAME THE TILE THAT WAS TAPPED, AND ONLY THAT ONE (section 94).

    The photograph is the same on both sides of this navigation, so the browser
    can carry it across instead of dissolving it — but only if both documents
    give the same element the same `view-transition-name`, and a name that
    appears twice in one document disables the transition entirely.

    So the name is applied to exactly one tile, at the moment a finger lands on
    it, and removed if the reader comes back. `pointerdown` rather than `click`
    because it fires before the navigation and before any scroll-cancellation,
    which is what a flick on the tile strip produces.

    Everything here is optional. No script, no view transitions, or reduced
    motion: the navigation is the plain crossfade it has always been.
  */}
  <script is:inline>
    (() => {
      if (!document.startViewTransition) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      const clear = () => document.querySelectorAll("[data-vt]").forEach((el) => el.removeAttribute("data-vt"));
      for (const tile of document.querySelectorAll("a.tile[data-piece]")) {
        tile.addEventListener(
          "pointerdown",
          () => {
            clear();
            tile.setAttribute("data-vt", "");
          },
          {passive: true},
        );
      }
      // Coming back through history must not leave a second element named.
      window.addEventListener("pageshow", clear);
    })();
  </script>
</Base>
