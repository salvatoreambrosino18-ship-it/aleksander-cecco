---
/*
  The enquiry. The reason the site exists.

  The page is STATIC, like every other page: one is built per garment per
  language at deploy time, with the piece already filled in, so nothing has to
  be looked up or scripted in the browser. It posts to /api/enquiry, which is a
  Cloudflare Pages Function, and that function answers with the confirmation or
  with what went wrong.

  No JavaScript anywhere in the path. A visitor on a broken connection, an old
  phone or with scripts off can still ask for a garment, which is the only thing
  this site is for. The browser's own required and type checks catch the
  ordinary mistakes; the function re-checks everything, because nothing arriving
  from a browser is trusted.

  Nothing here invents a promise. How soon a reply comes is the {REPLY_WINDOW}
  placeholder until the owner agrees one.
*/
import Base from "../../../../layouts/Base.astro";
import TextSurface from "../../../../components/TextSurface.astro";
import {getGarments, type Garment} from "../../../../lib/content";
import {LOCALES, localePath, pick, toLocale} from "../../../../lib/locales";
import {enquiryCopy, ENQUIRY_COPY_IS_DRAFT} from "../../../../i18n/enquiry";
import {t} from "../../../../i18n/ui";

export async function getStaticPaths() {
  const garments = await getGarments();
  return LOCALES.flatMap((lang) =>
    garments.map((garment) => ({params: {lang, slug: garment.slug}, props: {garment}})),
  );
}

const {garment} = Astro.props as {garment: Garment};
const locale = toLocale(Astro.params.lang);
const copy = enquiryCopy(locale);
/*
  Only a Creature that is made to order can be enquired about. A unique piece
  and a private order are already made and already someone's, so the form is not
  shown for them (DESIGN-PLAN section 24).
*/
const availability = garment.availability ?? "madeToOrder";
const canEnquire = availability === "madeToOrder" || availability === "readyNow";
/*
  A Creature that already exists can be taken as it is or remade, and those are
  different requests. The form asks which, and the three measurements stop being
  required when the answer might be "as it is" (DESIGN-PLAN section 49).
*/
const isReady = availability === "readyNow";
const availabilityLabel = {
  readyNow: t(locale, "availableNow"),
  madeToOrder: t(locale, "madeToOrder"),
  unique: t(locale, "unique"),
  privateOrder: t(locale, "privateOrder"),
  notOffered: t(locale, "notTakingRequests"),
}[availability] ?? t(locale, "madeToOrder");
const availabilityNote = pick(garment.availabilityNote, locale);
---

<Base locale={locale} title={`${t(locale, "enquire")} / ${garment.name}`}>
  <TextSurface class="flex min-h-svh flex-col gap-u8 pt-chrome pb-u21">
    <div class="flex flex-col gap-u1">
      <h1 class="type-label text-label">{t(locale, "enquire")}</h1>
      <p class="type-mono text-mono">
        {[garment.name, garment.referenceCode].filter(Boolean).join("  /  ")}
      </p>
    </div>

    {ENQUIRY_COPY_IS_DRAFT && <p class="placeholder-mark self-start">{t(locale, "draftNotice")}</p>}

    {
      !canEnquire ? (
        /* Nothing to send: this Creature is not one that can be commissioned. */
        <p class="type-label text-label max-w-prose">{availabilityNote ?? availabilityLabel}</p>
      ) : (
        <>
          <p class:list={["type-body text-body max-w-prose", ENQUIRY_COPY_IS_DRAFT && "draft-text"]}>
            {copy.intro}
          </p>

          <form method="POST" action="/api/enquiry" class="flex max-w-prose flex-col gap-u5">
            <div class="field">
              <label class="type-label text-label" for="name">{t(locale, "yourName")}</label>
              <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" />
            </div>

            <div class="field">
              <label class="type-label text-label" for="email">Email</label>
              <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />
            </div>

            {/*
              WHAT IS BEING ASKED FOR, when the piece already exists. Radios and
              no script, so it works with JavaScript off like everything else on
              this path, and the fields below stay visible rather than being
              hidden: a form that hides its own questions cannot explain itself
              without JavaScript, and the line under them says what to do.
            */}
            {
              isReady && (
                <fieldset class="flex flex-col gap-u2">
                  <legend class="type-label text-label">{copy.fulfilmentQuestion}</legend>
                  {(
                    [
                      ["asIs", copy.takeAsIs],
                      ["remade", copy.haveItRemade],
                    ] as const
                  ).map(([value, label], index) => (
                    <label class="type-label text-label flex items-baseline gap-u2">
                      <input type="radio" name="fulfilment" value={value} checked={index === 0} />
                      {label}
                    </label>
                  ))}
                </fieldset>
              )
            }

            <fieldset class="flex flex-col gap-u3">
              <legend class="flex flex-col gap-u1">
                <span class="type-label text-label">{t(locale, "yourMeasurements")}</span>
                <span class="type-label text-label">{copy.measureTitle}</span>
              </legend>

              {isReady && (
                <p class:list={["type-body text-body max-w-prose", ENQUIRY_COPY_IS_DRAFT && "draft-text"]}>
                  {copy.measurementsForRemakeOnly}
                </p>
              )}

              {/*
                ONE UNIT FOR ALL THREE, chosen by the person filling the form
                (DESIGN-PLAN section 38). Nobody measures a chest in inches and
                shoulders in centimetres, so asking three times would be three
                chances to get it wrong.

                A radio group, not a script: the whole form works with no
                JavaScript and the server does the conversion. That is also why
                the field labels no longer say "(cm)": without JavaScript a
                label cannot follow the radio, so the unit is stated once, here,
                and applies to everything below it.
              */}
              <div class="flex flex-wrap items-baseline gap-u3">
                <span class="type-label text-label">{copy.unitQuestion}</span>
                {(["cm", "in"] as const).map((unit, index) => (
                  <label class="type-label text-label flex items-baseline gap-u1">
                    <input type="radio" name="unit" value={unit} checked={index === 0} />
                    {unit.toUpperCase()}
                  </label>
                ))}
              </div>

              {(["chest", "shoulders", "length"] as const).map((key, index) => (
                <div class="field">
                  <label class="type-label text-label" for={key}>
                    {copy.measures[index].label}
                  </label>
                  {/*
                    step="any" and NO min/max: the accepted range depends on the
                    unit chosen above, and a browser cannot know which one that
                    is without JavaScript. The server validates, and its error
                    names the range in the unit that was chosen.
                  */}
                  <input
                    id={key}
                    name={key}
                    type="number"
                    inputmode="decimal"
                    step="any"
                    required={!isReady}
                    aria-describedby={`${key}-how`}
                  />
                  <p
                    id={`${key}-how`}
                    class:list={["type-body text-body", ENQUIRY_COPY_IS_DRAFT && "draft-text"]}
                  >
                    {copy.measures[index].how}
                  </p>
                </div>
              ))}

              <p class:list={["type-body text-body max-w-prose", ENQUIRY_COPY_IS_DRAFT && "draft-text"]}>
                {copy.measureHelp}
              </p>

            </fieldset>

            <div class="field">
              <label class="type-label text-label" for="note">{t(locale, "note")}</label>
              <textarea id="note" name="note" rows="4" maxlength="2000" />
            </div>

            {/* Hidden from people, not from bots: they fill it in, humans cannot. */}
            <div class="spam-trap" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <input type="hidden" name="lang" value={locale} />
            <input type="hidden" name="slug" value={garment.slug} />
            <input type="hidden" name="garmentName" value={garment.name} />
            <input type="hidden" name="garmentRef" value={garment.referenceCode ?? ""} />
            <input type="hidden" name="renderedAt" value={String(Date.now())} />

            <button type="submit" class="type-label text-label hairline-under self-start">
              {t(locale, "enquire")}
            </button>
          </form>

          <a
            href={localePath(locale, `creature/${garment.slug}`)}
            class="type-label text-label self-start hover:underline underline-offset-8"
          >
            {garment.name}
          </a>
        </>
      )
    }
  </TextSurface>
</Base>
