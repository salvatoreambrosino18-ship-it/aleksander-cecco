---
/*
  The ORDER page (2026-08-04, formerly the enquiry). The reason the site exists.

  THE ATELIER VERSION OF BUYING: not a cart, because sixteen one-off pieces
  cannot fill one, and no payment, because that waits on the owner's fiscal
  position. The page carries the piece, its photograph, its price and the
  shipping terms, then the buyer's details, and ends in a confirmation that
  reads like an order placed. The email it produces is an order sheet. It
  collects NOTHING the enquiry did not already collect, so the legal gate is
  unchanged. When payment exists it is a Stripe step slotted into the
  Function's confirmation (see functions/api/enquiry.ts), touching nothing
  here.

  The page is STATIC, like every other page: one is built per garment per
  language at deploy time, with the piece already filled in, so nothing has to
  be looked up or scripted in the browser. It posts to /api/enquiry, which is a
  Cloudflare Pages Function, and that function answers with the confirmation or
  with what went wrong.

  No JavaScript anywhere in the path. A visitor on a broken connection, an old
  phone or with scripts off can still ask for a garment, which is the only thing
  this site is for. The browser's own required and type checks catch the
  ordinary mistakes; the function re-checks everything, because nothing arriving
  from a browser is trusted.

  Nothing here invents a promise. How soon a reply comes is the {REPLY_WINDOW}
  placeholder until the owner agrees one.
*/
import Base from "../../../../layouts/Base.astro";
import TextSurface from "../../../../components/TextSurface.astro";
import {getGarments, getSiteSettings, type Garment} from "../../../../lib/content";
import MediaSurface from "../../../../components/MediaSurface.astro";
import {LOCALES, localePath, pick, toLocale} from "../../../../lib/locales";
import {enquiryCopy, ENQUIRY_COPY_IS_DRAFT} from "../../../../i18n/enquiry";
import {t} from "../../../../i18n/ui";
import {SHOW_UNAPPROVED_MARKS} from "../../../../lib/marks";

export async function getStaticPaths() {
  const garments = await getGarments();
  return LOCALES.flatMap((lang) =>
    garments.map((garment) => ({params: {lang, slug: garment.slug}, props: {garment}})),
  );
}

const {garment} = Astro.props as {garment: Garment};
const locale = toLocale(Astro.params.lang);
const copy = enquiryCopy(locale);
const settings = await getSiteSettings();

const [firstMedia] = garment.media ?? [];
const price =
  typeof garment.price === "number"
    ? new Intl.NumberFormat(locale === "it" ? "it-IT" : "en-GB", {
        style: "currency",
        currency: garment.currency || "EUR",
        maximumFractionDigits: 0,
      }).format(garment.price)
    : null;

/* The terms, gathered once: his free-shipping fact, then ours. */
const shippingLines = [
  pick(settings.shippingFree, locale),
  pick(settings.shippingReturns, locale),
  pick(settings.shippingCustoms, locale),
].filter((line): line is string => Boolean(line));
/*
  EVERY PIECE IS BOUGHT AS IT EXISTS (2026-08-12, section 98). The OWNER removed
  made to measure from the shop: there is no measurement flow, no as-is-or-remade
  question, and no remake anywhere. A Creature is an object that exists; this
  form asks who is buying it and how to reach them.

  Made to measure survives as a SENTENCE on the piece inviting an email, and
  nothing else. It is not a state, not a form and not a branch.
*/
const availability = garment.availability ?? "readyNow";
const canEnquire =
  availability === "readyNow" || availability === "unique" || availability === "madeToOrder";
const availabilityLabel = {
  readyNow: t(locale, "availableNow"),
  unique: t(locale, "unique"),
  privateOrder: t(locale, "privateOrder"),
  notOffered: t(locale, "notTakingRequests"),
}[availability] ?? t(locale, "availableNow");
const availabilityNote = pick(garment.availabilityNote, locale);
---

<Base locale={locale} title={`${t(locale, "order")} / ${garment.name}`}>
  {/*
    The piece, seen at the moment of ordering: one photograph, not a gallery,
    so the page stays a document rather than a second product page.
  */}
  {firstMedia && <MediaSurface media={firstMedia} locale={locale} height="short" priority />}

  <TextSurface class="flex min-h-svh flex-col gap-u8 py-u13">
    <div class="flex flex-col gap-u2">
      <p class="type-label text-label">{t(locale, "order")}</p>
      <h1 class="type-display text-display">
        {garment.name}{price ? `. ${price}.` : "."}
      </h1>
      {/*
        The terms a buyer is agreeing to, before the form rather than after it:
        his shipping line, the returns rule, and customs. Mono, because they
        are facts.
      */}
      <div class="type-body text-body flex flex-col gap-u1 pt-u2">
        {shippingLines.map((line) => <p>{line}</p>)}
      </div>
    </div>

    {ENQUIRY_COPY_IS_DRAFT && SHOW_UNAPPROVED_MARKS && (
      <p class="placeholder-mark self-start">{t(locale, "draftNotice")}</p>
    )}

    {
      !canEnquire ? (
        /* Nothing to send: this Creature is not one that can be commissioned. */
        <p class="type-label text-label max-w-prose">{availabilityNote ?? availabilityLabel}</p>
      ) : (
        <>
          <p class:list={["type-body text-body max-w-prose", ENQUIRY_COPY_IS_DRAFT && SHOW_UNAPPROVED_MARKS && "draft-text"]}>
            {copy.intro}
          </p>

          <form method="POST" action="/api/enquiry" class="flex max-w-prose flex-col gap-u5">
            <div class="field">
              <label class="type-label text-label" for="name">{t(locale, "yourName")}</label>
              <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" />
            </div>

            <div class="field">
              <label class="type-label text-label" for="email">Email</label>
              <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />
            </div>

            <div class="field">
              <label class="type-label text-label" for="note">{t(locale, "note")}</label>
              <textarea id="note" name="note" rows="4" maxlength="2000" />
            </div>

            {/* Hidden from people, not from bots: they fill it in, humans cannot. */}
            <div class="spam-trap" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <input type="hidden" name="lang" value={locale} />
            <input type="hidden" name="slug" value={garment.slug} />
            <input type="hidden" name="garmentName" value={garment.name} />
            <input type="hidden" name="garmentRef" value={garment.referenceCode ?? ""} />
            {/* Display-only, for the order sheet; the owner knows his prices. */}
            <input type="hidden" name="price" value={price ?? ""} />
            <input type="hidden" name="renderedAt" value={String(Date.now())} />

            <button
              type="submit"
              class="type-label text-body hairline-under self-start"
              data-sending={t(locale, "sending")}
            >
              {t(locale, "placeOrder")}
            </button>
          </form>

          <a
            href={localePath(locale, `creature/${garment.slug}`)}
            class="type-label text-label self-start hairline-under"
          >
            {garment.name}
          </a>
        </>
      )
    }
  </TextSurface>

  {/*
    THE SENDING STATE, and it is an ENHANCEMENT rather than a dependency.

    The form posts and the browser navigates, so on a slow connection there is a
    gap where nothing appears to have happened and a person presses the button
    again. This says what is going on and stops the second press.

    With no JavaScript nothing changes and the form works exactly as before,
    which is the rule this whole path is built on (section 19). The button is
    NOT disabled: a disabled control is removed from the accessibility tree
    mid-action, and `aria-busy` with a changed label says the same thing without
    taking the control away from anyone reading it.
  */}
  <script is:inline>
    (() => {
      const form = document.querySelector("form[action='/api/enquiry']");
      if (!form) return;
      form.addEventListener("submit", () => {
        const button = form.querySelector("button[type=submit]");
        if (!button) return;
        button.setAttribute("aria-busy", "true");
        button.textContent = button.dataset.sending;
      });
    })();
  </script>
</Base>
