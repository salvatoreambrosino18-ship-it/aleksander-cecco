---
// Scaffold placeholder only. This is NOT the designed home page.
// Real pages are built after the content model is approved (build order, step 2).
// It exists so `npm run dev` renders and proves the token system and fonts are wired.
import Base from "../layouts/Base.astro";
---

<Base title="Aleksander Cecco">
  <main class="min-h-svh bg-bg text-fg p-margin flex flex-col justify-between">
    <p class="type-mono text-mono">Scaffold / tokens + fonts wired</p>
    <h1 class="type-display text-hero">Aleksander Cecco</h1>
    <p class="type-body text-body max-w-prose">
      Foundations only. The token system, self-hosted variable fonts, and the
      light and dark polarities are in place. Pages come after the content model
      is approved; motion comes after that.
    </p>
  </main>
</Base>
