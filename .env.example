# Aleksander Cecco - environment variables
# Copy to .env and fill in real values. Never commit .env.
# Variable names only here, no values.

# --- Sanity (projectId and dataset are public identifiers, not secrets) ---
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=
PUBLIC_SANITY_API_VERSION=
# Server-only read token, needed only for private datasets or draft/preview reads.
SANITY_READ_TOKEN=

# --- Site ---
# Absolute site URL, used for canonical links, Open Graph, and the sitemap.
PUBLIC_SITE_URL=

# --- Enquiry email (Resend) ---
RESEND_API_KEY=
# Verified sending address, e.g. enquiries@yourdomain
RESEND_FROM=
# Where enquiry submissions are delivered.
ENQUIRY_TO_EMAIL=

# --- Search visibility ---
# "true" ONLY at launch. Any other value (or unset) keeps every page noindex.
# The second lock is the X-Robots-Tag header in public/_headers, removed by hand.
PUBLIC_ALLOW_INDEXING=

# --- Analytics (Cloudflare Web Analytics, cookieless) ---
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# --- Deploy (used by the Sanity webhook, not by the app at runtime) ---
# Cloudflare Pages deploy hook that a Sanity content-publish webhook calls.
CLOUDFLARE_DEPLOY_HOOK_URL=
